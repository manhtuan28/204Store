@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Xác thực tài khoản";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 text-center p-5">
                <div class="mb-4">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-envelope-check-fill fs-1"></i>
                    </div>
                </div>

                <h2 class="fw-bold text-dark mb-3">Kiểm tra Email của bạn</h2>

                @{
                    if (@Model.DisplayConfirmAccountLink)
                    {
                        <p class="text-muted mb-4">
                            Hệ thống đang chạy ở chế độ Demo (chưa cấu hình email sender). <br />
                            Vui lòng nhấn vào nút bên dưới để xác thực tài khoản ngay lập tức:
                        </p>
                        <div class="d-grid gap-2 col-8 mx-auto">
                            <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="btn btn-primary fw-bold rounded-pill py-2 shadow-sm">
                                Xác thực tài khoản ngay
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-4">
                            Chúng tôi đã gửi một email xác thực đến địa chỉ email bạn vừa đăng ký.
                            Vui lòng kiểm tra hộp thư đến (hoặc mục Spam) để hoàn tất quá trình đăng ký.
                        </p>
                        <a href="/" class="btn btn-outline-primary rounded-pill px-4">
                            Về trang chủ
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>