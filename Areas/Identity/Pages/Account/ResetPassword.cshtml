@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="container" style="margin-top: 80px; margin-bottom: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="bg-primary bg-opacity-10 p-4 text-center border-bottom border-light">
                    <div class="mb-3">
                        <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm text-primary" style="width: 70px; height: 70px;">
                            <i class="bi bi-key-fill fs-2"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-primary mb-1">@ViewData["Title"]</h4>
                    <p class="text-muted small mb-0">Thiết lập mật khẩu mới cho tài khoản của bạn.</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center fw-bold" role="alert"></div>

                        <input asp-for="Input.Code" type="hidden" />

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control bg-light border-0" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="text-muted">Địa chỉ Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small ms-1"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control bg-light border-0" autocomplete="new-password" aria-required="true" placeholder="Nhập mật khẩu mới" />
                            <label asp-for="Input.Password" class="text-muted">Mật khẩu mới</label>
                            <span asp-validation-for="Input.Password" class="text-danger small ms-1"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control bg-light border-0" autocomplete="new-password" aria-required="true" placeholder="Xác nhận mật khẩu" />
                            <label asp-for="Input.ConfirmPassword" class="text-muted">Nhập lại mật khẩu</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small ms-1"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #4f46e5; border: none;">
                                <i class="bi bi-check2-circle me-2"></i>Lưu mật khẩu mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}