@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Truy cập bị từ chối";
}

<div class="container" style="margin-top: 80px; margin-bottom: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">

                <div class="pt-5 pb-4">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm animate__animated animate__headShake" style="width: 100px; height: 100px;">
                        <i class="bi bi-sign-stop-fill display-3"></i>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 pt-0">
                    <h3 class="fw-bold text-danger mb-3">@ViewData["Title"]</h3>

                    <p class="text-muted mb-4">
                        Xin lỗi, bạn không có đủ quyền hạn để truy cập vào tài nguyên này.<br>
                        Vui lòng liên hệ quản trị viên nếu bạn cho rằng đây là một sự nhầm lẫn.
                    </p>

                    <div class="d-grid gap-2 col-10 mx-auto">
                        <a href="/" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #4f46e5; border: none;">
                            <i class="bi bi-house-door-fill me-2"></i>Về trang chủ
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>