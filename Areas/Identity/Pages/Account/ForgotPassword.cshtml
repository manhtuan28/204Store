@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu?";
}

<div class="container" style="margin-top: 60px; margin-bottom: 80px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-primary bg-opacity-10 p-4 text-center border-bottom border-light">
                    <div class="mb-3">
                        <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm text-primary" style="width: 70px; height: 70px;">
                            <i class="bi bi-key-fill fs-2"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-primary mb-1">Quên mật khẩu?</h4>
                    <p class="text-muted small mb-0">Đừng lo lắng! Hãy nhập email của bạn để chúng tôi gửi hướng dẫn đặt lại mật khẩu.</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small text-center" role="alert"></div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.Email" class="form-control bg-light border-0" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="text-muted">Địa chỉ Email đã đăng ký</label>
                            <span asp-validation-for="Input.Email" class="text-danger small ms-1"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #4f46e5; border: none;">
                                Gửi yêu cầu
                            </button>

                            <a asp-page="./Login" class="btn btn-light btn-lg rounded-pill fw-bold text-muted mt-2">
                                <i class="bi bi-arrow-left me-2"></i>Quay lại đăng nhập
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}