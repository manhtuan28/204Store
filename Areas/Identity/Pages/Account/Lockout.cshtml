@page
@model LockoutModel
@{
    ViewData["Title"] = "Tài khoản bị tạm khóa";
}

<div class="container" style="margin-top: 80px; margin-bottom: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">

                <div class="pt-5 pb-4">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 120px; height: 120px;">
                        <i class="bi bi-lock-fill display-3"></i>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 pt-0">
                    <h3 class="fw-bold text-danger mb-3">Tài khoản bị tạm khóa!</h3>

                    <div class="alert alert-warning bg-warning bg-opacity-10 border-warning border-opacity-25 rounded-3 text-start mb-4">
                        <div class="d-flex">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-2 mt-1"></i>
                            <div class="small text-dark opacity-75">
                                Hệ thống phát hiện quá nhiều lần đăng nhập không thành công. Để bảo vệ an toàn cho tài khoản, chúng tôi đã tạm khóa chức năng đăng nhập.
                            </div>
                        </div>
                    </div>

                    <p class="text-muted mb-4">
                        Vui lòng quay lại sau <strong>ít phút</strong> để thử lại.<br>
                        Nếu bạn quên mật khẩu, hãy sử dụng tính năng khôi phục mật khẩu thay vì cố gắng đoán.
                    </p>

                    <div class="d-grid gap-2 col-10 mx-auto">
                        <a href="/" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #4f46e5; border: none;">
                            <i class="bi bi-house-door-fill me-2"></i>Về trang chủ
                        </a>

                        <a asp-page="./ForgotPassword" class="btn btn-light btn-lg rounded-pill fw-bold text-muted mt-2">
                            <i class="bi bi-key me-2"></i>Quên mật khẩu?
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>