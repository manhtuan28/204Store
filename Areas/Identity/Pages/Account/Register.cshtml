@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<style>
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #4f46e5;
        transform: scale(.85) translateY(-0.5rem) translateX(0.15rem);
    }

    .form-control:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.1);
    }

    .btn-primary-custom {
        background-color: #4f46e5;
        border-color: #4f46e5;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-primary-custom:hover {
            background-color: #4338ca;
            border-color: #4338ca;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }
</style>

<div class="container d-flex justify-content-center align-items-center min-vh-100 py-5">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card border-0 shadow-lg rounded-5 overflow-hidden">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 70px; height: 70px;">
                        <i class="bi bi-person-plus-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Tạo tài khoản mới</h3>
                    <p class="text-muted small">Tham gia cộng đồng 204Store ngay hôm nay</p>
                </div>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control bg-light border-0 rounded-3" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="text-muted"><i class="bi bi-envelope me-2"></i>Địa chỉ Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger small ms-1"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control bg-light border-0 rounded-3" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="text-muted"><i class="bi bi-lock me-2"></i>Mật khẩu</label>
                        <span asp-validation-for="Input.Password" class="text-danger small ms-1"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control bg-light border-0 rounded-3" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.ConfirmPassword" class="text-muted"><i class="bi bi-check2-circle me-2"></i>Nhập lại mật khẩu</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small ms-1"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn btn-primary-custom w-100 btn-lg rounded-pill fw-bold py-3">
                        Đăng ký tài khoản
                    </button>
                </form>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="position-relative text-center my-4">
                        <hr class="text-muted opacity-25">
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small fw-medium">Hoặc đăng ký với</span>
                    </div>

                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="text-center">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            var btnClass = provider.Name == "Google" ? "btn-outline-danger" : (provider.Name == "Facebook" ? "btn-outline-primary" : "btn-outline-secondary");
                            var iconClass = provider.Name == "Google" ? "bi-google" : (provider.Name == "Facebook" ? "bi-facebook" : "bi-shield-lock");

                            <button type="submit" class="btn @btnClass rounded-pill px-4 mx-1 fw-bold shadow-sm" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                <i class="bi @iconClass me-2"></i>@provider.DisplayName
                            </button>
                        }
                    </form>
                }

                <div class="text-center mt-4 pt-2 border-top">
                    <p class="text-muted small mb-0">
                        Bạn đã có tài khoản?
                        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-bold text-decoration-none hover-link ms-1">
                            Đăng nhập ngay <i class="bi bi-arrow-right"></i>
                        </a>
                    </p>
                </div>
            </div>
        </div>

        <div class="text-center mt-4 text-muted small opacity-75">
            <i class="bi bi-shield-lock-fill me-1"></i> Thông tin của bạn được bảo mật tuyệt đối.
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}