@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h4 class="fw-bold text-primary mb-4 border-bottom pb-2">
    <i class="bi bi-shield-lock me-2"></i>@ViewData["Title"]
</h4>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-7">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
            
            <div class="form-floating mb-3">
                <input asp-for="Input.OldPassword" class="form-control bg-light border-0" autocomplete="current-password" aria-required="true" placeholder="Mật khẩu cũ" />
                <label asp-for="Input.OldPassword" class="text-muted">Mật khẩu hiện tại</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger small ms-1"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword" class="form-control bg-light border-0" autocomplete="new-password" aria-required="true" placeholder="Mật khẩu mới" />
                <label asp-for="Input.NewPassword" class="text-muted">Mật khẩu mới</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger small ms-1"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control bg-light border-0" autocomplete="new-password" aria-required="true" placeholder="Xác nhận mật khẩu" />
                <label asp-for="Input.ConfirmPassword" class="text-muted">Nhập lại mật khẩu mới</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small ms-1"></span>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill fw-bold px-4 py-2 shadow-sm" style="background-color: #4f46e5; border: none;">
                <i class="bi bi-check-circle-fill me-2"></i>Cập nhật mật khẩu
            </button>
        </form>
    </div>

    <div class="col-md-5 d-none d-md-block border-start ps-4">
        <div class="text-center mt-3">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 120px; height: 120px;">
                <i class="bi bi-shield-check text-primary opacity-50" style="font-size: 4rem;"></i>
            </div>
            
            <div class="alert alert-warning bg-warning bg-opacity-10 border-0 rounded-3 mt-4 text-start">
                <h6 class="fw-bold text-dark"><i class="bi bi-lightbulb-fill me-2 text-warning"></i>Mẹo bảo mật:</h6>
                <ul class="small text-muted mb-0 ps-3">
                    <li class="mb-1">Sử dụng mật khẩu dài ít nhất 8 ký tự.</li>
                    <li class="mb-1">Kết hợp chữ hoa, chữ thường, số và ký tự đặc biệt (#, $...).</li>
                    <li>Tránh dùng thông tin cá nhân như ngày sinh, số điện thoại.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}