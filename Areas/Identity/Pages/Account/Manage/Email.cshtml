@page
@model EmailModel
@{
    ViewData["Title"] = "Quản lý Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-primary bg-opacity-10 p-4 border-0">
                <h4 class="fw-bold text-primary mb-1"><i class="bi bi-envelope-at me-2"></i>@ViewData["Title"]</h4>
                <p class="text-muted small mb-0">Quản lý địa chỉ email đăng nhập và nhận thông báo.</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <form id="email-form" method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-3 fw-bold" role="alert"></div>

                    @if (Model.IsEmailConfirmed)
                    {
                        <div class="form-floating mb-3 input-group">
                            <input asp-for="Email" class="form-control bg-white fw-bold text-success" disabled />
                            <span class="input-group-text bg-success text-white fw-bold"><i class="bi bi-check-circle-fill me-2"></i>Đã xác thực</span>
                            <label asp-for="Email" class="form-label text-muted">Email hiện tại</label>
                        </div>
                    }
                    else
                    {
                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control bg-light" disabled />
                            <label asp-for="Email" class="form-label text-muted">Email hiện tại</label>
                            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link small text-decoration-none px-0">Gửi lại email xác thực</button>
                        </div>
                    }

                    <div class="form-floating mb-4">
                        <input asp-for="Input.NewEmail" class="form-control bg-light" autocomplete="email" aria-required="true" placeholder="Nhập email mới" />
                        <label asp-for="Input.NewEmail" class="form-label text-muted">Email mới</label>
                        <span asp-validation-for="Input.NewEmail" class="text-danger small ms-1"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-pencil-square me-2"></i>Cập nhật Email
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}