@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<style>
    .manage-nav .nav-pills {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .manage-nav .nav-link {
        color: #64748b;
        font-weight: 600;
        padding: 0.8rem 1.2rem;
        border-radius: 0.5rem;
        transition: all 0.2s;
        border: 1px solid transparent;
    }

        .manage-nav .nav-link:hover {
            background-color: #f8fafc;
            color: #4f46e5;
            border-color: #e2e8f0;
            transform: translateX(5px);
        }

        .manage-nav .nav-link.active {
            background-color: #4f46e5 !important;
            color: white !important;
            box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.25);
        }
</style>

<div class="container" style="margin-top: 40px; margin-bottom: 80px;">
    <div class="row align-items-center mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-dark mb-1">Cài đặt tài khoản</h2>
            <p class="text-muted mb-0">Quản lý thông tin cá nhân, bảo mật và lịch sử hoạt động.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px; z-index: 1;">
                <div class="card-body p-3 manage-nav">
                    <h6 class="fw-bold text-uppercase text-muted small mb-3 ps-2">Tài khoản chung</h6>

                    <partial name="_ManageNav" />
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 p-md-5">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}