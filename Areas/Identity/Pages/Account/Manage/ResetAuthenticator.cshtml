@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Đặt lại khóa xác thực";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="card border-warning shadow-sm rounded-4 overflow-hidden">

            <div class="card-header bg-warning bg-opacity-25 p-4 text-center border-0">
                <div class="mb-3">
                    <div class="bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 70px; height: 70px;">
                        <i class="bi bi-arrow-counterclockwise fs-1"></i>
                    </div>
                </div>
                <h4 class="fw-bold text-dark mb-1">Đặt lại khóa ứng dụng xác thực</h4>
                <p class="mb-0 text-dark text-opacity-75 small">Hành động này sẽ ngắt kết nối với ứng dụng xác thực hiện tại.</p>
            </div>

            <div class="card-body p-4 p-md-5">

                <div class="alert alert-danger border-danger border-opacity-25 bg-danger bg-opacity-10 rounded-3 mb-4">
                    <div class="d-flex">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-3 fs-4"></i>
                        <div>
                            <strong class="text-danger">Cảnh báo:</strong>
                            <p class="mb-2 mt-1 small">
                                Nếu bạn đặt lại khóa xác thực, ứng dụng Authenticator hiện tại trên điện thoại của bạn sẽ <strong>không còn hoạt động</strong>.
                            </p>
                            <p class="mb-0 small">
                                Bạn bắt buộc phải cấu hình lại ứng dụng xác thực (quét lại mã QR) ngay sau khi thực hiện hành động này.
                            </p>
                        </div>
                    </div>
                </div>

                <form id="reset-authenticator" method="post">
                    <div class="d-grid gap-2">
                        <button class="btn btn-warning btn-lg rounded-pill fw-bold shadow-sm text-dark" type="submit">
                            <i class="bi bi-arrow-repeat me-2"></i>Xác nhận đặt lại
                        </button>
                        <a asp-page="./TwoFactorAuthentication" class="btn btn-light rounded-pill fw-bold text-muted mt-2">
                            <i class="bi bi-x-lg me-2"></i>Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>