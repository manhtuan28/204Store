@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dữ liệu cá nhân";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h4 class="fw-bold text-primary mb-4 border-bottom pb-2">
    <i class="bi bi-cloud-download me-2"></i>@ViewData["Title"]
</h4>

<div class="row">
    <div class="col-md-7">
        <p class="text-muted mb-4">
            Hệ thống lưu trữ các thông tin cá nhân mà bạn đã cung cấp. <br>
            Tại đây, bạn có thể tải xuống bản sao dữ liệu hoặc yêu cầu xóa vĩnh viễn tài khoản khỏi hệ thống.
        </p>

        <div class="card border-0 shadow-sm bg-light mb-4 rounded-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3 text-primary">
                        <i class="bi bi-archive fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Tải xuống dữ liệu</h6>
                        <p class="small text-muted mb-0">Lưu trữ bản sao thông tin cá nhân (định dạng JSON).</p>
                    </div>
                </div>

                <form id="download-data" asp-page="DownloadPersonalData" method="post">
                    <button class="btn btn-primary rounded-pill fw-bold px-4 shadow-sm" type="submit" style="background-color: #4f46e5; border: none;">
                        <i class="bi bi-download me-2"></i>Tải xuống ngay
                    </button>
                </form>
            </div>
        </div>

        <div class="card border-danger border-opacity-25 bg-danger bg-opacity-10 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-white p-2 rounded-3 me-3 text-danger shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-danger mb-1">Vùng nguy hiểm</h6>
                        <p class="small text-danger mb-0">Hành động này không thể hoàn tác.</p>
                    </div>
                </div>

                <p class="small text-danger mb-3">
                    Việc xóa dữ liệu đồng nghĩa với việc <strong>xóa vĩnh viễn tài khoản</strong> của bạn. Bạn sẽ không thể khôi phục lại tài khoản sau khi thực hiện.
                </p>

                <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger rounded-pill fw-bold px-4 shadow-sm">
                    <i class="bi bi-trash3-fill me-2"></i>Xóa tài khoản
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-5 d-none d-md-block border-start ps-4">
        <div class="text-center mt-5">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 120px; height: 120px;">
                <i class="bi bi-person-lines-fill text-primary opacity-50" style="font-size: 4rem;"></i>
            </div>
            <p class="text-muted small mt-4 px-3">
                Chúng tôi cam kết tôn trọng quyền riêng tư và quyền kiểm soát dữ liệu của bạn theo tiêu chuẩn bảo mật cao nhất.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}