@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dữ liệu cá nhân";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <div class="card-header bg-primary bg-opacity-10 p-4 border-0">
                <h4 class="fw-bold text-primary mb-1"><i class="bi bi-person-vcard me-2"></i>@ViewData["Title"]</h4>
                <p class="text-muted small mb-0">Quản lý việc tải xuống hoặc xóa dữ liệu cá nhân của bạn.</p>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-info border-info border-opacity-25 bg-info bg-opacity-10 rounded-3 mb-4">
                    <div class="d-flex">
                        <i class="bi bi-info-circle-fill text-info me-3 fs-4"></i>
                        <div>
                            <strong>Thông tin:</strong>
                            <p class="mb-0 small mt-1">
                                Tài khoản của bạn chứa các dữ liệu cá nhân mà bạn đã cung cấp cho chúng tôi.
                                Trang này cho phép bạn tải xuống hoặc xóa vĩnh viễn các dữ liệu đó.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-4 border rounded-4 h-100 bg-light bg-opacity-50 text-center hover-shadow transition-all">
                            <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm mb-3 text-primary" style="width: 60px; height: 60px;">
                                <i class="bi bi-cloud-download-fill fs-3"></i>
                            </div>
                            <h5 class="fw-bold">Tải xuống dữ liệu</h5>
                            <p class="text-muted small mb-4">Tải toàn bộ dữ liệu cá nhân của bạn về máy dưới dạng file JSON.</p>

                            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                                <button class="btn btn-primary rounded-pill fw-bold px-4 shadow-sm w-100" type="submit">
                                    <i class="bi bi-download me-2"></i>Tải xuống ngay
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-4 border border-danger border-opacity-25 rounded-4 h-100 bg-danger bg-opacity-10 text-center hover-shadow transition-all">
                            <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm mb-3 text-danger" style="width: 60px; height: 60px;">
                                <i class="bi bi-trash3-fill fs-3"></i>
                            </div>
                            <h5 class="fw-bold text-danger">Xóa tài khoản</h5>
                            <p class="text-danger text-opacity-75 small mb-4">Xóa vĩnh viễn tài khoản và toàn bộ dữ liệu liên quan khỏi hệ thống.</p>

                            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger rounded-pill fw-bold px-4 shadow-sm w-100">
                                <i class="bi bi-exclamation-triangle me-2"></i>Xóa tài khoản
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}