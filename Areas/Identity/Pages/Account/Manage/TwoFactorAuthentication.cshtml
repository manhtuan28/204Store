@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Xác thực 2 lớp (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <div class="card-header bg-primary bg-opacity-10 p-4 border-0 d-flex align-items-center">
                <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm text-primary me-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-shield-lock-fill fs-3"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-primary mb-1">@ViewData["Title"]</h4>
                    <p class="text-muted small mb-0">Tăng cường bảo mật cho tài khoản của bạn.</p>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">

                <div class="mb-5 text-center">
                    @if (Model.Is2faEnabled)
                    {
                        <div class="d-inline-flex align-items-center px-4 py-2 rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 mb-3">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <span class="fw-bold">Xác thực 2 lớp đang BẬT</span>
                        </div>
                        <div class="mt-2">
                            <a asp-page="./Disable2fa" class="btn btn-outline-danger rounded-pill fw-bold btn-sm">
                                <i class="bi bi-power me-1"></i>Tắt 2FA
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="d-inline-flex align-items-center px-4 py-2 rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 mb-3">
                            <i class="bi bi-x-circle-fill me-2"></i>
                            <span class="fw-bold">Xác thực 2 lớp đang TẮT</span>
                        </div>
                        <div class="mt-2">
                            <a asp-page="./EnableAuthenticator" class="btn btn-primary rounded-pill fw-bold shadow-sm">
                                <i class="bi bi-shield-check me-2"></i>Kích hoạt ngay
                            </a>
                        </div>
                    }
                </div>

                @if (Model.Is2faEnabled)
                {
                    <hr class="my-4 dashed-line">

                    <div class="row g-4">
                        <div class="col-md-12">
                            <h5 class="fw-bold mb-3"><i class="bi bi-laptop me-2 text-primary"></i>Thiết bị tin cậy</h5>
                            @if (Model.IsMachineRemembered)
                            {
                                <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 border">
                                    <span class="small text-muted">Trình duyệt này đang được ghi nhớ (không hỏi mã 2FA).</span>
                                    <form method="post" style="display: inline-block">
                                        <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill">
                                            <i class="bi bi-eraser me-1"></i>Quên thiết bị này
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 bg-light rounded-3 border text-center text-muted small">
                                    Trình duyệt này chưa được ghi nhớ.
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <div class="h-100 p-4 border rounded-4 bg-light bg-opacity-25">
                                <h6 class="fw-bold mb-3"><i class="bi bi-qr-code me-2 text-primary"></i>Ứng dụng xác thực</h6>
                                @if (!Model.HasAuthenticator)
                                {
                                    <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary w-100 rounded-pill fw-bold btn-sm">Thêm ứng dụng xác thực</a>
                                }
                                else
                                {
                                    <div class="d-grid gap-2">
                                        <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-outline-primary rounded-pill fw-bold btn-sm">Cấu hình thêm ứng dụng</a>
                                        <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-outline-danger rounded-pill fw-bold btn-sm">Đặt lại khóa (Reset)</a>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="h-100 p-4 border rounded-4 bg-light bg-opacity-25">
                                <h6 class="fw-bold mb-3"><i class="bi bi-key me-2 text-primary"></i>Mã khôi phục</h6>
                                <div class="mb-3">
                                    @if (Model.RecoveryCodesLeft == 0)
                                    {
                                        <div class="alert alert-danger py-2 small mb-0 fw-bold"><i class="bi bi-exclamation-circle me-1"></i>Bạn đã hết mã khôi phục.</div>
                                    }
                                    else if (Model.RecoveryCodesLeft == 1)
                                    {
                                        <div class="alert alert-danger py-2 small mb-0 fw-bold"><i class="bi bi-exclamation-circle me-1"></i>Chỉ còn 1 mã duy nhất.</div>
                                    }
                                    else if (Model.RecoveryCodesLeft <= 3)
                                    {
                                        <div class="alert alert-warning py-2 small mb-0 fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Chỉ còn @Model.RecoveryCodesLeft mã.</div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-success py-2 small mb-0 fw-bold"><i class="bi bi-check-circle me-1"></i>Còn @Model.RecoveryCodesLeft mã khả dụng.</div>
                                    }
                                </div>

                                <div class="d-grid gap-2">
                                    @if (Model.RecoveryCodesLeft == 0)
                                    {
                                        <a asp-page="./GenerateRecoveryCodes" class="btn btn-danger w-100 rounded-pill fw-bold btn-sm">Tạo bộ mã mới ngay</a>
                                    }
                                    else
                                    {
                                        <a asp-page="./ShowRecoveryCodes" class="btn btn-outline-primary rounded-pill fw-bold btn-sm">Xem mã khôi phục</a>
                                        <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-secondary rounded-pill fw-bold btn-sm">Tạo bộ mã mới</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}