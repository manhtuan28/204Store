@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Bảo mật 2 lớp (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h4 class="fw-bold text-primary mb-4 border-bottom pb-2">
    <i class="bi bi-qr-code-scan me-2"></i>@ViewData["Title"]
</h4>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-7">
        @{
            var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
            @if (consentFeature?.CanTrack ?? true)
            {
                @if (Model.Is2faEnabled)
                {
                    <div class="alert alert-success bg-success bg-opacity-10 border-success border-opacity-25 rounded-3 mb-4">
                        <i class="bi bi-shield-check me-2 text-success"></i>
                        <span class="fw-bold text-success">Tính năng xác thực 2 lớp đang BẬT</span>
                    </div>

                    if (Model.RecoveryCodesLeft == 0)
                    {
                        <div class="alert alert-danger rounded-3 shadow-sm border-0 border-start border-danger border-4">
                            <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Bạn đã hết mã khôi phục.</strong>
                            <p class="mb-0 mt-1 small">Vui lòng <a asp-page="./GenerateRecoveryCodes" class="fw-bold text-danger">tạo bộ mã mới</a> để có thể đăng nhập khi mất thiết bị.</p>
                        </div>
                    }
                    else if (Model.RecoveryCodesLeft == 1)
                    {
                        <div class="alert alert-danger rounded-3 shadow-sm border-0 border-start border-danger border-4">
                            <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Bạn chỉ còn 1 mã khôi phục.</strong>
                            <p class="mb-0 mt-1 small">Bạn nên <a asp-page="./GenerateRecoveryCodes" class="fw-bold text-danger">tạo bộ mã mới</a> ngay.</p>
                        </div>
                    }
                    else if (Model.RecoveryCodesLeft <= 3)
                    {
                        <div class="alert alert-warning rounded-3 shadow-sm border-0 border-start border-warning border-4">
                            <strong><i class="bi bi-exclamation-circle-fill me-2"></i>Bạn còn @Model.RecoveryCodesLeft mã khôi phục.</strong>
                            <p class="mb-0 mt-1 small">Bạn nên <a asp-page="./GenerateRecoveryCodes" class="fw-bold text-dark">tạo bộ mã mới</a>.</p>
                        </div>
                    }

                    <div class="d-grid gap-2 mb-4">
                        @if (Model.IsMachineRemembered)
                        {
                            <form method="post" style="display: inline-block">
                                <button type="submit" class="btn btn-outline-secondary w-100 rounded-3">
                                    <i class="bi bi-browser-edge me-2"></i>Hủy tin cậy trình duyệt này
                                </button>
                            </form>
                        }

                        <a asp-page="./GenerateRecoveryCodes" class="btn btn-light border text-primary fw-bold rounded-3">
                            <i class="bi bi-arrow-repeat me-2"></i>Đặt lại mã khôi phục
                        </a>

                        <a asp-page="./Disable2fa" class="btn btn-danger bg-opacity-10 text-white border-danger border-opacity-25 fw-bold rounded-3">
                            <i class="bi bi-shield-x me-2"></i>Tắt xác thực 2 lớp
                        </a>
                    </div>
                }

                <div class="card bg-light border-0 rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-phone me-2"></i>Ứng dụng xác thực (Authenticator)</h6>
                        @if (!Model.HasAuthenticator)
                        {
                            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary rounded-pill fw-bold shadow-sm px-4" style="background-color: #4f46e5; border: none;">
                                <i class="bi bi-plus-lg me-1"></i>Thêm ứng dụng xác thực
                            </a>
                        }
                        else
                        {
                            <div class="d-flex gap-2 flex-wrap">
                                <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" style="background-color: #4f46e5; border: none;">
                                    <i class="bi bi-gear-fill me-1"></i>Cấu hình lại
                                </a>
                                <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">
                                    <i class="bi bi-trash me-1"></i>Xóa cấu hình
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-danger rounded-3">
                    <strong><i class="bi bi-x-circle-fill me-2"></i>Chưa chấp nhận chính sách Cookie.</strong>
                    <p class="mb-0 mt-1 small">Bạn cần chấp nhận chính sách quyền riêng tư trước khi bật tính năng này.</p>
                </div>
            }
        }
    </div>

    <div class="col-md-5 d-none d-md-block border-start ps-4">
        <div class="text-center mt-3">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 120px; height: 120px;">
                <i class="bi bi-shield-lock text-primary opacity-50" style="font-size: 4rem;"></i>
            </div>

            <div class="mt-4 text-start">
                <h6 class="fw-bold text-dark">Tại sao nên dùng 2FA?</h6>
                <ul class="text-muted small ps-3 mb-0">
                    <li class="mb-2">Bảo vệ tài khoản ngay cả khi lộ mật khẩu.</li>
                    <li class="mb-2">Sử dụng mã OTP từ Google Authenticator hoặc Microsoft Authenticator.</li>
                    <li>Tăng cường an toàn cho giao dịch và thông tin cá nhân.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}