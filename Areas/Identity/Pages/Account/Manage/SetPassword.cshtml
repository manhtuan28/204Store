@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Thiết lập mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <div class="card-header bg-primary bg-opacity-10 p-4 border-0">
                <div class="d-flex align-items-center">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm text-primary me-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-shield-plus fs-3"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-primary mb-1">@ViewData["Title"]</h4>
                        <p class="text-muted small mb-0">Tạo mật khẩu cho tài khoản liên kết Google/Facebook.</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">

                <div class="alert alert-info border-info border-opacity-25 bg-info bg-opacity-10 rounded-3 mb-4">
                    <div class="d-flex">
                        <i class="bi bi-info-circle-fill text-info me-3 fs-4"></i>
                        <div>
                            <strong>Bạn chưa có mật khẩu nội bộ:</strong>
                            <p class="mb-0 small mt-1">
                                Tài khoản này hiện đang đăng nhập thông qua liên kết ngoài (Google, Facebook...).
                                Hãy thiết lập mật khẩu để bạn có thể đăng nhập trực tiếp bằng Email và Mật khẩu mà không phụ thuộc vào bên thứ ba.
                            </p>
                        </div>
                    </div>
                </div>

                <form id="set-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.NewPassword" class="form-control bg-light" autocomplete="new-password" placeholder="Nhập mật khẩu mới" />
                        <label asp-for="Input.NewPassword" class="form-label text-muted">Mật khẩu mới</label>
                        <span asp-validation-for="Input.NewPassword" class="text-danger small ms-1"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control bg-light" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
                        <label asp-for="Input.ConfirmPassword" class="form-label text-muted">Xác nhận mật khẩu</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small ms-1"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-check2-circle me-2"></i>Thiết lập mật khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}