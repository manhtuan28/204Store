@page
@model Disable2faModel
@{
    ViewData["Title"] = "Tắt xác thực 2 lớp";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card border-warning shadow-sm rounded-4 overflow-hidden">

            <div class="card-header bg-warning bg-opacity-25 p-4 text-center border-0">
                <div class="mb-3">
                    <div class="bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 70px; height: 70px;">
                        <i class="bi bi-shield-slash-fill fs-2"></i>
                    </div>
                </div>
                <h4 class="fw-bold text-dark mb-1">Tắt xác thực 2 lớp (2FA)</h4>
                <p class="mb-0 text-muted small">Hành động này sẽ làm giảm tính bảo mật của tài khoản.</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="alert alert-danger border-danger border-opacity-25 bg-danger bg-opacity-10 rounded-3 mb-4">
                    <div class="d-flex">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-3 fs-4"></i>
                        <div>
                            <strong>Lưu ý quan trọng:</strong>
                            <p class="mb-0 small mt-1">
                                Việc tắt xác thực 2 lớp không làm thay đổi các khóa trong ứng dụng xác thực của bạn.
                                Nếu bạn muốn đổi sang thiết bị mới hoặc cài đặt lại, bạn cần phải cấu hình lại từ đầu sau khi bật lại tính năng này.
                            </p>
                        </div>
                    </div>
                </div>

                <form method="post">
                    <div class="d-grid gap-2">
                        <button class="btn btn-warning btn-lg rounded-pill fw-bold shadow-sm text-dark" type="submit">
                            <i class="bi bi-shield-slash me-2"></i>Xác nhận tắt 2FA
                        </button>
                        <a asp-page="./TwoFactorAuthentication" class="btn btn-light rounded-pill fw-bold text-muted mt-2">
                            <i class="bi bi-x-lg me-2"></i>Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />