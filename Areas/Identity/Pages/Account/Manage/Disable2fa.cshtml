@page
@model Disable2faModel
@{
    ViewData["Title"] = "Tắt xác thực 2 lớp (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h4 class="fw-bold text-danger mb-4 border-bottom pb-2">
    <i class="bi bi-shield-slash-fill me-2"></i>@ViewData["Title"]
</h4>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-7">
        <div class="alert alert-warning bg-warning bg-opacity-10 border-warning border-opacity-25 rounded-4 p-4 mb-4">
            <div class="d-flex">
                <div class="flex-shrink-0">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-3"></i>
                </div>
                <div class="ms-3">
                    <h5 class="alert-heading fw-bold text-dark">Lưu ý quan trọng!</h5>
                    <p class="mb-2 text-dark opacity-75">
                        Hành động này <strong>chỉ tắt tính năng</strong> xác thực 2 lớp trên tài khoản này.
                    </p>
                    <hr class="border-warning opacity-25">
                    <p class="mb-0 small text-dark opacity-75">
                        Việc tắt 2FA không làm thay đổi khóa bí mật trong ứng dụng xác thực (Google/Microsoft Authenticator).
                        Nếu bạn muốn thay đổi khóa hoặc xóa quyền truy cập của ứng dụng cũ, hãy dùng chức năng
                        <a asp-page="./ResetAuthenticator" class="fw-bold text-dark text-decoration-underline">Đặt lại ứng dụng xác thực</a>.
                    </p>
                </div>
            </div>
        </div>

        <div class="card border-danger border-opacity-25 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h6 class="fw-bold text-danger mb-3">Xác nhận hành động</h6>
                <p class="text-muted small mb-4">
                    Tài khoản của bạn sẽ giảm bớt một lớp bảo mật. Chúng tôi khuyên bạn nên cân nhắc kỹ trước khi thực hiện.
                </p>

                <form method="post">
                    <div class="d-grid gap-2 d-md-block">
                        <button class="btn btn-danger rounded-pill fw-bold px-4 py-2 shadow-sm" type="submit">
                            <i class="bi bi-shield-x me-2"></i>Xác nhận tắt 2FA
                        </button>
                        <a asp-page="./TwoFactorAuthentication" class="btn btn-light rounded-pill fw-bold px-4 py-2 text-muted ms-md-2">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-5 d-none d-md-block border-start ps-4">
        <div class="text-center mt-4">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 120px; height: 120px;">
                <i class="bi bi-unlock-fill text-danger opacity-50" style="font-size: 4rem;"></i>
            </div>
            <p class="text-muted small mt-4 px-3">
                Bảo mật 2 lớp là phương thức hiệu quả nhất để bảo vệ tài khoản khỏi việc đăng nhập trái phép.
            </p>
        </div>
    </div>
</div>