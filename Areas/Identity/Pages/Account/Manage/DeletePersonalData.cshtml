@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Xóa tài khoản";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card border-danger shadow-sm rounded-4 overflow-hidden">

            <div class="card-header bg-danger text-white p-4 text-center border-0">
                <div class="mb-3">
                    <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-1">CẢNH BÁO: Hành động này không thể hoàn tác!</h4>
                <p class="mb-0 opacity-75 small">Toàn bộ dữ liệu cá nhân của bạn sẽ bị xóa vĩnh viễn khỏi hệ thống.</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="alert alert-warning border-warning border-opacity-25 bg-warning bg-opacity-10 rounded-3 mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Nếu bạn xóa tài khoản, tất cả lịch sử mua hàng, điểm thưởng và thông tin cá nhân sẽ bị mất và <strong>không thể khôi phục lại</strong>.
                </div>

                <form id="delete-user" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center fw-bold" role="alert"></div>

                    @if (Model.RequirePassword)
                    {
                        <div class="form-floating mb-4">
                            <input asp-for="Input.Password" class="form-control bg-light" autocomplete="current-password" aria-required="true" placeholder="Nhập mật khẩu của bạn" />
                            <label asp-for="Input.Password" class="text-muted">Nhập mật khẩu xác nhận</label>
                            <span asp-validation-for="Input.Password" class="text-danger small ms-1"></span>
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <button class="btn btn-danger btn-lg rounded-pill fw-bold shadow-sm" type="submit">
                            <i class="bi bi-trash3-fill me-2"></i>Xác nhận xóa tài khoản
                        </button>
                        <a asp-page="Index" class="btn btn-light rounded-pill fw-bold text-muted mt-2">
                            <i class="bi bi-x-lg me-2"></i>Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}