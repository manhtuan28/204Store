@page
@model IndexModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h4 class="fw-bold text-primary mb-4 border-bottom pb-2">
    <i class="bi bi-person-circle me-2"></i>@ViewData["Title"]
</h4>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-7">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control bg-light border-0 fw-bold text-secondary" placeholder="Tên đăng nhập" disabled />
                <label asp-for="Username" class="text-muted"><i class="bi bi-person-badge me-2"></i>Tên đăng nhập / Email</label>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.PhoneNumber" class="form-control bg-light border-0" placeholder="Số điện thoại" />
                <label asp-for="Input.PhoneNumber" class="text-muted"><i class="bi bi-telephone me-2"></i>Số điện thoại</label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger small ms-1"></span>
            </div>

            <button id="update-profile-button" type="submit" class="btn btn-primary rounded-pill fw-bold px-4 py-2 shadow-sm" style="background-color: #4f46e5; border: none;">
                <i class="bi bi-check-circle-fill me-2"></i>Lưu thay đổi
            </button>
        </form>
    </div>

    <div class="col-md-5 d-none d-md-block border-start ps-4">
        <div class="text-center mt-3">
            <div class="position-relative d-inline-block">
                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 150px; height: 150px;">
                    <i class="bi bi-person text-secondary opacity-25" style="font-size: 5rem;"></i>
                </div>
                <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle p-2" title="Đang hoạt động"></span>
            </div>

            <p class="text-muted small mt-3 px-3">
                Thông tin hồ sơ của bạn sẽ được bảo mật. <br>
                Hãy cập nhật số điện thoại để tăng cường bảo mật tài khoản.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}