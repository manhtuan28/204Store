@page
@model IndexModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <div class="card-header bg-primary bg-opacity-10 p-4 border-0 d-flex align-items-center">
                <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm text-primary me-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-person-bounding-box fs-3"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-primary mb-0">@ViewData["Title"]</h4>
                    <p class="text-muted small mb-0">Cập nhật thông tin cơ bản của bạn.</p>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <form id="profile-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Username" class="form-control bg-light text-muted" disabled />
                        <label asp-for="Username" class="form-label">Tên đăng nhập / Email</label>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                        <label asp-for="Input.PhoneNumber" class="form-label">Số điện thoại</label>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small ms-1"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                        <button id="update-profile-button" type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm px-5">
                            <i class="bi bi-save2-fill me-2"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}