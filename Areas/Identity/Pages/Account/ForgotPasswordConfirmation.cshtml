@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Đã gửi yêu cầu";
}

<div class="container" style="margin-top: 80px; margin-bottom: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 text-center">

                <div class="mb-4">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 100px; height: 100px;">
                        <i class="bi bi-envelope-check-fill display-3"></i>
                    </div>
                </div>

                <h3 class="fw-bold text-dark mb-3">Kiểm tra email của bạn</h3>

                <p class="text-muted mb-4">
                    Chúng tôi đã gửi hướng dẫn đặt lại mật khẩu đến địa chỉ email của bạn.<br>
                    Vui lòng kiểm tra hộp thư đến (và cả mục <strong>Spam/Rác</strong> nếu không thấy).
                </p>

                <div class="d-grid gap-2 col-10 mx-auto">
                    <a asp-page="./Login" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #4f46e5; border: none;">
                        <i class="bi bi-arrow-left me-2"></i>Quay lại đăng nhập
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>