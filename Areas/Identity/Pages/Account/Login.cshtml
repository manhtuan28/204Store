@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container" style="margin-top: 50px; margin-bottom: 80px;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-primary bg-opacity-10 p-4 text-center border-bottom border-light">
                    <div class="mb-2">
                        <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm text-primary" style="width: 60px; height: 60px;">
                            <i class="bi bi-person-fill fs-2"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-primary mb-1">Chào mừng trở lại!</h4>
                    <p class="text-muted small mb-0">Đăng nhập để tiếp tục mua sắm tại 204Store</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form id="account" method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control bg-light border-0" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="text-muted">Địa chỉ Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control bg-light border-0" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="text-muted">Mật khẩu</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label text-muted small user-select-none" asp-for="Input.RememberMe">
                                    Ghi nhớ đăng nhập
                                </label>
                            </div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small text-primary fw-semibold">
                                Quên mật khẩu?
                            </a>
                        </div>

                        <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg rounded-pill fw-bold shadow-sm mb-3" style="background-color: #4f46e5; border: none;">
                            Đăng nhập
                        </button>

                        <div class="text-center">
                            <span class="text-muted small">Chưa có tài khoản?</span>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-bold text-primary ms-1">
                                Đăng ký ngay
                            </a>
                        </div>

                        <div class="text-center mt-2">
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-muted small text-decoration-underline" style="font-size: 0.75rem;">
                                Bạn chưa nhận được email xác thực?
                            </a>
                        </div>
                    </form>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="position-relative text-center my-4">
                            <hr class="text-muted opacity-25">
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">Hoặc đăng nhập với</span>
                        </div>

                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="text-center">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-secondary rounded-pill px-4 mx-1 mb-2" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                    <i class="bi bi-shield-lock me-1"></i> @provider.DisplayName
                                </button>
                            }
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}