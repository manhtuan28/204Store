@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Xác thực bằng mã khôi phục";
}

<div class="container" style="margin-top: 60px; margin-bottom: 80px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-primary bg-opacity-10 p-4 text-center border-bottom border-light">
                    <div class="mb-3">
                        <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm text-primary" style="width: 70px; height: 70px;">
                            <i class="bi bi-life-preserver fs-2"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-primary mb-1">Mã khôi phục</h4>
                    <p class="text-muted small mb-0">Sử dụng mã khôi phục dự phòng để đăng nhập.</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <p class="text-muted small mb-4 text-center">
                        <i class="bi bi-info-circle me-1"></i>
                        Lưu ý: Bạn cần cấu hình lại ứng dụng xác thực sau khi đăng nhập thành công.
                    </p>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Input.RecoveryCode" class="form-label d-block text-center text-muted small fw-bold text-uppercase">Nhập mã khôi phục</label>
                            <input asp-for="Input.RecoveryCode"
                                   class="form-control form-control-lg bg-light border-0 fw-bold text-center text-primary"
                                   autocomplete="off"
                                   placeholder="XXXXX-XXXXX"
                                   style="font-size: 1.5rem; letter-spacing: 2px; height: 60px;" />
                            <span asp-validation-for="Input.RecoveryCode" class="text-danger small d-block text-center mt-2"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #4f46e5; border: none;">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập ngay
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}