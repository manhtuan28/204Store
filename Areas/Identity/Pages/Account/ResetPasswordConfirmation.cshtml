@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Đổi mật khẩu thành công";
}

<div class="container" style="margin-top: 80px; margin-bottom: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">

                <div class="pt-5 pb-4">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm animate__animated animate__bounceIn" style="width: 100px; height: 100px;">
                        <i class="bi bi-check-lg display-3"></i>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 pt-0">
                    <h3 class="fw-bold text-dark mb-3">Thành công!</h3>

                    <p class="text-muted mb-4">
                        Mật khẩu của bạn đã được đặt lại hoàn tất.<br>
                        Bây giờ bạn có thể sử dụng mật khẩu mới để truy cập vào tài khoản.
                    </p>

                    <div class="d-grid gap-2 col-10 mx-auto">
                        <a asp-page="./Login" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #4f46e5; border: none;">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập ngay
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>