@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Xác thực thay đổi Email";
}

<div class="container" style="margin-top: 80px; margin-bottom: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">

                <div class="pt-5 pb-4">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 100px; height: 100px;">
                        <i class="bi bi-arrow-repeat display-3"></i>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 pt-0">
                    <h3 class="fw-bold text-dark mb-3">@ViewData["Title"]</h3>

                    <div class="mb-4 text-start">
                        <partial name="_StatusMessage" model="Model.StatusMessage" />
                    </div>

                    <p class="text-muted mb-4 small">
                        Địa chỉ email mới của bạn đã được cập nhật vào hệ thống.<br>
                        Vui lòng sử dụng email mới này cho lần đăng nhập tiếp theo.
                    </p>

                    <div class="d-grid gap-2 col-10 mx-auto">
                        <a asp-page="./Login" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #4f46e5; border: none;">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập lại
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>