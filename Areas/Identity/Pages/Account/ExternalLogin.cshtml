@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Hoàn tất đăng ký";
}

<div class="container" style="margin-top: 60px; margin-bottom: 80px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-success bg-opacity-10 p-4 text-center border-bottom border-light">
                    <div class="mb-3">
                        <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm text-success" style="width: 70px; height: 70px;">
                            <i class="bi bi-link-45deg fs-1"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-success mb-1">Liên kết tài khoản</h4>
                    <p class="text-muted small mb-0">Kết nối với <strong>@Model.ProviderDisplayName</strong></p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="alert alert-info bg-info bg-opacity-10 border-info border-opacity-25 rounded-3 mb-4">
                        <div class="d-flex">
                            <i class="bi bi-info-circle-fill text-info me-2 mt-1"></i>
                            <div class="small text-dark opacity-75">
                                Bạn đã xác thực thành công từ <strong>@Model.ProviderDisplayName</strong>. <br>
                                Vui lòng xác nhận địa chỉ email bên dưới để hoàn tất việc tạo tài khoản trên hệ thống.
                            </div>
                        </div>
                    </div>

                    <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center" role="alert"></div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.Email" class="form-control bg-light border-0" autocomplete="email" placeholder="Nhập email của bạn" />
                            <label asp-for="Input.Email" class="text-muted">Email đăng ký</label>
                            <span asp-validation-for="Input.Email" class="text-danger small ms-1"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #4f46e5; border: none;">
                                <i class="bi bi-person-check-fill me-2"></i>Hoàn tất đăng ký
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}