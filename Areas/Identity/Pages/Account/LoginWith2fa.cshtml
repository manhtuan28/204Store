@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Xác thực 2 lớp";
}

<div class="container" style="margin-top: 60px; margin-bottom: 80px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-primary bg-opacity-10 p-4 text-center border-bottom border-light">
                    <div class="mb-3">
                        <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm text-primary" style="width: 70px; height: 70px;">
                            <i class="bi bi-shield-lock-fill fs-2"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-primary mb-1">Bảo mật 2 lớp</h4>
                    <p class="text-muted small mb-0">Nhập mã 6 số từ ứng dụng xác thực của bạn.</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                        <input asp-for="RememberMe" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Input.TwoFactorCode" class="form-label d-block text-center text-muted small fw-bold text-uppercase">Mã xác thực (OTP)</label>
                            <input asp-for="Input.TwoFactorCode"
                                   class="form-control form-control-lg bg-light border-0 fw-bold text-center text-primary"
                                   autocomplete="off"
                                   placeholder="------"
                                   style="font-size: 2rem; letter-spacing: 0.5rem; height: 60px;" />
                            <span asp-validation-for="Input.TwoFactorCode" class="text-danger small d-block text-center mt-2"></span>
                        </div>

                        <div class="form-check mb-4 d-flex justify-content-center">
                            <input class="form-check-input me-2" asp-for="Input.RememberMachine" />
                            <label class="form-check-label text-muted small user-select-none" asp-for="Input.RememberMachine">
                                Tin cậy thiết bị này trong 30 ngày
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" style="background-color: #4f46e5; border: none;">
                                <i class="bi bi-unlock-fill me-2"></i>Xác nhận đăng nhập
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <p class="text-muted small mb-2">Bạn bị mất điện thoại hoặc không thể lấy mã?</p>
                        <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-light rounded-pill px-4 text-primary fw-bold fs-sm">
                            <i class="bi bi-life-preserver me-2"></i>Dùng mã khôi phục
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}