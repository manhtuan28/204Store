@model _204Store.Models.Category

@{
    ViewData["Title"] = "Thêm danh mục";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none text-muted small fw-bold">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3 text-primary">
                        <i class="bi bi-folder-plus fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">Thêm danh mục mới</h5>
                        <p class="text-muted small mb-0">Điền thông tin chi tiết bên dưới</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold text-secondary small">TÊN DANH MỤC</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 text-muted ps-3 rounded-start-3"><i class="bi bi-tag"></i></span>
                            <input asp-for="Name" class="form-control form-control-lg bg-light border-0 rounded-end-3" placeholder="Nhập tên danh mục..." />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold text-secondary small">THỨ TỰ HIỂN THỊ</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 text-muted ps-3 rounded-start-3"><i class="bi bi-sort-numeric-down"></i></span>
                            <input asp-for="DisplayOrder" class="form-control form-control-lg bg-light border-0 rounded-end-3" type="number" min="1" placeholder="Ví dụ: 1" />
                        </div>
                        <span asp-validation-for="DisplayOrder" class="text-danger small mt-1 d-block ms-1"></span>
                        <div class="form-text small ms-1">Số càng nhỏ sẽ hiển thị càng cao.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ParentId" class="form-label fw-semibold text-secondary">Danh mục cha (Tùy chọn)</label>
                        <select asp-for="ParentId" class="form-select" asp-items="ViewBag.ParentId">
                            <option value="">-- Là danh mục gốc --</option>
                        </select>
                    </div>
                    <div class="pt-2">
                        <button type="submit" class="btn btn-primary w-100 fw-bold rounded-3 py-3 mb-2 shadow-sm" style="background-color: #4f46e5; border-color: #4f46e5;">
                            <i class="bi bi-check-lg me-2"></i>Hoàn tất tạo mới
                        </button>
                        <a asp-action="Index" class="btn btn-light w-100 fw-bold rounded-3 py-3 text-muted">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}