@model _204Store.Models.Category

@{
    ViewData["Title"] = "Sửa danh mục";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <h5 class="fw-bold mb-0">Chỉnh sửa danh mục</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold text-secondary small text-uppercase">Tên danh mục</label>
                        <input asp-for="Name" class="form-control form-control-lg rounded-3 bg-light border-0" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold text-secondary small text-uppercase">Thứ tự hiển thị</label>
                        <input asp-for="DisplayOrder" class="form-control form-control-lg rounded-3 bg-light border-0" type="number" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 pt-2">
                        <button type="submit" class="btn btn-primary fw-bold rounded-3 px-4 flex-grow-1">Cập nhật</button>
                        <a asp-action="Index" class="btn btn-light fw-bold rounded-3 px-4 text-muted">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}