@model _204Store.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="bg-danger p-2"></div>

            <div class="card-body p-5 text-center">
                <div class="mb-4 position-relative">
                    <div class="avatar-lg bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto animate-pulse" style="width: 90px; height: 90px;">
                        <i class="bi bi-trash3-fill text-danger display-4"></i>
                    </div>
                </div>

                <h4 class="fw-bold mb-2 text-dark">Xác nhận xóa?</h4>
                <p class="text-muted mb-4 px-3">
                    Bạn đang thực hiện xóa danh mục: <br />
                    <span class="badge bg-light text-dark border mt-2 fs-6 px-3 py-2">@Model.Name</span>
                    <br /><br />
                    <span class="small text-danger"><i class="bi bi-exclamation-triangle me-1"></i>Hành động này không thể hoàn tác!</span>
                </p>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger fw-bold rounded-3 py-3 shadow-sm">
                            <i class="bi bi-trash me-2"></i>Xác nhận xóa
                        </button>
                        <a asp-action="Index" class="btn btn-light fw-bold rounded-3 py-3 text-muted">
                            Không, quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>