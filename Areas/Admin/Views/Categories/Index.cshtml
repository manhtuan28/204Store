@model IEnumerable<_204Store.Models.Category>

@{
    ViewData["Title"] = "Quản lý Danh mục";
    var parentCategories = Model.Where(c => c.ParentId == null || c.ParentId == 0).OrderBy(c => c.DisplayOrder);
    var allCategories = Model.ToList();
}

<style>
    .text-theme {
        color: #4f46e5;
    }

    .bg-theme {
        background-color: #4f46e5;
    }

    .btn-theme {
        background-color: #4f46e5;
        color: white;
        border: none;
    }

        .btn-theme:hover {
            background-color: #4338ca;
            color: white;
        }
    .table-hover tbody tr:hover {
        background-color: rgba(79, 70, 229, 0.04);
    }
    .tree-line {
        border-left: 2px dashed #cbd5e1;
        height: 100%;
        position: absolute;
        left: 25px;
        top: 0;
    }
</style>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Danh mục sản phẩm</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted small">Admin</a></li>
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted small">Kho hàng</a></li>
                    <li class="breadcrumb-item active small" aria-current="page">Danh mục</li>
                </ol>
            </nav>
        </div>
        <a asp-action="Create" class="btn btn-theme fw-bold rounded-3 shadow-sm px-4 py-2">
            <i class="bi bi-plus-lg me-2"></i>Thêm danh mục
        </a>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-success border-4 bg-white" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
                <div>
                    <h6 class="fw-bold mb-0 text-success">Thành công!</h6>
                    <small class="text-muted">@TempData["success"]</small>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold m-0 text-secondary"><i class="bi bi-diagram-3 me-2"></i>Cấu trúc danh mục</h6>
            <div class="input-group" style="max-width: 250px;">
                <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control bg-light border-0 small" placeholder="Tìm kiếm...">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase text-secondary small fw-bold" style="width: 80px;">ID</th>
                        <th class="py-3 text-uppercase text-secondary small fw-bold">Tên Danh Mục</th>
                        <th class="py-3 text-uppercase text-secondary small fw-bold">Cấp độ</th>
                        <th class="py-3 text-uppercase text-secondary small fw-bold text-center">Thứ tự</th>
                        <th class="pe-4 py-3 text-uppercase text-secondary small fw-bold text-end" style="width: 150px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var parent in parentCategories)
                    {
                        <tr class="bg-light bg-opacity-25">
                            <td class="ps-4 text-muted small fw-bold">#@parent.Id</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 rounded p-2 me-3 text-primary">
                                        <i class="bi bi-folder-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <span class="fw-bold text-dark d-block text-uppercase">@parent.Name</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-10">Danh mục Gốc</span></td>
                            <td class="text-center">
                                <span class="fw-bold text-dark">@parent.DisplayOrder</span>
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-action="Edit" asp-route-id="@parent.Id" class="btn btn-light text-primary btn-sm rounded-2 me-1" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@parent.Id" class="btn btn-light text-danger btn-sm rounded-2" title="Xóa"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>

                        var children = allCategories.Where(c => c.ParentId == parent.Id).OrderBy(c => c.DisplayOrder);
                        foreach (var child in children)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">#@child.Id</td>
                                <td>
                                    <div class="d-flex align-items-center" style="padding-left: 40px; position: relative;">
                                        <i class="bi bi-arrow-return-right text-muted me-2 fs-5"></i>
                                        <div>
                                            <span class="fw-medium text-secondary d-block">@child.Name</span>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-10">Danh mục Con</span></td>
                                <td class="text-center">
                                    <span class="text-muted small">@child.DisplayOrder</span>
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Edit" asp-route-id="@child.Id" class="btn btn-light text-primary btn-sm rounded-2 me-1" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                    <a asp-action="Delete" asp-route-id="@child.Id" class="btn btn-light text-danger btn-sm rounded-2" title="Xóa"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="bi bi-inbox text-muted opacity-25" style="font-size: 4rem;"></i>
                </div>
                <h5 class="fw-bold text-secondary">Chưa có dữ liệu</h5>
                <p class="text-muted mb-4">Hiện chưa có danh mục nào được tạo.</p>
                <a asp-action="Create" class="btn btn-outline-primary rounded-3 px-4">
                    Tạo ngay danh mục đầu tiên
                </a>
            </div>
        }
    </div>
</div>