@model IEnumerable<_204Store.Models.ApplicationUser>

@{
    ViewData["Title"] = "Danh sách Khách hàng";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-people-fill me-2"></i>Hồ sơ khách hàng</h2>
            <p class="text-muted mb-0">Quản lý thông tin và lịch sử mua hàng của người dùng.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-0">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control bg-light border-0" placeholder="Tìm kiếm khách hàng..." id="customerSearch">
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3">Khách hàng</th>
                            <th class="py-3">Liên hệ</th>
                            <th class="py-3">Địa chỉ</th>
                            <th class="py-3 text-center">Ngày tham gia</th>
                            <th class="pe-4 py-3 text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="position-relative me-3">
                                            @if (!string.IsNullOrEmpty(item.ProfilePictureUrl))
                                            {
                                                <img src="@item.ProfilePictureUrl" class="rounded-circle object-fit-cover" width="45" height="45" />
                                            }
                                            else
                                            {
                                                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 45px; height: 45px;">
                                                    @(item.Email?.Substring(0, 1).ToUpper() ?? "U")
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark">@(item.FullName ?? "Chưa cập nhật tên")</h6>
                                            <small class="text-muted">ID: @(item.Id.Length > 8 ? item.Id.Substring(0, 8) + "..." : item.Id)</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="text-dark"><i class="bi bi-envelope me-1 text-muted small"></i>@item.Email</span>
                                        <small class="text-muted"><i class="bi bi-telephone me-1 small"></i>@(item.PhoneNumber ?? "---")</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-secondary small">
                                        <i class="bi bi-geo-alt me-1"></i>@(item.Address ?? "Chưa cập nhật địa chỉ")
                                    </span>
                                </td>
                                <td class="text-center text-muted small">
                                    @if (item.CreatedDate.HasValue)
                                    {
                                        @item.CreatedDate.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span>---</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm fw-bold">
                                        <i class="bi bi-eye me-1"></i>Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-people fs-1 opacity-50"></i>
                    <p class="mt-2">Chưa có khách hàng nào trong hệ thống.</p>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.getElementById('customerSearch').addEventListener('keyup', function() {
        let value = this.value.toLowerCase();
        let rows = document.querySelectorAll('tbody tr');

        rows.forEach(row => {
            let text = row.innerText.toLowerCase();
            row.style.display = text.includes(value) ? '' : 'none';
        });
    });
</script>