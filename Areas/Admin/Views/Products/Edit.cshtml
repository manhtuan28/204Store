@model _204Store.Models.Product

@{
    ViewData["Title"] = "Cập nhật: " + Model.Name;
    var categories = ViewData["Categories"] as List<_204Store.Models.Category> ?? new List<_204Store.Models.Category>();
    var allCategories = ViewData["AllCategories"] as List<_204Store.Models.Category> ?? new List<_204Store.Models.Category>();
    var selectedCategories = ViewData["SelectedCategories"] as List<int> ?? new List<int>();
}

<style>
    :root {
        --primary: #4f46e5;
        --bg-light: #f8fafc;
        --border-color: #e2e8f0;
    }

    body {
        background-color: #f1f5f9;
    }

    .card-modern {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        background: white;
        overflow: hidden;
    }

    .card-header-modern {
        background: white;
        border-bottom: 1px solid var(--border-color);
        padding: 20px 24px;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-label-custom {
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 8px;
    }

    .input-modern {
        background-color: var(--bg-light);
        border: 1px solid transparent;
        border-radius: 10px;
        padding: 12px 15px;
        font-weight: 500;
        transition: all 0.2s;
    }

        .input-modern:focus {
            background-color: white;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
        gap: 10px;
    }

    .gallery-item {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        aspect-ratio: 1/1;
    }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .btn-delete-img {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 20px;
        height: 20px;
        background: rgba(220, 38, 38, 0.9);
        color: white;
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-delete-img:hover {
            background: #ef4444;
            transform: scale(1.1);
        }

    .table-specs thead th {
        background: #f8fafc;
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 700;
        border-bottom: 2px solid #e2e8f0;
        padding: 12px 20px;
    }

    .spec-input {
        border: none;
        background: transparent;
        width: 100%;
        padding: 8px;
        font-weight: 500;
    }

        .spec-input:focus {
            outline: none;
            background: #f1f5f9;
            border-radius: 6px;
        }

    .category-parent {
        background-color: #f1f5f9;
        border-radius: 8px;
        padding: 8px 12px;
        margin-bottom: 4px;
    }

    .category-child {
        padding-left: 28px;
        border-left: 2px solid #e2e8f0;
        margin-left: 12px;
    }
</style>

<div class="container-xl py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-muted text-decoration-none">Danh sách</a></li>
                    <li class="breadcrumb-item active fw-bold text-primary">Cập nhật</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark m-0">@Model.Name</h3>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-light fw-bold px-4 rounded-pill">Hủy bỏ</a>
            <button type="button" onclick="$('#editForm').submit()" class="btn btn-primary fw-bold px-4 rounded-pill shadow-sm">
                <i class="bi bi-save me-2"></i>Lưu thay đổi
            </button>
        </div>
    </div>

    <form asp-action="Edit" id="editForm" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />
        <input type="hidden" asp-for="Specifications" id="specsJson" />

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card-modern mb-4">
                    <div class="card-header-modern">
                        <span><i class="bi bi-pencil-square text-primary"></i> Thông tin chung</span>
                        <span class="badge bg-light text-secondary border">ID: #@Model.Id</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label-custom">Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control input-modern fw-bold text-dark" />
                            <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Description" class="form-label-custom">Mô tả</label>
                            <textarea asp-for="Description" class="form-control input-modern" rows="8"></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>

                <div class="card-modern">
                    <div class="card-header-modern">
                        <span><i class="bi bi-cpu text-primary"></i> Thông số kỹ thuật</span>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" onclick="addSpecRow()">
                            <i class="bi bi-plus-lg"></i> Thêm dòng
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <table class="table mb-0 table-specs" id="specsTable">
                            <thead>
                                <tr>
                                    <th class="ps-4" style="width: 40%">Tên thông số</th>
                                    <th>Giá trị</th>
                                    <th style="width: 50px" class="text-center">#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <div id="noSpecsMsg" class="p-5 text-center text-muted" style="display:none;">
                            <div class="bg-light rounded-circle d-inline-flex p-3 mb-3">
                                <i class="bi bi-sliders2 fs-3 text-secondary"></i>
                            </div>
                            <p class="mb-1 fw-bold">Chưa có thông số nào</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card-modern mb-4">
                    <div class="card-header-modern">
                        <span><i class="bi bi-gear-fill text-primary"></i> Thiết lập</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <label class="form-label-custom">Danh mục</label>
                            <div class="border rounded-3 p-3 bg-white" style="max-height: 280px; overflow-y: auto;">
                                @{
                                    var parentCategories = allCategories.Where(c => c.ParentId == null || c.ParentId == 0).OrderBy(c => c.DisplayOrder);
                                }
                                @foreach (var parent in parentCategories)
                                {
                                    <div class="category-parent">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   name="selectedCategories"
                                                   value="@parent.Id"
                                                   id="cat_@parent.Id"
                                                   @(selectedCategories.Contains(parent.Id) ? "checked" : "") />
                                            <label class="form-check-label fw-bold text-dark" for="cat_@parent.Id">
                                                @if (!string.IsNullOrEmpty(parent.Icon))
                                                {
                                                    <i class="@parent.Icon me-1 text-primary"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-folder-fill me-1 text-primary"></i>
                                                }
                                                @parent.Name
                                            </label>
                                        </div>
                                    </div>
                                    
                                    var children = allCategories.Where(c => c.ParentId == parent.Id).OrderBy(c => c.DisplayOrder);
                                    @foreach (var child in children)
                                    {
                                        <div class="category-child">
                                            <div class="form-check py-1">
                                                <input class="form-check-input" type="checkbox"
                                                       name="selectedCategories"
                                                       value="@child.Id"
                                                       id="cat_@child.Id"
                                                       @(selectedCategories.Contains(child.Id) ? "checked" : "") />
                                                <label class="form-check-label text-secondary" for="cat_@child.Id">
                                                    @if (!string.IsNullOrEmpty(child.Icon))
                                                    {
                                                        <i class="@child.Icon me-1"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-circle me-1" style="font-size: 0.5rem;"></i>
                                                    }
                                                    @child.Name
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="form-text small mt-2">
                                <i class="bi bi-info-circle me-1"></i>Chọn một hoặc nhiều danh mục
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded-3 mb-3 border border-light">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="IsFeatured" id="featuredSwitch">
                                <label class="form-check-label fw-bold small text-uppercase text-secondary ms-2" for="featuredSwitch">Nổi bật</label>
                            </div>
                        </div>

                        <div>
                            <label asp-for="DiscountRate" class="form-label-custom">Giảm giá (%)</label>
                            <div class="input-group">
                                <input asp-for="DiscountRate" class="form-control input-modern" type="number" min="0" max="100" />
                                <span class="input-group-text bg-light border-0 fw-bold">%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-modern">
                    <div class="card-header-modern">
                        <span><i class="bi bi-image text-primary"></i> Hình ảnh</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <div class="position-relative d-inline-block">
                                <img id="imagePreview" src="@Model.ImageUrl" class="rounded-3 shadow-sm border" style="width: 100%; max-height: 220px; object-fit: contain;" onerror="this.src='https://placehold.co/400x300?text=No+Image'" />
                                <button type="button" class="btn btn-primary btn-sm rounded-pill position-absolute bottom-0 start-50 translate-middle-x mb-2 px-3 shadow-sm" onclick="document.getElementById('fileInput').click()">
                                    <i class="bi bi-camera me-1"></i>Đổi ảnh
                                </button>
                            </div>
                            <input type="file" name="file" id="fileInput" class="d-none" accept="image/*" onchange="previewImage(event)" />
                        </div>

                        <hr class="text-secondary opacity-25" />

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label-custom m-0">Thư viện ảnh</label>
                            <button type="button" class="btn btn-sm btn-light text-primary fw-bold" onclick="document.getElementById('galleryInput').click()">
                                <i class="bi bi-plus-circle me-1"></i>Thêm
                            </button>
                        </div>

                        <div class="gallery-grid mb-3">
                            @if (Model.ProductImages != null && Model.ProductImages.Any())
                            {
                                @foreach (var img in Model.ProductImages)
                                {
                                    <div class="gallery-item" id="img-container-@img.Id">
                                        <img src="@img.Url" />
                                        <button type="button" onclick="deleteImage(@img.Id)" class="btn-delete-img shadow-sm"><i class="bi bi-x"></i></button>
                                    </div>
                                }
                            }
                        </div>

                        <input type="file" name="galleryFiles" id="galleryInput" class="d-none" multiple accept="image/*" />
                        @if (Model.ProductImages == null || !Model.ProductImages.Any())
                        {
                            <div class="text-center text-muted small py-3 bg-light rounded-3 fst-italic">Chưa có ảnh phụ nào.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function(){ document.getElementById('imagePreview').src = reader.result; };
            if(event.target.files[0]) reader.readAsDataURL(event.target.files[0]);
        }

        function deleteImage(id) {
            if(confirm('Bạn có chắc muốn xóa ảnh này khỏi thư viện?')) {
                $.ajax({
                    url: '/Admin/Products/DeleteImage', type: 'POST', data: { imageId: id },
                    success: function(res) {
                        if(res.success) {
                            $('#img-container-' + id).fadeOut(300, function(){ $(this).remove(); });
                        } else alert('Lỗi: ' + res.message);
                    }
                });
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            var existingSpecs = '@Html.Raw(Model?.Specifications ?? "[]")';
            try {
                var specsArray = JSON.parse(existingSpecs);
                if (Array.isArray(specsArray) && specsArray.length > 0) {
                    specsArray.forEach(item => addSpecRow(item.Key, item.Value));
                }
            } catch (e) { }
            checkEmpty();
        });

        function addSpecRow(key = '', value = '') {
            var tbody = document.querySelector('#specsTable tbody');
            var tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="ps-4 py-2 border-bottom">
                    <input type="text" class="spec-input spec-key" placeholder="Tên thông số" value="${key}" oninput="updateSpecsJson()">
                </td>
                <td class="py-2 border-bottom">
                    <input type="text" class="spec-input spec-value" placeholder="Giá trị" value="${value}" oninput="updateSpecsJson()">
                </td>
                <td class="text-center py-2 border-bottom">
                    <button type="button" class="btn btn-link text-danger p-0" onclick="removeSpecRow(this)"><i class="bi bi-x-circle-fill"></i></button>
                </td>
            `;
            tbody.appendChild(tr);
            checkEmpty();
            updateSpecsJson();
        }

        function removeSpecRow(btn) { btn.closest('tr').remove(); checkEmpty(); updateSpecsJson(); }

        function checkEmpty() {
            var count = document.querySelectorAll('#specsTable tbody tr').length;
            document.getElementById('noSpecsMsg').style.display = count === 0 ? 'block' : 'none';
            document.getElementById('specsTable').style.display = count === 0 ? 'none' : 'table';
        }

        function updateSpecsJson() {
            var data = [];
            document.querySelectorAll('#specsTable tbody tr').forEach(row => {
                var key = row.querySelector('.spec-key').value.trim();
                var val = row.querySelector('.spec-value').value.trim();
                if (key && val) data.push({ Key: key, Value: val });
            });
            document.getElementById('specsJson').value = JSON.stringify(data);
        }
    </script>
}