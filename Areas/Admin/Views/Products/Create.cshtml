@model _204Store.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<style>
    :root {
        --primary: #4f46e5;
        --bg-light: #f8fafc;
        --border-color: #e2e8f0;
    }

    body {
        background-color: #f1f5f9;
    }

    .card-modern {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        background: white;
        transition: transform 0.2s;
        overflow: hidden;
    }

    .card-header-modern {
        background: white;
        border-bottom: 1px solid var(--border-color);
        padding: 20px 24px;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-label-custom {
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #64748b;
        margin-bottom: 8px;
    }

    .input-modern {
        background-color: var(--bg-light);
        border: 1px solid transparent;
        border-radius: 10px;
        padding: 12px 15px;
        font-weight: 500;
        transition: all 0.2s;
    }

        .input-modern:focus {
            background-color: white;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

    .upload-zone {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        background: var(--bg-light);
        cursor: pointer;
        transition: all 0.2s;
        position: relative;
    }

        .upload-zone:hover {
            border-color: var(--primary);
            background: #eef2ff;
        }

    .table-specs thead th {
        background: #f8fafc;
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 700;
        border-bottom: 2px solid #e2e8f0;
        padding: 12px 20px;
    }

    .spec-input {
        border: none;
        background: transparent;
        width: 100%;
        padding: 8px;
        font-weight: 500;
    }

        .spec-input:focus {
            outline: none;
            background: #f1f5f9;
            border-radius: 6px;
        }
</style>

<div class="container-xl py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-muted text-decoration-none">Danh sách</a></li>
                    <li class="breadcrumb-item active fw-bold text-primary">Thêm mới</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark m-0">Tạo sản phẩm mới</h3>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-light fw-bold px-4 rounded-pill">Hủy bỏ</a>
            <button type="button" onclick="$('#createForm').submit()" class="btn btn-primary fw-bold px-4 rounded-pill shadow-sm">
                <i class="bi bi-check-lg me-2"></i>Hoàn tất
            </button>
        </div>
    </div>

    <form asp-action="Create" id="createForm" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Specifications" id="specsJson" />

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card-modern mb-4">
                    <div class="card-header-modern">
                        <i class="bi bi-info-circle-fill text-primary"></i> Thông tin chung
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label-custom">Tên sản phẩm <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control input-modern" placeholder="Ví dụ: iPhone 15 Pro Max Titanium..." />
                            <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Description" class="form-label-custom">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control input-modern" rows="8" placeholder="Nhập bài viết mô tả sản phẩm (Hỗ trợ HTML)..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>

                <div class="card-modern">
                    <div class="card-header-modern justify-content-between">
                        <span><i class="bi bi-cpu-fill text-primary"></i> Thông số kỹ thuật</span>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" onclick="addSpecRow()">
                            <i class="bi bi-plus-lg"></i> Thêm dòng
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <table class="table mb-0 table-specs" id="specsTable">
                            <thead>
                                <tr>
                                    <th class="ps-4" style="width: 40%">Tên thông số</th>
                                    <th>Giá trị</th>
                                    <th style="width: 50px" class="text-center">#</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <div id="noSpecsMsg" class="p-5 text-center text-muted">
                            <div class="bg-light rounded-circle d-inline-flex p-3 mb-3">
                                <i class="bi bi-sliders2 fs-3 text-secondary"></i>
                            </div>
                            <p class="mb-1 fw-bold text-dark">Chưa có thông số nào</p>
                            <p class="small text-secondary">Nhấn nút "Thêm dòng" để cấu hình chi tiết kỹ thuật.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card-modern mb-4">
                    <div class="card-header-modern">
                        <i class="bi bi-grid-fill text-primary"></i> Phân loại & Giá
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <label asp-for="CategoryId" class="form-label-custom">Danh mục</label>
                            <select asp-for="CategoryId" class="form-select input-modern" asp-items="ViewBag.CategoryId">
                                <option disabled selected>-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small mt-1"></span>
                        </div>

                        <div class="p-3 bg-light rounded-3 mb-3 border border-light">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="IsFeatured" id="featuredSwitch">
                                <label class="form-check-label fw-bold small text-uppercase text-secondary ms-2" for="featuredSwitch">Sản phẩm nổi bật</label>
                            </div>
                        </div>

                        <div>
                            <label asp-for="DiscountRate" class="form-label-custom">Giảm giá (%)</label>
                            <div class="input-group">
                                <input asp-for="DiscountRate" class="form-control input-modern" type="number" min="0" max="100" placeholder="0" />
                                <span class="input-group-text bg-light border-0 fw-bold">%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-modern">
                    <div class="card-header-modern">
                        <i class="bi bi-images text-primary"></i> Thư viện ảnh
                    </div>
                    <div class="card-body p-4">
                        <label class="form-label-custom">Ảnh đại diện</label>
                        <input type="file" name="file" id="fileInput" class="d-none" accept="image/*" onchange="previewImage(event)" />

                        <div class="upload-zone mb-3" onclick="document.getElementById('fileInput').click()">
                            <img id="imagePreview" src="#" class="img-fluid rounded shadow-sm mb-0" style="max-height: 200px; display: none;" />
                            <div id="placeholderContent">
                                <i class="bi bi-cloud-arrow-up-fill fs-1 text-primary opacity-50"></i>
                                <p class="small fw-bold text-dark mb-1 mt-2">Nhấn để tải ảnh lên</p>
                                <p class="small text-muted mb-0" style="font-size: 0.75rem;">JPG, PNG, WEBP (Max 2MB)</p>
                            </div>
                        </div>

                        <label class="form-label-custom mt-2">Album ảnh phụ</label>
                        <input type="file" name="galleryFiles" class="form-control form-control-sm border-light bg-light" multiple accept="image/*" />
                        <div class="form-text small"><i class="bi bi-info-circle me-1"></i>Giữ phím <b>Ctrl</b> để chọn nhiều ảnh.</div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function(){
                var output = document.getElementById('imagePreview');
                var placeholder = document.getElementById('placeholderContent');
                output.src = reader.result;
                output.style.display = 'block';
                placeholder.style.display = 'none';
            };
            if(event.target.files[0]) reader.readAsDataURL(event.target.files[0]);
        }

        function addSpecRow(key = '', value = '') {
            var tbody = document.querySelector('#specsTable tbody');
            var tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="ps-4 py-2 border-bottom">
                    <input type="text" class="spec-input spec-key" placeholder="VD: Chipset" value="${key}" oninput="updateSpecsJson()">
                </td>
                <td class="py-2 border-bottom">
                    <input type="text" class="spec-input spec-value" placeholder="VD: Apple A17 Pro" value="${value}" oninput="updateSpecsJson()">
                </td>
                <td class="text-center py-2 border-bottom">
                    <button type="button" class="btn btn-link text-danger p-0" onclick="removeSpecRow(this)">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
            checkEmpty();
            updateSpecsJson();
            tr.querySelector('.spec-key').focus();
        }

        function removeSpecRow(btn) {
            btn.closest('tr').remove();
            checkEmpty();
            updateSpecsJson();
        }

        function checkEmpty() {
            var count = document.querySelectorAll('#specsTable tbody tr').length;
            document.getElementById('noSpecsMsg').style.display = count === 0 ? 'block' : 'none';
            document.getElementById('specsTable').style.display = count === 0 ? 'none' : 'table';
        }

        function updateSpecsJson() {
            var data = [];
            document.querySelectorAll('#specsTable tbody tr').forEach(row => {
                var key = row.querySelector('.spec-key').value.trim();
                var val = row.querySelector('.spec-value').value.trim();
                if (key && val) { data.push({ Key: key, Value: val }); }
            });
            document.getElementById('specsJson').value = JSON.stringify(data);
        }

        checkEmpty();
    </script>
}