@model _204Store.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <img src="@Model.ImageUrl" class="rounded-3 shadow-sm mb-3 object-fit-cover"
                         style="width: 100px; height: 100px;" onerror="this.src='https://via.placeholder.com/100'" />
                    <h5 class="fw-bold">@Model.Name</h5>
                    <p class="text-muted small">Danh mục: @Model.Category?.Name</p>
                </div>

                <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger rounded-3 p-3 mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Cảnh báo:</strong> Hành động này sẽ xóa sản phẩm và toàn bộ chi tiết liên quan (Màu, ROM...).
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger fw-bold rounded-3 py-2">Xác nhận xóa</button>
                        <a asp-action="Index" class="btn btn-light fw-bold rounded-3 py-2 text-muted">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>