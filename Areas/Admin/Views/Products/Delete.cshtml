@model _204Store.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="bg-danger p-1"></div>

            <div class="card-body p-5 text-center">
                <div class="mb-4 position-relative">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width: 80px; height: 80px;">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                    </div>
                </div>

                <h4 class="fw-bold mb-2">Xác nhận xóa?</h4>
                <p class="text-muted mb-4">Bạn có chắc chắn muốn xóa sản phẩm này khỏi hệ thống không?</p>

                <div class="bg-light p-3 rounded-3 mb-4 d-flex align-items-center text-start border">
                    <img src="@Model.ImageUrl" class="rounded-3 border object-fit-cover me-3 bg-white"
                         style="width: 60px; height: 60px;" onerror="this.src='https://via.placeholder.com/60'" />
                    <div>
                        <h6 class="fw-bold text-dark mb-1 text-truncate" style="max-width: 200px;">@Model.Name</h6>
                        <small class="text-muted d-block">Danh mục: @Model.Category?.Name</small>
                    </div>
                </div>

                <div class="alert alert-danger py-2 px-3 small rounded-2 mb-4">
                    <i class="bi bi-info-circle me-1"></i> Tất cả biến thể (màu/ROM) của sản phẩm này cũng sẽ bị xóa vĩnh viễn.
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger fw-bold rounded-3 py-3 shadow-sm">
                            Xóa vĩnh viễn
                        </button>
                        <a asp-action="Index" class="btn btn-light fw-bold rounded-3 py-3 text-muted">
                            Hủy bỏ, giữ lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>