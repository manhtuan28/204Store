@using System.Globalization
@model IEnumerable<_204Store.Models.ProductDetail>
@{
    var product = ViewBag.Product as _204Store.Models.Product;
    ViewData["Title"] = $"Biến thể: {product?.Name}";
    var culture = new CultureInfo("vi-VN");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-controller="Products" asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách sản phẩm
        </a>
        <h2 class="fw-bold text-dark mb-1 mt-1">
            Quản lý phiên bản: <span class="text-primary">@product?.Name</span>
        </h2>
        <p class="text-muted mb-0">Thêm màu sắc, cấu hình và số lượng tồn kho</p>
    </div>
    <a asp-action="Create" asp-route-productId="@product?.Id" class="btn btn-primary fw-bold rounded-3 shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Thêm phiên bản mới
    </a>
</div>

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0 table-hover">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 py-3 small fw-bold text-secondary">ID</th>
                    <th class="py-3 small fw-bold text-secondary">Màu sắc</th>
                    <th class="py-3 small fw-bold text-secondary">RAM</th>
                    <th class="py-3 small fw-bold text-secondary">ROM (Bộ nhớ)</th>
                    <th class="py-3 small fw-bold text-secondary">Giá bán</th>
                    <th class="py-3 small fw-bold text-secondary text-center">Tồn kho</th>
                    <th class="pe-4 py-3 small fw-bold text-secondary text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 text-muted">#@item.Id</td>
                        <td>
                            <span class="d-flex align-items-center gap-2">
                                <i class="bi bi-palette2 text-primary"></i> @item.Color
                            </span>
                        </td>
                        <td><span class="badge bg-light text-dark border">@item.Ram</span></td>
                        <td><span class="badge bg-light text-dark border">@item.Rom</span></td>
                        <td class="fw-bold text-success">@item.Price.ToString("#,##0", culture) ₫</td>
                        <td class="text-center">
                            @if (item.Quantity > 0)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">@item.Quantity sẵn sàng</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger">Hết hàng</span>
                            }
                        </td>
                        <td class="pe-4 text-end">
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa phiên bản này?');">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary me-1" title="Sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button type="submit" class="btn btn-sm btn-light text-danger" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
            Chưa có cấu hình nào. Hãy thêm mới!
        </div>
    }
</div>