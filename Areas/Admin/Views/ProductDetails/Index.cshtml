@using System.Globalization
@model IEnumerable<_204Store.Models.ProductDetail>
@{
    var product = ViewBag.Product as _204Store.Models.Product;
    ViewData["Title"] = $"Biến thể: {product?.Name}";
    var culture = new CultureInfo("vi-VN");
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Cấu hình chi tiết</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index" class="text-decoration-none text-muted small">Kho sản phẩm</a></li>
                    <li class="breadcrumb-item active small text-primary fw-bold" aria-current="page">@product?.Name</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Products" asp-action="Index" class="btn btn-light fw-bold rounded-3 text-muted border">
                <i class="bi bi-arrow-return-left me-2"></i>Quay lại
            </a>
            <a asp-action="Create" asp-route-productId="@product?.Id" class="btn btn-primary fw-bold rounded-3 shadow-sm px-4" style="background-color: #4f46e5; border:none;">
                <i class="bi bi-plus-lg me-2"></i>Thêm biến thể
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-success border-4 bg-white" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill text-success fs-5 me-3"></i>
                <span class="text-dark">@TempData["success"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="d-flex align-items-center">
                <img src="@product?.ImageUrl" class="rounded border me-3 object-fit-cover" width="40" height="40" onerror="this.src='https://via.placeholder.com/40'" />
                <div>
                    <h6 class="fw-bold m-0 text-dark">@product?.Name</h6>
                    <small class="text-muted">Tổng số phiên bản: <strong>@Model.Count()</strong></small>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-secondary small fw-bold text-uppercase">Màu sắc</th>
                        <th class="py-3 text-secondary small fw-bold text-uppercase">Cấu hình (RAM/ROM)</th>
                        <th class="py-3 text-secondary small fw-bold text-uppercase">Giá bán</th>
                        <th class="py-3 text-secondary small fw-bold text-uppercase text-center">Trạng thái kho</th>
                        <th class="pe-4 py-3 text-secondary small fw-bold text-uppercase text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle border d-flex align-items-center justify-content-center me-2 bg-light text-muted" style="width: 32px; height: 32px;">
                                        <i class="bi bi-palette-fill"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@item.Color</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-light text-dark border fw-normal">
                                        <i class="bi bi-memory me-1 text-muted"></i>@item.Ram
                                    </span>
                                    <span class="badge bg-light text-dark border fw-normal">
                                        <i class="bi bi-hdd me-1 text-muted"></i>@item.Rom
                                    </span>
                                </div>
                            </td>
                            <td>
                                <span class="fw-bold text-primary" style="font-size: 1rem;">
                                    @item.Price.ToString("#,##0", culture) <small class="text-muted text-decoration-underline">đ</small>
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.Quantity > 0)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                                        <i class="bi bi-check-circle me-1"></i>Còn @item.Quantity
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill">
                                        <i class="bi bi-x-circle me-1"></i>Hết hàng
                                    </span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phiên bản (@item.Color - @item.Ram/@item.Rom) này không?');">
                                    <div class="btn-group shadow-sm rounded-2" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-white border text-primary fw-bold" data-bs-toggle="tooltip" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-white border text-danger fw-bold"
                                           data-bs-toggle="tooltip" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="bi bi-sliders text-muted opacity-25" style="font-size: 3rem;"></i>
                </div>
                <h6 class="text-muted">Chưa có cấu hình nào được thiết lập.</h6>
                <p class="small text-muted mb-4">Hãy tạo các phiên bản (Màu/ROM) để bắt đầu bán hàng.</p>
                <a asp-action="Create" asp-route-productId="@product?.Id" class="btn btn-outline-primary btn-sm rounded-3">
                    Tạo phiên bản đầu tiên
                </a>
            </div>
        }
    </div>
</div>