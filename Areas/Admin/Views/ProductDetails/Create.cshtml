@model _204Store.Models.ProductDetail
@{
    var product = ViewBag.Product as _204Store.Models.Product;
    ViewData["Title"] = "Thêm biến thể mới";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-7">
        <div class="mb-3">
            <a asp-action="Index" asp-route-productId="@product?.Id" class="text-decoration-none text-muted small fw-bold">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách biến thể
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3 text-primary">
                        <i class="bi bi-layers-half fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">Thêm cấu hình mới</h5>
                        <p class="text-muted small mb-0">Sản phẩm: <span class="fw-bold text-dark">@product?.Name</span></p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="ProductId" />

                    <h6 class="text-uppercase text-secondary small fw-bold mb-3"><i class="bi bi-cpu me-2"></i>Thông số kỹ thuật</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label class="form-label fw-semibold small text-secondary">MÀU SẮC</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-palette text-muted"></i></span>
                                <input asp-for="Color" class="form-control bg-light border-0" placeholder="Ví dụ: Titan Tự Nhiên..." />
                            </div>
                            <span asp-validation-for="Color" class="text-danger small ms-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">RAM</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-memory text-muted"></i></span>
                                <input asp-for="Ram" class="form-control bg-light border-0" placeholder="Ví dụ: 8GB" />
                            </div>
                            <span asp-validation-for="Ram" class="text-danger small ms-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">ROM (BỘ NHỚ)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-hdd text-muted"></i></span>
                                <input asp-for="Rom" class="form-control bg-light border-0" placeholder="Ví dụ: 256GB" />
                            </div>
                            <span asp-validation-for="Rom" class="text-danger small ms-1"></span>
                        </div>
                    </div>

                    <hr class="border-light my-4" />

                    <h6 class="text-uppercase text-secondary small fw-bold mb-3"><i class="bi bi-tag me-2"></i>Thông tin bán hàng</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">GIÁ BÁN (VNĐ)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-currency-dollar text-muted"></i></span>

                                <input type="text" class="form-control bg-light border-0 fw-bold text-primary"
                                       id="DisplayPrice"
                                       placeholder="0"
                                       oninput="formatCurrency(this)" />

                                <input asp-for="Price" type="hidden" id="RealPrice" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small ms-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">SỐ LƯỢNG TỒN KHO</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-box-seam text-muted"></i></span>
                                <input asp-for="Quantity" type="number" class="form-control bg-light border-0" value="1" />
                            </div>
                            <span asp-validation-for="Quantity" class="text-danger small ms-1"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-5">
                        <button type="submit" class="btn btn-primary fw-bold py-3 rounded-3 shadow-sm" style="background-color: #4f46e5; border: none;">
                            <i class="bi bi-check-lg me-2"></i>Hoàn tất thêm mới
                        </button>
                        <a asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-light fw-bold py-3 rounded-3 text-muted">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function formatCurrency(input) {
            let value = input.value.replace(/\D/g, '');

            document.getElementById('RealPrice').value = value;

            if (value) {
                input.value = new Intl.NumberFormat('en-US').format(value);
            } else {
                input.value = '';
            }
        }
    </script>
}