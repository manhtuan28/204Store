@model _204Store.Models.ProductDetail
@{
    var product = ViewBag.Product as _204Store.Models.Product;
    ViewData["Title"] = "Thêm biến thể mới";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">Thêm phiên bản cho: <span class="text-primary">@product?.Name</span></h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="ProductId" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold small text-secondary">Màu sắc</label>
                            <input asp-for="Color" class="form-control" placeholder="Ví dụ: Titan Tự Nhiên, Đen..." />
                            <span asp-validation-for="Color" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">RAM</label>
                            <input asp-for="Ram" class="form-control" placeholder="Ví dụ: 8GB" />
                            <span asp-validation-for="Ram" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">ROM (Bộ nhớ trong)</label>
                            <input asp-for="Rom" class="form-control" placeholder="Ví dụ: 256GB" />
                            <span asp-validation-for="Rom" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Giá bán (VNĐ)</label>
                            <input asp-for="Price" type="number" class="form-control" placeholder="Nhập giá..." />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Số lượng tồn kho</label>
                            <input asp-for="Quantity" type="number" class="form-control" value="1" />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4 pt-2">
                        <button type="submit" class="btn btn-primary fw-bold px-4 flex-grow-1">Lưu lại</button>
                        <a asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-light fw-bold px-4 text-muted">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}