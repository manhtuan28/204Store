@model _204Store.Models.ProductDetail
@{
    ViewData["Title"] = "Cập nhật biến thể";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-7">
        <div class="mb-3">
            <a asp-action="Index" asp-route-productId="@Model.ProductId" class="text-decoration-none text-muted small fw-bold">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách biến thể
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 p-2 rounded-3 me-3 text-warning">
                            <i class="bi bi-pencil-square fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">Cập nhật phiên bản</h5>
                            <p class="text-muted small mb-0">Sản phẩm: <span class="fw-bold text-dark">@Model.Product?.Name</span></p>
                        </div>
                    </div>
                    <span class="badge bg-light text-muted border">ID: #@Model.Id</span>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ProductId" />

                    <h6 class="text-uppercase text-secondary small fw-bold mb-3"><i class="bi bi-cpu me-2"></i>Thông số kỹ thuật</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label class="form-label fw-semibold small text-secondary">MÀU SẮC</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-palette-fill text-muted"></i></span>
                                <input asp-for="Color" class="form-control bg-light border-0" />
                            </div>
                            <span asp-validation-for="Color" class="text-danger small ms-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">RAM</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-memory text-muted"></i></span>
                                <input asp-for="Ram" class="form-control bg-light border-0" />
                            </div>
                            <span asp-validation-for="Ram" class="text-danger small ms-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">ROM (BỘ NHỚ)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-hdd-fill text-muted"></i></span>
                                <input asp-for="Rom" class="form-control bg-light border-0" />
                            </div>
                            <span asp-validation-for="Rom" class="text-danger small ms-1"></span>
                        </div>
                    </div>

                    <hr class="border-light my-4" />

                    <h6 class="text-uppercase text-secondary small fw-bold mb-3"><i class="bi bi-tag-fill me-2"></i>Thông tin bán hàng</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">GIÁ BÁN (VNĐ)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-currency-dollar text-muted"></i></span>

                                <input type="text" class="form-control bg-light border-0 fw-bold text-primary"
                                       id="DisplayPrice"
                                       oninput="formatCurrency(this)" />

                                <input asp-for="Price" type="hidden" id="RealPrice" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small ms-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">SỐ LƯỢNG TỒN KHO</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-box-seam-fill text-muted"></i></span>
                                <input asp-for="Quantity" type="number" class="form-control bg-light border-0" />
                            </div>
                            <span asp-validation-for="Quantity" class="text-danger small ms-1"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-5">
                        <button type="submit" class="btn btn-primary fw-bold py-3 rounded-3 shadow-sm" style="background-color: #4f46e5; border: none;">
                            <i class="bi bi-save me-2"></i>Lưu thay đổi
                        </button>
                        <a asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-light fw-bold py-3 rounded-3 text-muted">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function formatCurrency(input) {
            let value = input.value.replace(/\D/g, '');
            document.getElementById('RealPrice').value = value;

            if (value) {
                input.value = new Intl.NumberFormat('en-US').format(value);
            } else {
                input.value = '';
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            var realPrice = document.getElementById('RealPrice').value;
            var displayInput = document.getElementById('DisplayPrice');

            if (realPrice) {
                displayInput.value = realPrice;
                formatCurrency(displayInput);
            }
        });
    </script>
}