@using System.Globalization
@model _204Store.Models.ProductDetail
@{
    ViewData["Title"] = "Xác nhận xóa";
    var culture = new CultureInfo("vi-VN");
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card border-0 shadow rounded-4 overflow-hidden">
            <div class="card-header bg-danger bg-opacity-10 border-0 pt-4 pb-2 text-center">
                <div class="avatar-lg bg-white p-3 rounded-circle shadow-sm d-inline-block mb-3">
                    <i class="bi bi-trash3-fill text-danger fs-1"></i>
                </div>
                <h4 class="fw-bold text-danger mb-1">Xác nhận xóa?</h4>
                <p class="text-muted small">Hành động này không thể hoàn tác!</p>
            </div>

            <div class="card-body p-4">
                <p class="text-center text-muted mb-4">
                    Bạn có chắc chắn muốn xóa phiên bản cấu hình này khỏi hệ thống không?
                </p>

                <div class="bg-light rounded-3 p-3 border d-flex align-items-center mb-4">
                    <img src="@Model.Product?.ImageUrl" class="rounded-3 border me-3 object-fit-cover bg-white"
                         width="60" height="60" onerror="this.src='https://via.placeholder.com/60'" />

                    <div class="flex-grow-1">
                        <h6 class="fw-bold text-dark mb-1">@Model.Product?.Name</h6>
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="badge bg-white text-dark border shadow-sm">
                                <i class="bi bi-palette-fill me-1 text-primary"></i>@Model.Color
                            </span>
                            <span class="badge bg-white text-dark border shadow-sm">
                                @Model.Ram / @Model.Rom
                            </span>
                        </div>
                    </div>

                    <div class="text-end ms-2">
                        <small class="d-block text-muted">Giá bán</small>
                        <span class="fw-bold text-danger">@Model.Price.ToString("#,##0", culture)đ</span>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger fw-bold py-2 rounded-3 shadow-sm">
                            <i class="bi bi-check-lg me-2"></i>Vâng, Xóa nó đi
                        </button>
                        <a asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-light fw-bold py-2 rounded-3 text-muted border">
                            Không, Tôi suy nghĩ lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>