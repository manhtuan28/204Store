@{
    ViewData["Title"] = "Nhập hàng từ Excel";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-file-earmark-spreadsheet me-2"></i>Nhập sản phẩm hàng loạt</h5>
        <a asp-action="DownloadTemplate" class="btn btn-light btn-sm fw-bold">
            <i class="bi bi-download me-1"></i>Tải file mẫu
        </a>
    </div>
    <div class="card-body">

        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger">@TempData["error"]</div>
        }

        <form asp-action="Import" method="post" enctype="multipart/form-data">
            <div class="mb-4 text-center border rounded-3 p-5" style="border: 2px dashed #dee2e6 !important; background: #f8fafc;">
                <i class="bi bi-cloud-upload display-4 text-muted mb-3"></i>
                <h5>Kéo thả hoặc chọn file Excel (.xlsx)</h5>
                <p class="text-muted small">Dữ liệu sẽ được thêm mới hoặc cập nhật số lượng nếu trùng khớp.</p>

                <input type="file" name="file" class="form-control w-50 mx-auto mt-3" accept=".xlsx" required />
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-secondary px-4">Quay lại</a>
                <button type="submit" class="btn btn-primary px-4 fw-bold">
                    <i class="bi bi-upload me-2"></i>Tiến hành Nhập
                </button>
            </div>
        </form>
    </div>
</div>