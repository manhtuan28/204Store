@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">👑 Tổng Quan Hệ Thống</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Chào mừng Admin quay trở lại!</li>
    </ol>

    <div class="row">
        <div class="col-xl-4 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5>Sản Phẩm</h5>
                        <div class="small text-white-50">Quản lý kho hàng</div>
                    </div>
                    <i class="bi bi-box-seam fa-2x"></i>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" asp-area="Admin" asp-controller="Products" asp-action="Index">Xem chi tiết</a>
                    <div class="small text-white"><i class="bi bi-chevron-right"></i></div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5>Danh Mục</h5>
                        <div class="small text-white-50">Phân loại hàng hóa</div>
                    </div>
                    <i class="bi bi-tags fa-2x"></i>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">Xem chi tiết</a>
                    <div class="small text-white"><i class="bi bi-chevron-right"></i></div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5>Đơn Hàng</h5>
                        <div class="small text-white-50">Đơn mới cần xử lý</div>
                    </div>
                    <i class="bi bi-cart-check fa-2x"></i>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="#">Xem chi tiết</a>
                    <div class="small text-white"><i class="bi bi-chevron-right"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>