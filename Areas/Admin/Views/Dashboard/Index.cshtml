@using System.Globalization
@model _204Store.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
    var culture = new CultureInfo("vi-VN");
}

<style>
    .card-stats {
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 20px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .card-stats:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px -5px rgba(0,0,0,0.08);
        }

    .icon-shape {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
    }

    .table-container {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .table thead th {
        background: #f8fafc;
        text-transform: uppercase;
        font-size: 11px;
        font-weight: 700;
        padding: 1.25rem 1rem;
        border-top: none;
    }

    .table tbody td {
        padding: 1.25rem 1rem;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
    }

    .badge-soft {
        font-weight: 600;
        padding: 0.5em 1em;
        border-radius: 8px;
    }

    .badge-soft-success {
        background: #dcfce7;
        color: #166534;
    }

    .badge-soft-warning {
        background: #fef9c3;
        color: #854d0e;
    }

    .badge-soft-danger {
        background: #fee2e2;
        color: #991b1b;
    }

    .badge-soft-secondary {
        background: #f1f5f9;
        color: #475569;
    }
</style>

<div class="row align-items-center mb-4">
    <div class="col">
        <h2 class="fw-bold text-slate-900 mb-1">Tổng quan hệ thống</h2>
        <p class="text-muted mb-0">Dữ liệu cập nhật lúc @DateTime.Now.ToString("HH:mm dd/MM/yyyy")</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card card-stats p-4 bg-white">
            <div class="d-flex align-items-center mb-3">
                <div class="icon-shape bg-primary bg-opacity-10 text-primary me-3">
                    <i class="bi bi-currency-dollar fs-4"></i>
                </div>
                <div>
                    <p class="text-muted small fw-bold mb-0">DOANH THU</p>
                    <h4 class="fw-800 mb-0">@Model.TongDoanhThu.ToString("#,##0", culture) ₫</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card card-stats p-4 bg-white">
            <div class="d-flex align-items-center mb-3">
                <div class="icon-shape bg-success bg-opacity-10 text-success me-3">
                    <i class="bi bi-bag-heart fs-4"></i>
                </div>
                <div>
                    <p class="text-muted small fw-bold mb-0">ĐƠN HÀNG</p>
                    <h4 class="fw-800 mb-0">@Model.TongDonHang.ToString("N0")</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card card-stats p-4 bg-white">
            <div class="d-flex align-items-center mb-3">
                <div class="icon-shape bg-warning bg-opacity-10 text-warning me-3">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
                <div>
                    <p class="text-muted small fw-bold mb-0">SẢN PHẨM</p>
                    <h4 class="fw-800 mb-0">@Model.TongSanPham.ToString("N0")</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card card-stats p-4 bg-white">
            <div class="d-flex align-items-center mb-3">
                <div class="icon-shape bg-info bg-opacity-10 text-info me-3">
                    <i class="bi bi-people fs-4"></i>
                </div>
                <div>
                    <p class="text-muted small fw-bold mb-0">KHÁCH HÀNG</p>
                    <h4 class="fw-800 mb-0">@Model.TongKhachHang.ToString("N0")</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="table-container shadow-sm">
            <div class="p-4 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="fw-bold mb-0">Đơn hàng mới nhất</h5>
                <a href="#" class="btn btn-sm btn-light rounded-2 fw-bold text-primary">Xem tất cả</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DonHangMoiNhat != null && Model.DonHangMoiNhat.Any())
                        {
                            foreach (var item in Model.DonHangMoiNhat)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@item.MaDon</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-light rounded-circle p-2 me-2 text-center fw-bold text-primary" style="width:32px; height:32px; font-size:12px;">
                                                @(string.IsNullOrEmpty(item.TenKhachHang) ? "?" : item.TenKhachHang.Substring(0, 1).ToUpper())
                                            </div>
                                            <span class="fw-600">@(item.TenKhachHang ?? "Khách vãng lai")</span>
                                        </div>
                                    </td>
                                    <td class="text-muted">@item.NgayDat.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold">@item.TongTien.ToString("#,##0", culture) ₫</td>
                                    <td>
                                        @{
                                            string badgeClass = "badge-soft-secondary";
                                            string status = item.TrangThai?.ToLower() ?? "";

                                            if (status.Contains("pending") || status.Contains("chờ")) badgeClass = "badge-soft-warning";
                                            else if (status.Contains("approved") || status.Contains("shipped") || status.Contains("giao")) badgeClass = "badge-soft-success";
                                            else if (status.Contains("cancel") || status.Contains("hủy")) badgeClass = "badge-soft-danger";
                                        }
                                        <span class="badge-soft @badgeClass">@item.TrangThai</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center py-3 text-muted">Chưa có đơn hàng nào</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold mb-4">Sản phẩm bán chạy</h5>

            @if (Model.SanPhamBanChay != null && Model.SanPhamBanChay.Any())
            {
                foreach (var sp in Model.SanPhamBanChay)
                {
                    <div class="d-flex align-items-center mb-4">
                        <img src="@(string.IsNullOrEmpty(sp.HinhAnh) ? "https://via.placeholder.com/50" : sp.HinhAnh)"
                             class="rounded-3 me-3 border" style="width:50px; height:50px; object-fit:cover;" alt="img">

                        <div class="flex-grow-1">
                            <h6 class="mb-0 fw-bold text-truncate" style="max-width: 150px;">@sp.TenSanPham</h6>
                            <small class="text-muted">Đã bán: @sp.SoLuongBan</small>
                        </div>
                        <div class="text-end">
                            <span class="fw-bold text-primary">@sp.GiaBan.ToString("#,##0", culture) ₫</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted">Chưa có dữ liệu bán hàng</div>
            }

            <button class="btn btn-outline-primary w-100 rounded-3 fw-bold py-2 mt-2">Xem báo cáo chi tiết</button>
        </div>
    </div>
</div>