@{
    ViewData["Title"] = "Cấu hình hệ thống";
    string? flashSaleEndTime = ViewBag.FlashSaleEndTime as string;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-gear-fill text-primary me-2"></i>Cấu hình hệ thống</h3>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-6">
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-danger"><i class="bi bi-lightning-charge-fill me-2"></i>Cấu hình Flash Sale</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="SaveFlashSale" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-uppercase text-secondary">Thời gian kết thúc Flash Sale hiện tại</label>
                            <input type="datetime-local" class="form-control form-control-lg bg-light" name="FlashSaleEndTime" 
                                   value="@flashSaleEndTime" required />
                            <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>Chọn ngày giờ mà đồng hồ đếm ngược giao diện trang chủ sẽ đếm lùi về.</div>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                <i class="bi bi-save me-2"></i>Lưu cấu hình
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
