@model IEnumerable<_204Store.Models.Promotion>

@{
    ViewData["Title"] = "Quản lý Mã giảm giá";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Mã giảm giá</h3>
        <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-2"></i>Thêm mã mới</a>
    </div>

    <div class="card shadow-sm rounded-4">
        <div class="card-body p-0">
            <table class="table align-middle table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Mã Code</th>
                        <th>Giảm giá</th>
                        <th>Hiệu lực</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">@item.Code</td>
                            <td>
                                @if (item.DiscountPercent > 0)
                                {
                                    <span class="badge bg-info text-dark">Giảm @item.DiscountPercent%</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Giảm @item.DiscountAmount.ToString("#,##0")đ</span>
                                }
                            </td>
                            <td>
                                <div class="small text-muted">@item.StartDate.ToString("dd/MM/yyyy") -> @item.EndDate.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                @if (item.IsActive && item.EndDate >= DateTime.Now)
                                {
                                    <span class="text-success small fw-bold"><i class="bi bi-check-circle me-1"></i>Đang chạy</span>
                                }
                                else
                                {
                                    <span class="text-secondary small fw-bold"><i class="bi bi-x-circle me-1"></i>Hết hạn/Tắt</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning border-0 me-1">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0" onclick="return confirm('Xóa mã này?')">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>