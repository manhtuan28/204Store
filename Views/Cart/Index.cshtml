@model IEnumerable<_204Store.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    decimal totalAmount = Model.Sum(item => item.Quantity * (decimal)item.ProductDetail.Price);
}

<style>
    :root {
        --primary-color: #4f46e5;
        --text-dark: #1e293b;
        --bg-light: #f8fafc;
    }

    body {
        background-color: var(--bg-light);
    }

    .cart-table thead th {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        font-weight: 600;
        background-color: #fff;
        border-bottom: 2px solid #f1f5f9;
    }

    .cart-item-row td {
        vertical-align: middle;
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
    }

    .product-img-box {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        background-color: #fff;
        border: 1px solid #f1f5f9;
        padding: 5px;
        overflow: hidden;
    }

        .product-img-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .qty-input {
        width: 60px;
        text-align: center;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-weight: 600;
        color: var(--text-dark);
        transition: all 0.2s;
    }

        .qty-input:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
            outline: none;
        }

    .summary-card {
        position: sticky;
        top: 100px;
        background: white;
        border-radius: 16px;
        border: 1px solid #f1f5f9;
    }

    .btn-checkout {
        background-color: var(--primary-color);
        border: none;
        transition: 0.2s;
    }

        .btn-checkout:hover {
            background-color: #4338ca;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }

    .remove-btn {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ef4444;
        background-color: #fef2f2;
        transition: 0.2s;
        text-decoration: none;
    }

        .remove-btn:hover {
            background-color: #ef4444;
            color: white;
        }
</style>

<div class="container py-5">
    <div class="d-flex align-items-center mb-4">
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-bag-check-fill me-2 text-primary"></i>Giỏ hàng</h2>
        <span class="badge bg-primary bg-opacity-10 text-primary ms-3 rounded-pill px-3">@Model.Count() sản phẩm</span>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body">
                <div class="mb-4">
                    <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 120px; height: 120px;">
                        <i class="bi bi-cart-x text-muted opacity-50" style="font-size: 3rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold text-dark">Giỏ hàng của bạn đang trống</h4>
                <p class="text-muted mb-4">Có vẻ như bạn chưa thêm sản phẩm nào vào giỏ hàng.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại mua sắm
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table cart-table mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4 py-3">Sản phẩm</th>
                                    <th class="py-3">Đơn giá</th>
                                    <th class="py-3 text-center">Số lượng</th>
                                    <th class="py-3 text-end pe-4">Thành tiền</th>
                                    <th class="py-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr class="cart-item-row bg-white">
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="product-img-box me-3 flex-shrink-0 shadow-sm">
                                                    <img src="@item.ProductDetail.Product.ImageUrl" alt="@item.ProductDetail.Product.Name" onerror="this.src='https://placehold.co/100x100?text=No+Img'">
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-1">
                                                        <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.ProductDetail.ProductId" class="text-decoration-none text-dark">
                                                            @item.ProductDetail.Product.Name
                                                        </a>
                                                    </h6>
                                                    <div class="small text-muted d-flex align-items-center gap-2">
                                                        <span class="badge bg-light text-secondary border">@item.ProductDetail.Color</span>
                                                        <span>@item.ProductDetail.Ram / @item.ProductDetail.Rom</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-muted fw-medium">
                                            @item.ProductDetail.Price.ToString("N0")₫
                                        </td>
                                        <td class="text-center">
                                            <form asp-action="UpdateQuantity" method="post" class="d-inline-block">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="1"
                                                       class="form-control qty-input form-control-sm"
                                                       onchange="this.form.submit()">
                                            </form>
                                        </td>
                                        <td class="text-end fw-bold text-primary pe-4">
                                            @((item.Quantity * item.ProductDetail.Price).ToString("N0"))₫
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-action="Remove" asp-route-id="@item.Id" class="remove-btn ms-auto" title="Xóa khỏi giỏ">
                                                <i class="bi bi-trash3-fill fs-6"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted fw-bold small hover-link">
                        <i class="bi bi-arrow-left me-1"></i> Tiếp tục xem sản phẩm
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="summary-card p-4 shadow-sm">
                    <h5 class="fw-bold mb-4">Cộng giỏ hàng</h5>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-bold text-dark">@totalAmount.ToString("N0")₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span class="text-success fw-bold">Miễn phí <i class="bi bi-check-circle-fill ms-1"></i></span>
                    </div>

                    <div class="input-group mb-4">
                        <input type="text" class="form-control bg-light border-0" placeholder="Mã giảm giá">
                        <button class="btn btn-outline-secondary border-0 bg-light fw-bold text-primary" type="button">Áp dụng</button>
                    </div>

                    <hr class="border-secondary opacity-10 my-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold text-dark">Tổng cộng:</span>
                        <div class="text-end">
                            <span class="fs-4 fw-bold text-primary">@totalAmount.ToString("N0")₫</span>
                            <small class="d-block text-muted" style="font-size: 0.8rem;">(Đã bao gồm VAT)</small>
                        </div>
                    </div>

                    <a href="#" class="btn btn-checkout w-100 rounded-pill py-3 text-white fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                        <span>TIẾN HÀNH THANH TOÁN</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <div class="text-center mt-3">
                        <small class="text-muted"><i class="bi bi-shield-lock-fill me-1"></i>Thanh toán bảo mật 100%</small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>