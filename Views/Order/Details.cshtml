@model _204Store.Models.OrderHeader
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<style>
    :root {
        --primary: #4f46e5;
        --text-dark: #0f172a;
        --text-gray: #64748b;
        --bg-light: #f8fafc;
    }

    body {
        background-color: #f9fafb;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .status-badge {
        padding: 8px 16px;
        border-radius: 30px;
        font-weight: 600;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }
    .status-pending {
        background: #fff7ed;
        color: #ea580c;
        border: 1px solid #fdba74;
    }
    .status-processing {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #93c5fd;
    }
    .status-shipped {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #86efac;
    }
    .status-completed {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #6ee7b7;
    }
    .status-cancelled {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fca5a5;
    }
    .status-return {
        background: #fefce8;
        color: #ca8a04;
        border: 1px solid #fde047;
    }
    .status-refunded {
        background: #f3e8ff;
        color: #7e22ce;
        border: 1px solid #d8b4fe;
    }
    .card-detail {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 10px -2px rgba(0,0,0,0.05);
        background: white;
        overflow: hidden;
        height: 100%;
        transition: transform 0.2s;
    }

    .card-detail-header {
        background: #f8fafc;
        padding: 16px 24px;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 700;
        color: #334155;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #94a3b8;
        margin-bottom: 4px;
        letter-spacing: 0.5px;
    }

    .info-value {
        font-weight: 600;
        color: var(--text-dark);
        font-size: 1rem;
    }

    .table-custom th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        color: #64748b;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 12px;
    }

    .table-custom td {
        padding: 16px 12px;
        vertical-align: middle;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
    }

    .product-img {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid #e2e8f0;
    }

    .alert-custom {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
</style>

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <a asp-controller="Order" asp-action="Index" class="text-decoration-none text-muted fw-bold small mb-2 d-inline-block hover-primary">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
            </a>
            <div class="d-flex align-items-baseline gap-2">
                <h2 class="fw-bold mb-0 text-dark">Đơn hàng <span class="text-primary">#@Model.Id</span></h2>
            </div>
            <div class="text-muted small mt-1"><i class="bi bi-clock me-1"></i>Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (Model.PaymentStatus != "Approved" && Model.OrderStatus != "Cancelled" && Model.OrderStatus != "Completed" && Model.OrderStatus != "Refunded" && Model.OrderStatus != "ReturnRequested")
            {
                <button type="button" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#repayModal">
                    <i class="bi bi-credit-card-2-front-fill me-2"></i>Thanh toán ngay
                </button>
            }

            @if (Model.OrderStatus == "Pending")
            {
                <form asp-action="CancelOrder" method="post" onsubmit="return confirm('Bạn có chắc muốn hủy đơn này không?');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger fw-bold rounded-pill px-4 bg-white">
                        <i class="bi bi-x-circle me-2"></i>Hủy đơn
                    </button>
                </form>
            }

            @if (Model.OrderStatus == "Completed")
            {
                if (Model.ReturnAttempts < 2)
                {
                    <button type="button" class="btn btn-warning fw-bold rounded-pill px-4 text-dark" data-bs-toggle="modal" data-bs-target="#returnModal">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Yêu cầu trả hàng (@(2 - Model.ReturnAttempts) lượt còn lại)
                    </button>
                }
                else
                {
                    <div class="alert alert-secondary border-0 shadow-sm d-inline-block px-4 py-2 rounded-pill mb-0">
                        <i class="bi bi-lock-fill me-2"></i>Bạn đã hết lượt yêu cầu trả hàng
                    </div>
                }
            }

            @if (Model.OrderStatus == "Completed" && Model.ReturnAttempts > 0)
            {
                <div class="mt-2 text-danger small fst-italic">
                    * Bạn đã sử dụng @Model.ReturnAttempts/2 lần yêu cầu trả hàng.
                </div>
            }
        </div>
    </div>

    @if (Model.OrderStatus == "ReturnRequested")
    {
        <div class="alert alert-warning alert-custom d-flex align-items-center mb-4">
            <i class="bi bi-hourglass-split fs-3 me-3"></i>
            <div>
                <h6 class="fw-bold mb-0">Yêu cầu trả hàng đang được xử lý</h6>
                <div class="small">Lý do: "@Model.ReturnReason". Vui lòng chờ phản hồi từ quản trị viên.</div>
            </div>
        </div>
    }
    @if (Model.OrderStatus == "Refunded")
    {
        <div class="alert alert-success alert-custom d-flex align-items-center mb-4">
            <i class="bi bi-check-circle-fill fs-3 me-3"></i>
            <div>
                <h6 class="fw-bold mb-0">Đơn hàng đã được hoàn tiền</h6>
                <div class="small">Yêu cầu trả hàng của bạn đã được chấp thuận và xử lý thành công.</div>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card-detail">
                <div class="card-detail-header">
                    <i class="bi bi-person-lines-fill text-primary"></i>Thông tin nhận hàng
                </div>
                <div class="p-4">
                    <div class="mb-4">
                        <div class="info-label">Người nhận</div>
                        <div class="info-value">@Model.Name</div>
                    </div>
                    <div class="mb-4">
                        <div class="info-label">Số điện thoại</div>
                        <div class="info-value">@Model.PhoneNumber</div>
                    </div>
                    <div class="mb-4">
                        <div class="info-label">Địa chỉ</div>
                        <div class="info-value">@Model.StreetAddress</div>
                        <div class="small text-muted">@Model.City</div>
                    </div>

                    <div class="mb-4">
                        <div class="info-label">Ghi chú giao hàng</div>
                        @if (!string.IsNullOrEmpty(Model.OrderNotes))
                        {
                            <div class="info-value text-break fst-italic" style="background: #fffbeb; padding: 10px; border-radius: 8px; border: 1px dashed #fcd34d;">
                                "@Model.OrderNotes"
                            </div>
                        }
                        else
                        {
                            <div class="small text-muted">Không có ghi chú.</div>
                        }
                    </div>

                    <hr class="my-4 border-light" />

                    <div class="mb-4">
                        <div class="info-label">Trạng thái đơn hàng</div>
                        <div class="mt-2">
                            @switch (Model.OrderStatus)
                            {
                                case "Pending":
                                    <span class="status-badge status-pending"><i class="bi bi-hourglass-split"></i> Chờ xác nhận</span>
                                    ; break;
                                case "Processing":

                                    <span class="status-badge status-processing"><i class="bi bi-gear-wide-connected"></i> Đang xử lý</span>
                                    ; break;
                                case "Shipped":

                                    <span class="status-badge status-shipped"><i class="bi bi-truck"></i> Đang giao hàng</span>
                                    ; break;
                                case "Completed":

                                    <span class="status-badge status-completed"><i class="bi bi-check-circle-fill"></i> Hoàn thành</span>
                                    ; break;
                                case "Cancelled":

                                    <span class="status-badge status-cancelled"><i class="bi bi-x-circle-fill"></i> Đã hủy</span>
                                    ; break;
                                case "ReturnRequested":

                                    <span class="status-badge status-return"><i class="bi bi-arrow-return-left"></i> Yêu cầu trả hàng</span>
                                    ; break;
                                case "Refunded":

                                    <span class="status-badge status-refunded"><i class="bi bi-wallet2"></i> Đã hoàn tiền</span>
                                    ; break;
                                default:

                                    <span class="badge bg-secondary">@Model.OrderStatus</span>
                                    ; break;
                            }
                        </div>
                    </div>

                    <div>
                        <div class="info-label">Thanh toán</div>
                        <div class="mt-2">
                            @if (Model.PaymentStatus == "Approved")
                            {
                                <div class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán</div>
                            }
                            else if (Model.PaymentStatus == "Refunded")
                            {
                                <div class="text-primary fw-bold"><i class="bi bi-arrow-return-left me-1"></i>Đã hoàn tiền</div>
                            }
                            else
                            {
                                <div class="text-dark fw-bold"><i class="bi bi-cash-coin me-1"></i>Thanh toán khi nhận hàng (COD)</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card-detail">
                <div class="card-detail-header">
                    <i class="bi bi-bag-check-fill text-primary"></i>Sản phẩm đã mua
                </div>
                <div class="table-responsive">
                    <table class="table mb-0 align-middle table-custom">
                        <thead>
                            <tr>
                                <th class="ps-4">Sản phẩm</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">SL</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <img src="@item.ProductDetail.Product.ImageUrl" class="product-img me-3" onerror="this.src='https://placehold.co/60'" />
                                            <div>
                                                <div class="fw-bold text-dark">@item.ProductDetail.Product.Name</div>
                                                <div class="small badge bg-light text-secondary border fw-normal mt-1">
                                                    @item.ProductDetail.Color / @item.ProductDetail.Rom
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">@item.Price.ToString("#,##0")₫</td>
                                    <td class="text-center text-muted">x @item.Count</td>
                                    <td class="text-end pe-4 fw-bold">@((item.Price * item.Count).ToString("#,##0") + "₫")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-light">
                            <tr>
                                <td colspan="3" class="text-end py-3 text-muted small text-uppercase fw-bold">Phí vận chuyển:</td>
                                <td class="text-end pe-4 py-3 text-success fw-bold">Miễn phí</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end py-3 fw-bold fs-5 text-dark border-0">Tổng thanh toán:</td>
                                <td class="text-end pe-4 py-3 fw-bold fs-4 text-primary border-0">@Model.OrderTotal.ToString("#,##0")₫</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-arrow-counterclockwise me-2 text-warning"></i>Yêu cầu Trả hàng / Hoàn tiền</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RequestReturn" method="post">
                <div class="modal-body pt-3">
                    <p class="text-muted small">Chúng tôi rất tiếc vì sự bất tiện này. Vui lòng cho biết lý do bạn muốn trả hàng để chúng tôi hỗ trợ tốt nhất.</p>
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-secondary">Lý do trả hàng <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control bg-light border-0" rows="4" placeholder="Ví dụ: Sản phẩm bị lỗi, giao sai màu, bể vỡ..." style="border-radius: 12px;" required></textarea>
                    </div>

                    <div class="alert alert-light border border-dashed small mb-0">
                        <i class="bi bi-info-circle-fill text-info me-1"></i>
                        Yêu cầu sẽ được xử lý trong vòng <strong>24h</strong>. Nhân viên sẽ liên hệ lại qua số điện thoại của bạn.
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-4 shadow-sm">Gửi yêu cầu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="repayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-dark">Chọn phương thức thanh toán</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Checkout" asp-action="Repay" method="post">
                <div class="modal-body pt-0">
                    <input type="hidden" name="orderId" value="@Model.Id" />

                    <p class="text-muted small mb-3">Vui lòng chọn một trong các cổng thanh toán dưới đây để hoàn tất đơn hàng.</p>

                    <div class="d-flex flex-column gap-3">
                        <div class="position-relative">
                            <input class="form-check-input position-absolute top-50 start-0 translate-middle-y ms-3" type="radio" name="paymentMethod" id="repayVnpay" value="VNPAY" checked>
                            <label class="d-flex align-items-center p-3 border rounded-3 w-100 ps-5 cursor-pointer" for="repayVnpay" style="cursor:pointer;">
                                <div class="me-3">
                                    <img src="https://vnpay.vn/assets/images/logo-icon/logo-primary.svg" height="35" alt="VNPay">
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Ví VNPAY / Ngân hàng</div>
                                    <div class="small text-muted" style="font-size: 0.8rem;">Quét mã QR hoặc thẻ ATM/Visa</div>
                                </div>
                            </label>
                        </div>

                        <div class="position-relative">
                            <input class="form-check-input position-absolute top-50 start-0 translate-middle-y ms-3" type="radio" name="paymentMethod" id="repayMomo" value="MOMO">
                            <label class="d-flex align-items-center p-3 border rounded-3 w-100 ps-5 cursor-pointer" for="repayMomo" style="cursor:pointer;">
                                <div class="me-3">
                                    <img src="https://i.ibb.co/GvLyg5Pz/MOMO-Logo-App.png" height="35" width="35" style="object-fit: contain;" alt="MoMo">
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Ví MoMo</div>
                                    <div class="small text-muted" style="font-size: 0.8rem;">Quét mã QR qua ứng dụng MoMo</div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-2">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm">Tiến hành thanh toán</button>
                </div>
            </form>
        </div>
    </div>
</div>