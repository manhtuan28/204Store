@model IEnumerable<_204Store.Models.OrderHeader>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<style>
    :root {
        --primary: #4f46e5;
        --bg-light: #f8fafc;
        --text-dark: #0f172a;
        --text-gray: #64748b;
    }

    body {
        background-color: #f9fafb;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .card-history {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        background: white;
        overflow: hidden;
    }

    .table-custom {
        margin-bottom: 0;
    }

        .table-custom thead th {
            background-color: #f8fafc;
            color: #64748b;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.75rem;
            padding: 18px 24px;
            border-bottom: 1px solid #e2e8f0;
            letter-spacing: 0.05em;
        }

        .table-custom tbody tr {
            transition: background-color 0.2s ease;
        }

            .table-custom tbody tr:hover {
                background-color: #fbfbfb;
            }

        .table-custom tbody td {
            padding: 20px 24px;
            vertical-align: middle;
            color: #334155;
            border-bottom: 1px solid #f1f5f9;
            font-size: 0.95rem;
        }

    .status-badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .status-pending {
        background: #fff7ed;
        color: #ea580c;
        border: 1px solid #fdba74;
    }
    .status-approved {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #93c5fd;
    }
    .status-shipped {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #86efac;
    }
    .status-completed {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #6ee7b7;
    }
    .status-cancelled {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fca5a5;
    }
    .status-return {
        background: #fefce8;
        color: #ca8a04;
        border: 1px solid #fde047;
    }
    .status-refunded {
        background: #f3e8ff;
        color: #7e22ce;
        border: 1px solid #d8b4fe;
    }

    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: white;
        border: 1px solid #e2e8f0;
        color: var(--primary);
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 10px;
        transition: all 0.2s;
        text-decoration: none;
        font-size: 0.85rem;
    }

        .btn-action:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
            transform: translateY(-1px);
            box-shadow: 0 4px 6px -2px rgba(79, 70, 229, 0.2);
        }

    .empty-state-icon {
        width: 80px;
        height: 80px;
        background: #f1f5f9;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        color: #94a3b8;
    }
</style>

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h2 class="fw-bold text-dark m-0">Lịch sử đơn hàng</h2>
            <p class="text-muted m-0 mt-1">Quản lý và theo dõi trạng thái các đơn hàng của bạn.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-flex align-items-center gap-2 w-auto align-self-start align-self-md-center">
            <i class="bi bi-bag-plus-fill"></i> Mua sắm ngay
        </a>
    </div>

    <div class="card-history">
        <div class="table-responsive">
            <table class="table table-custom mb-0 w-100">
                <thead>
                    <tr>
                        <th class="ps-4">Mã đơn hàng</th>
                        <th>Ngày đặt</th>
                        <th>Người nhận</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-primary font-monospace">#@item.Id</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-medium">@item.OrderDate.ToString("dd/MM/yyyy")</span>
                                    <div class="small text-muted">@item.OrderDate.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@item.PhoneNumber</div>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@item.OrderTotal.ToString("#,##0")₫</span>
                                </td>
                                <td>
                                    @switch (item.OrderStatus)
                                    {
                                        case "Pending":
                                            <span class="status-badge status-pending"><i class="bi bi-hourglass-split"></i> Chờ xác nhận</span>
                                            ; break;
                                        case "Approved":
                                            <span class="status-badge status-approved"><i class="bi bi-check2-circle"></i> Đã xác nhận</span>
                                            ; break;
                                        case "Processing":
                                            <span class="status-badge status-approved"><i class="bi bi-gear-wide-connected"></i> Đang xử lý</span>
                                            ; break;
                                        case "Shipped":
                                            <span class="status-badge status-shipped"><i class="bi bi-truck"></i> Đang giao</span>
                                            ; break;
                                        case "Completed":
                                            <span class="status-badge status-completed"><i class="bi bi-check-circle-fill"></i> Hoàn thành</span>
                                            ; break;
                                        case "Cancelled":
                                            <span class="status-badge status-cancelled"><i class="bi bi-x-circle"></i> Đã hủy</span>
                                            ; break;
                                        case "ReturnRequested":
                                            <span class="status-badge status-return"><i class="bi bi-arrow-return-left"></i> Yêu cầu trả hàng</span>
                                            ; break;
                                        case "Refunded":
                                            <span class="status-badge status-refunded"><i class="bi bi-wallet2"></i> Đã hoàn tiền</span>
                                            ; break;
                                        default:
                                            <span class="status-badge bg-light text-dark border">@item.OrderStatus</span>
                                            ; break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-orderId="@item.Id" class="btn-action">
                                        Chi tiết <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="empty-state-icon">
                                    <i class="bi bi-inbox fs-1"></i>
                                </div>
                                <h5 class="fw-bold text-dark mb-2">Bạn chưa có đơn hàng nào</h5>
                                <p class="text-muted mb-4">Hãy dạo một vòng cửa hàng và chọn cho mình món đồ ưng ý nhé!</p>
                                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                                    Về trang chủ
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>