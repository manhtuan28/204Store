@using Microsoft.AspNetCore.Identity
@using _204Store.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var displayName = user?.FullName ?? User.Identity?.Name;
    var avatarInitial = displayName?.Substring(0, 1).ToUpper() ?? "U";

    <li class="nav-item dropdown ms-lg-3">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 py-1" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                 style="width: 35px; height: 35px; background: linear-gradient(135deg, #6366f1, #4f46e5);">
                @avatarInitial
            </div>
            <div class="d-none d-lg-block text-start">
                <span class="d-block text-dark fw-semibold small" style="line-height: 1;">Xin chào,</span>
                <span class="d-block text-muted" style="font-size: 0.75rem; max-width: 100px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    @User.Identity?.Name
                </span>
            </div>
        </a>

        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2 animate-slide-in" aria-labelledby="userDropdown" style="min-width: 220px;">
            <li class="px-3 py-2 border-bottom mb-2">
                <p class="mb-0 fw-bold text-dark text-truncate">@User.Identity?.Name</p>
                <small class="text-muted">Thành viên thân thiết</small>
            </li>

            <li>
                <a class="dropdown-item py-2" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="bi bi-person-gear me-2 text-primary"></i>Quản lý tài khoản
                </a>
            </li>
            <li>
                <a class="dropdown-item py-2" href="#">
                    <i class="bi bi-bag-check me-2 text-success"></i>Đơn hàng của tôi
                </a>
            </li>

            <li><hr class="dropdown-divider my-2"></li>

            <li>
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item py-2 text-danger fw-semibold">
                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item d-flex align-items-center gap-2 ms-lg-3">
        <a class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" asp-area="Identity" asp-page="/Account/Register">
            Đăng ký
        </a>

        <a class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold shadow-sm" asp-area="Identity" asp-page="/Account/Login" style="background-color: #4f46e5; border-color: #4f46e5;">
            Đăng nhập
        </a>
    </li>
}