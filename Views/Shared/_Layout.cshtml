    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.getElementById('newsletterForm').addEventListener('submit', function(e) {
                e.preventDefault();

                var email = document.getElementById('newsletterEmail').value;
                var btn = document.getElementById('btnSubscribe');

                Swal.fire({
                    title: 'Đang gửi yêu cầu...',
                    text: 'Vui lòng chờ trong giây lát',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                fetch('/Home/Subscribe', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'email=' + encodeURIComponent(email)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            title: 'Đăng ký thành công! 🎉',
                            text: 'Chúng tôi đã gửi một món quà nhỏ vào email của bạn. Hãy kiểm tra ngay nhé!',
                            icon: 'success',
                            confirmButtonText: 'Tuyệt vời',
                            confirmButtonColor: '#0d6efd',
                            backdrop: `
                                rgba(0,0,123,0.4)
                                url("/images/confetti.gif")
                                left top
                                no-repeat
                            `
                        });

                        document.getElementById('newsletterEmail').value = '';
                    } else {
                        Swal.fire({
                            title: 'Rất tiếc!',
                            text: data.message,
                            icon: 'warning',
                            confirmButtonText: 'Đã hiểu',
                            confirmButtonColor: '#ffc107'
                        });
                    }
                })
                .catch(error => {
                    Swal.fire({
                        title: 'Lỗi hệ thống',
                        text: 'Không thể kết nối đến máy chủ.',
                        icon: 'error',
                        confirmButtonText: 'Thử lại'
                    });
                });
            });

                $(document).ready(function() {
            let timeout = null;
            const $results = $('#search-results');
            const $list = $('#search-list');
            const $input = $('#keyword');

            const formatMoney = (amount) => {
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
            };

            $input.on('keyup', function() {
                clearTimeout(timeout);
                const query = $(this).val().trim();

                if (query.length < 2) {
                    $results.addClass('d-none');
                    return;
                }

                timeout = setTimeout(function() {
                    $.ajax({
                        url: '/Home/SearchLive',
                        data: { query: query },
                        success: function(data) {
                            $list.empty();

                            if (data.length > 0) {
                                $('#view-all-btn').attr('href', '/Home/Search?query=' + encodeURIComponent(query));

                                data.forEach(item => {
                                    const html = `
                                        <a href="/Home/Details?productId=${item.id}" class="list-group-item list-group-item-action d-flex align-items-center search-item p-2">
                                            <img src="${item.image}" class="search-img me-3" alt="${item.name}">
                                            <div>
                                                <div class="fw-bold text-dark small">${item.name}</div>
                                                <div class="text-danger small fw-bold">${formatMoney(item.price)}</div>
                                            </div>
                                        </a>
                                    `;
                                    $list.append(html);
                                });
                                $results.removeClass('d-none');
                            } else {
                                $list.html('<div class="p-3 text-center text-muted small">Không tìm thấy sản phẩm nào.</div>');
                                $results.removeClass('d-none');
                            }
                        }
                    });
                }, 300);
            });

            $(document).on('click', function(e) {
                if (!$(e.target).closest('.search-container').length) {
                    $results.addClass('d-none');
                }
            });

            $input.on('focus', function() {
                if ($(this).val().length >= 2) {
                    $results.removeClass('d-none');
                }
            });
        });
    </script>
</body>
</html>