@using Microsoft.AspNetCore.Identity
@using _204Store.Models
@using _204Store.Data
@using Microsoft.EntityFrameworkCore

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Context

@{
    int cartCount = 0;
    if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            cartCount = Context.CartItems.Where(c => c.UserId == user.Id).Sum(c => c.Quantity);
        }
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 204Store</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #4f46e5;
            --primary-hover: #4338ca;
            --text-dark: #1e293b;
            --text-gray: #64748b;
            --bg-body: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-dark);
            line-height: 1.6;
        }

        .navbar.sticky-top {
            background-color: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        }

        .brand-logo {
            font-weight: 800;
            color: var(--primary-color) !important;
        }

        .nav-link {
            font-weight: 600;
            color: #475569 !important;
        }

            .nav-link:hover, .nav-link.active {
                color: var(--primary-color) !important;
                background-color: rgba(79, 70, 229, 0.08);
                border-radius: 8px;
            }

        .btn-cart {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            border: 1px solid #e2e8f0;
            border-radius: 50rem;
            background-color: #fff;
            color: var(--text-dark);
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .btn-cart:hover {
                border-color: var(--primary-color);
                color: var(--primary-color);
                background-color: #f8fafc;
            }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -10px;
            background-color: #ef4444;
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            min-width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
        }

        footer {
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            color: #475569;
        }

        .footer-heading {
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 1.2rem;
        }

        .footer-link {
            color: #64748b;
            text-decoration: none;
            display: block;
            margin-bottom: 0.6rem;
        }

            .footer-link:hover {
                color: var(--primary-color);
                transform: translateX(5px);
            }

        .social-btn {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #f1f5f9;
            color: var(--text-gray);
            margin-right: 8px;
            text-decoration: none;
        }

            .social-btn:hover {
                color: #fff;
                background-color: var(--primary-color);
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 me-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;"><i class="bi bi-box-seam-fill fs-5"></i></span>
                    <span class="brand-logo fs-3">204Store</span>
                </a>
                <button class="navbar-toggler border-0 p-2 bg-light rounded-circle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <div class="flex-grow-1 mx-lg-4 my-3 my-lg-0">
                        <form class="w-100" style="max-width: 500px;" asp-controller="Home" asp-action="Search" method="get">
                            <input class="form-control rounded-pill ps-4" name="query" type="search" placeholder="Bạn muốn tìm gì hôm nay?..." aria-label="Search" style="background-color: #f1f5f9; border:none; height: 42px;">
                        </form>
                    </div>
                    <ul class="navbar-nav align-items-lg-center gap-2">
                        <li class="nav-item"><a class="nav-link active" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Danh mục</a>
                            <ul class="dropdown-menu shadow-lg border-0 rounded-4 mt-3 p-3">
                                <li><a class="dropdown-item rounded-3 py-2" href="#"><i class="bi bi-phone me-2"></i>Điện thoại</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" href="#"><i class="bi bi-laptop me-2"></i>Laptop</a></li>
                            </ul>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-sm text-danger bg-danger bg-opacity-10 rounded-pill px-3 fw-bold"><i class="bi bi-shield-lock me-2"></i>Quản trị</a></li>
                        }
                        <li class="nav-item border-start ps-lg-3 ms-lg-2"><partial name="_LoginPartial" /></li>
                        <li class="nav-item ms-lg-3 mt-3 mt-lg-0">
                            <a class="btn-cart" asp-area="" asp-controller="Cart" asp-action="Index">
                                <div class="position-relative d-flex align-items-center">
                                    <i class="bi bi-bag-dash fs-5"></i>
                                    <span id="cart-badge" class="cart-badge @(cartCount > 0 ? "" : "d-none")">
                                        @cartCount
                                    </span>
                                </div>
                                <span class="fw-bold d-none d-xl-inline">Giỏ hàng</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 py-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4"><a href="#" class="text-decoration-none"><span class="brand-logo fs-3">204Store</span></a><p class="text-muted mt-3">Hệ thống bán lẻ uy tín.</p></div>
                <div class="col-lg-2"><h5 class="footer-heading">Chính sách</h5><ul class="list-unstyled"><li><a href="#" class="footer-link">Bảo hành</a></li><li><a href="#" class="footer-link">Đổi trả</a></li></ul></div>
                <div class="col-lg-2"><h5 class="footer-heading">Hỗ trợ</h5><ul class="list-unstyled"><li><a href="#" class="footer-link">Tra cứu đơn</a></li><li><a href="#" class="footer-link">Tư vấn</a></li></ul></div>
                <div class="col-lg-4"><h5 class="footer-heading">Tổng đài</h5><strong class="fs-5 text-dark">1800.2044</strong></div>
            </div>
            <div class="border-top pt-4 mt-4 text-center text-muted"><small>&copy; 2026 204Store. All rights reserved.</small></div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>