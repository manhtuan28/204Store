@using Microsoft.AspNetCore.Identity
@using _204Store.Models
@using _204Store.Data
@using Microsoft.EntityFrameworkCore

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Context

@{
    int cartCount = 0;
    if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            cartCount = Context.CartItems.Where(c => c.UserId == user.Id).Sum(c => c.Quantity);
        }
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 204Store</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #4f46e5;
            --primary-hover: #4338ca;
            --text-dark: #1e293b;
            --text-gray: #64748b;
            --bg-body: #f8fafc;
            --footer-bg: #0f172a;
            --footer-text: #94a3b8;
            --footer-heading: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-dark);
            line-height: 1.6;
        }

        .navbar.sticky-top {
            background-color: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        }

        .brand-logo {
            font-weight: 800;
            color: var(--primary-color) !important;
        }

        .nav-link {
            font-weight: 600;
            color: #475569 !important;
        }

            .nav-link:hover, .nav-link.active {
                color: var(--primary-color) !important;
                background-color: rgba(79, 70, 229, 0.08);
                border-radius: 8px;
            }

        .btn-cart {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            border: 1px solid #e2e8f0;
            border-radius: 50rem;
            background-color: #fff;
            color: var(--text-dark);
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .btn-cart:hover {
                border-color: var(--primary-color);
                color: var(--primary-color);
                background-color: #f8fafc;
            }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -10px;
            background-color: #ef4444;
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            min-width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
        }

        footer {
            background-color: var(--footer-bg);
            color: var(--footer-text);
            font-size: 0.9rem;
            padding-top: 4rem;
            margin-top: auto;
        }

        .footer-heading {
            color: var(--footer-heading);
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .footer-link {
            color: var(--footer-text);
            text-decoration: none;
            display: block;
            margin-bottom: 0.8rem;
            transition: all 0.2s;
        }

            .footer-link:hover {
                color: #fff;
                transform: translateX(5px);
            }

        .footer-social-btn {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.1);
            color: #fff;
            border-radius: 50%;
            margin-right: 10px;
            transition: 0.3s;
            text-decoration: none;
        }

            .footer-social-btn:hover {
                background: var(--primary);
                transform: translateY(-3px);
            }

        .newsletter-input {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            color: #fff;
            height: 48px;
            border-radius: 8px 0 0 8px;
        }

            .newsletter-input:focus {
                background: rgba(255,255,255,0.1);
                border-color: var(--primary);
                color: #fff;
                box-shadow: none;
            }

        .btn-subscribe {
            background: var(--primary);
            color: white;
            border: none;
            padding: 0 20px;
            font-weight: 600;
            border-radius: 0 8px 8px 0;
        }

            .btn-subscribe:hover {
                background: var(--primary-hover);
            }

        .payment-icon {
            height: 24px;
            width: auto;
            opacity: 0.7;
            transition: 0.2s;
            filter: grayscale(100%) brightness(200%); /* Làm icon trắng đen */
        }

            .payment-icon:hover {
                opacity: 1;
                filter: none;
            }

        .footer-bottom {
            background: rgba(0,0,0,0.2);
            padding: 20px 0;
            margin-top: 3rem;
            font-size: 0.85rem;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 me-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;"><i class="bi bi-box-seam-fill fs-5"></i></span>
                    <span class="brand-logo fs-3">204Store</span>
                </a>
                <button class="navbar-toggler border-0 p-2 bg-light rounded-circle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <div class="flex-grow-1 mx-lg-4 my-3 my-lg-0">
                        <form class="w-100" style="max-width: 500px;" asp-controller="Home" asp-action="Search" method="get">
                            <input class="form-control rounded-pill ps-4" name="query" type="search" placeholder="Bạn muốn tìm gì hôm nay?..." aria-label="Search" style="background-color: #f1f5f9; border:none; height: 42px;">
                        </form>
                    </div>
                    <ul class="navbar-nav align-items-lg-center gap-2">
                        <li class="nav-item"><a class="nav-link active" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Danh mục</a>
                            <ul class="dropdown-menu shadow-lg border-0 rounded-4 mt-3 p-3">
                                <li><a class="dropdown-item rounded-3 py-2" href="#"><i class="bi bi-phone me-2"></i>Điện thoại</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" href="#"><i class="bi bi-laptop me-2"></i>Laptop</a></li>
                            </ul>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-sm text-danger bg-danger bg-opacity-10 rounded-pill px-3 fw-bold"><i class="bi bi-shield-lock me-2"></i>Quản trị</a></li>
                        }
                        <li class="nav-item border-start ps-lg-3 ms-lg-2"><partial name="_LoginPartial" /></li>
                        <li class="nav-item ms-lg-3 mt-3 mt-lg-0">
                            <a class="btn-cart" asp-area="" asp-controller="Cart" asp-action="Index">
                                <div class="position-relative d-flex align-items-center">
                                    <i class="bi bi-bag-dash fs-5"></i>
                                    <span id="cart-badge" class="cart-badge @(cartCount > 0 ? "" : "d-none")">
                                        @cartCount
                                    </span>
                                </div>
                                <span class="fw-bold d-none d-xl-inline">Giỏ hàng</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 py-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer>
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4 col-md-6">
                    <div class="mb-4">
                        <span class="brand-logo fs-3">204Store</span>
                    </div>
                    <p class="mb-4" style="line-height: 1.8;">
                        Hệ thống bán lẻ các sản phẩm công nghệ chính hãng hàng đầu Việt Nam. Chúng tôi cam kết mang đến những sản phẩm chất lượng nhất với mức giá tốt nhất.
                    </p>
                    <div>
                        <a href="#" class="footer-social-btn"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="footer-social-btn"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="footer-social-btn"><i class="bi bi-tiktok"></i></a>
                        <a href="#" class="footer-social-btn"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading">Hỗ trợ</h5>
                    <ul class="list-unstyled">
                        <li><a asp-area="" asp-controller="Home" asp-action="Tracking" class="footer-link">Tra cứu đơn hàng</a></li>
                        <li><a asp-controller="Home" asp-action="Guide" class="footer-link">Hướng dẫn mua hàng</a></li>
                        <li><a asp-controller="Home" asp-action="Warranty" class="footer-link">Chính sách bảo hành</a></li>
                        <li><a asp-controller="Home" asp-action="ReturnPolicy" class="footer-link">Chính sách đổi trả</a></li>
                        <li><a asp-controller="Home" asp-action="ServiceCenter" class="footer-link">Trung tâm bảo hành</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading">Về 204Store</h5>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Home" asp-action="About" class="footer-link">Giới thiệu công ty</a></li>
                        <li><a asp-controller="Home" asp-action="Careers" class="footer-link">Tuyển dụng</a></li>
                        <li><a asp-controller="Home" asp-action="Contact" class="footer-link">Gửi góp ý, khiếu nại</a></li>
                        <li><a asp-controller="Home" asp-action="ServiceCenter" class="footer-link">Tìm siêu thị (20 shop)</a></li>
                        <li><a asp-controller="Home" asp-action="ServiceCenter" class="footer-link">Liên hệ hợp tác</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h5 class="footer-heading">Tổng đài hỗ trợ</h5>
                    <div class="d-flex align-items-center mb-3">
                        <div class="me-3 text-white"><i class="bi bi-headset fs-2"></i></div>
                        <div>
                            <div class="fw-bold text-white fs-5">1800 2044</div>
                            <div class="small">Thứ 2 - CN: 8:00 - 21:30</div>
                        </div>
                    </div>

                    <h5 class="footer-heading mt-4 mb-3">Đăng ký nhận tin</h5>
                    <p class="small mb-3">Nhận thông tin khuyến mãi mới nhất từ chúng tôi.</p>
                    <form class="input-group">
                        <input type="email" class="form-control newsletter-input" placeholder="Email của bạn...">
                        <button class="btn btn-subscribe" type="button"><i class="bi bi-send-fill"></i></button>
                    </form>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                        &copy; 2026 <strong>204Store</strong>. All Rights Reserved.
                        <div class="mt-1 small">
                            <a href="#" class="text-white-50 text-decoration-none me-3">Điều khoản</a>
                            <a href="#" class="text-white-50 text-decoration-none">Bảo mật</a>
                        </div>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <span class="text-white-50 me-2 small">Chấp nhận thanh toán:</span>
                        <i class="bi bi-credit-card-2-front fs-4 me-2 text-white-50" title="Visa/Master"></i>
                        <i class="bi bi-qr-code-scan fs-4 me-2 text-white-50" title="VNPay"></i>
                        <i class="bi bi-cash-coin fs-4 text-white-50" title="COD"></i>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>