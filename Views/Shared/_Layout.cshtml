        :root {
            --primary-color: #4f46e5;
            --primary-hover: #4338ca;
            --text-dark: #1e293b;
            --text-gray: #64748b;
            --bg-body: #f8fafc;
            --footer-bg: #0f172a;
            --footer-text: #94a3b8;
            --footer-heading: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-dark);
            line-height: 1.6;
        }

        .top-header {
            background-color: #0f172a;
            color: #cbd5e1;
            font-size: 0.8rem;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

            .top-header a {
                color: #cbd5e1;
                text-decoration: none;
                transition: 0.2s;
            }

                .top-header a:hover {
                    color: #fff;
                    text-decoration: underline;
                }

        .top-divider {
            border-right: 1px solid rgba(255,255,255,0.15);
            height: 12px;
            margin: 0 12px;
            display: inline-block;
            vertical-align: middle;
        }

        .navbar {
            background: rgba(255, 255, 255, 0.98) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            padding: 12px 0;
        }

        .brand-logo {
            font-weight: 800;
            color: var(--primary-color) !important;
        }

        .btn-admin-custom {
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 20px !important;
            border-radius: 50px !important;
            white-space: nowrap;
            font-weight: 700;
            box-shadow: 0 4px 6px rgba(220, 38, 38, 0.2);
        }

        .nav-link {
            font-weight: 600;
            color: #334155 !important;
            padding: 8px 15px !important;
            font-size: 0.95rem;
            white-space: nowrap;
        }

            .nav-link:hover, .nav-link.active {
                color: var(--primary-color) !important;
            }

        .search-group {
            position: relative;
            width: 100%;
            max-width: 450px;
            min-width: 250px;
        }

        .search-input {
            background: #f1f5f9;
            border: 1px solid transparent;
            padding-left: 45px;
            height: 44px;
            font-size: 0.9rem;
            transition: 0.3s;
        }

            .search-input:focus {
                background: #fff;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
            }

        .search-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
        }

        .icon-btn {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #f1f5f9;
            color: #334155;
            text-decoration: none;
            transition: 0.2s;
            position: relative;
            border: none;
        }

            .icon-btn:hover {
                background: var(--primary-color);
                color: white;
            }

        .cart-badge-new {
            position: absolute;
            top: -2px;
            right: -2px;
            background: #ef4444;
            color: white;
            font-size: 11px;
            font-weight: 700;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
        }

        .dropdown-menu-custom {
            border: none;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            border-radius: 12px;
            padding: 10px;
            margin-top: 15px !important;
        }

        .dropdown-item {
            border-radius: 8px;
            padding: 8px 15px;
            font-weight: 500;
            color: #475569;
        }

            .dropdown-item:hover {
                background-color: #f1f5f9;
                color: var(--primary-color);
            }

            .dropdown-item i {
                width: 20px;
                text-align: center;
                margin-right: 8px;
                opacity: 0.7;
            }

        footer {
            background-color: var(--footer-bg);
            color: var(--footer-text);
            font-size: 0.9rem;
            padding-top: 4rem;
            margin-top: auto;
        }

        .footer-heading {
            color: var(--footer-heading);
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .footer-link {
            color: var(--footer-text);
            text-decoration: none;
            display: block;
            margin-bottom: 0.8rem;
            transition: all 0.2s;
        }

            .footer-link:hover {
                color: #fff;
                transform: translateX(5px);
            }

        .footer-social-btn {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.1);
            color: #fff;
            border-radius: 50%;
            margin-right: 10px;
            transition: 0.3s;
            text-decoration: none;
        }

            .footer-social-btn:hover {
                background: var(--primary);
                transform: translateY(-3px);
            }

        .newsletter-input {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            color: #fff;
            height: 48px;
            border-radius: 8px 0 0 8px;
        }

            .newsletter-input:focus {
                background: rgba(255,255,255,0.1);
                border-color: var(--primary);
                color: #fff;
                box-shadow: none;
            }

        .btn-subscribe {
            background: var(--primary);
            color: white;
            border: none;
            padding: 0 20px;
            font-weight: 600;
            border-radius: 0 8px 8px 0;
        }

            .btn-subscribe:hover {
                background: var(--primary-hover);
            }

        .payment-icon {
            height: 24px;
            width: auto;
            opacity: 0.7;
            transition: 0.2s;
            filter: grayscale(100%) brightness(200%);
        }

            .payment-icon:hover {
                opacity: 1;
                filter: none;
            }

        .footer-bottom {
            background: rgba(0,0,0,0.2);
            padding: 20px 0;
            margin-top: 3rem;
            font-size: 0.85rem;
        }

        .btn-subscribe {
            background-color: #0d6efd;
            color: white;
            border: none;
        }

            .btn-subscribe:hover {
                background-color: #0b5ed7;
                color: white;
            }

        .search-item {
            transition: background 0.2s;
            cursor: pointer;
        }

            .search-item:hover {
                background-color: #f8f9fa;
            }

        .search-img {
            width: 40px;
            height: 40px;
            object-fit: cover;
            border-radius: 4px;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
