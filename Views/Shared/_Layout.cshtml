                        </button>
                        <input id="keyword"
                               class="form-control rounded-pill ps-5 bg-light border-0"
                               name="query"
                               type="text"
                               placeholder="Bạn tìm gì hôm nay?..."
                               autocomplete="off">
                    </form>
                    <div id="search-results" class="card shadow position-absolute w-100 mt-2 d-none"
                         style="z-index: 9999; border-radius: 15px; overflow: hidden; top: 100%; left: 0;">

                        <div class="list-group list-group-flush" id="search-list">
                        </div>

                        <a href="#" id="view-all-btn" class="card-footer text-center small text-decoration-none d-block bg-light p-2 fw-bold text-primary">
                            Xem tất cả kết quả <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-danger btn-admin-custom">
                            <i class="bi bi-shield-lock me-2"></i>Quản trị
                        </a>
                    }

                    <partial name="_LoginPartial" />

                    <a class="icon-btn position-relative" asp-area="" asp-controller="Cart" asp-action="Index" title="Giỏ hàng">
                        <i class="bi bi-bag-dash fs-5"></i>
                        <span id="cart-badge" class="cart-badge-new @(cartCount > 0 ? "" : "d-none")">
                            @cartCount
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

