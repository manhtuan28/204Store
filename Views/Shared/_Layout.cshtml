        :root {
            --primary-color: #4f46e5;
            --primary-hover: #4338ca;
            --text-dark: #1e293b;
            --text-gray: #64748b;
            --bg-body: #f8fafc;
            --footer-bg: #0f172a;
            --footer-text: #94a3b8;
            --footer-heading: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-dark);
            line-height: 1.6;
        }

        .top-header {
            background-color: #0f172a;
            color: #cbd5e1;
            font-size: 0.8rem;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

            .top-header a {
                color: #cbd5e1;
                text-decoration: none;
                transition: 0.2s;
            }

                .top-header a:hover {
                    color: #fff;
                    text-decoration: underline;
                }

        .top-divider {
            border-right: 1px solid rgba(255,255,255,0.15);
            height: 12px;
            margin: 0 12px;
            display: inline-block;
            vertical-align: middle;
        }

        .navbar {
            background: rgba(255, 255, 255, 0.98) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            padding: 12px 0;
        }

        .brand-logo {
            font-weight: 800;
            color: var(--primary-color) !important;
        }

        .btn-admin-custom {
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 20px !important;
            border-radius: 50px !important;
            white-space: nowrap;
            font-weight: 700;
            box-shadow: 0 4px 6px rgba(220, 38, 38, 0.2);
        }

        .nav-link {
            font-weight: 600;
            color: #334155 !important;
            padding: 8px 15px !important;
            font-size: 0.95rem;
            white-space: nowrap;
        }

            .nav-link:hover, .nav-link.active {
                color: var(--primary-color) !important;
            }

        .search-group {
            position: relative;
            width: 100%;
            max-width: 450px;
            min-width: 250px;
        }

        .search-input {
            background: #f1f5f9;
            border: 1px solid transparent;
            padding-left: 45px;
            height: 44px;
            font-size: 0.9rem;
            transition: 0.3s;
        }

            .search-input:focus {
                background: #fff;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
            }

        .search-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
        }

        .icon-btn {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #f1f5f9;
            color: #334155;
            text-decoration: none;
            transition: 0.2s;
            position: relative;
            border: none;
        }

            .icon-btn:hover {
                background: var(--primary-color);
                color: white;
            }

        .cart-badge-new {
            position: absolute;
            top: -2px;
            right: -2px;
            background: #ef4444;
            color: white;
            font-size: 11px;
            font-weight: 700;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
        }

        .dropdown-menu-custom {
            border: none;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            border-radius: 12px;
            padding: 10px;
            margin-top: 15px !important;
        }

        .dropdown-item {
            border-radius: 8px;
            padding: 8px 15px;
            font-weight: 500;
            color: #475569;
        }

            .dropdown-item:hover {
                background-color: #f1f5f9;
                color: var(--primary-color);
            }

            .dropdown-item i {
                width: 20px;
                text-align: center;
                margin-right: 8px;
                opacity: 0.7;
            }

        footer {
            background-color: var(--footer-bg);
            color: var(--footer-text);
            font-size: 0.9rem;
            padding-top: 4rem;
            margin-top: auto;
        }

        .footer-heading {
            color: var(--footer-heading);
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .footer-link {
            color: var(--footer-text);
            text-decoration: none;
            display: block;
            margin-bottom: 0.8rem;
            transition: all 0.2s;
        }

            .footer-link:hover {
                color: #fff;
                transform: translateX(5px);
            }

        .footer-social-btn {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.1);
            color: #fff;
            border-radius: 50%;
            margin-right: 10px;
            transition: 0.3s;
            text-decoration: none;
        }

            .footer-social-btn:hover {
                background: var(--primary);
                transform: translateY(-3px);
            }

        .newsletter-input {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            color: #fff;
            height: 48px;
            border-radius: 8px 0 0 8px;
        }

            .newsletter-input:focus {
                background: rgba(255,255,255,0.1);
                border-color: var(--primary);
                color: #fff;
                box-shadow: none;
            }

        .btn-subscribe {
            background: var(--primary);
            color: white;
            border: none;
            padding: 0 20px;
            font-weight: 600;
            border-radius: 0 8px 8px 0;
        }

            .btn-subscribe:hover {
                background: var(--primary-hover);
            }

        .payment-icon {
            height: 24px;
            width: auto;
            opacity: 0.7;
            transition: 0.2s;
            filter: grayscale(100%) brightness(200%);
        }

            .payment-icon:hover {
                opacity: 1;
                filter: none;
            }

        .footer-bottom {
            background: rgba(0,0,0,0.2);
            padding: 20px 0;
            margin-top: 3rem;
            font-size: 0.85rem;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <div class="top-header">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <a href="tel:19002044" class="fw-bold me-3"><i class="bi bi-telephone-fill me-1"></i>Hotline: 1900 2044</a>
                <span class="top-divider d-none d-sm-inline-block"></span>
                <a asp-controller="Home" asp-action="Partnership" class="d-none d-sm-inline-block">Liên hệ hợp tác</a>
            </div>

            <div class="d-flex align-items-center">
                <a asp-controller="Home" asp-action="StoreLocator" class="fw-bold"><i class="bi bi-geo-alt-fill me-1"></i>Hệ thống 20 shop</a>
                <span class="top-divider"></span>
                <a asp-controller="Home" asp-action="Tracking" class="d-none d-md-inline-block">Tra cứu đơn</a>
                <span class="top-divider d-none d-md-inline-block"></span>
                <a asp-controller="Home" asp-action="Careers" class="d-none d-md-inline-block">Tuyển dụng</a>
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 me-3" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; flex-shrink: 0;">
                    <i class="bi bi-box-seam-fill fs-5"></i>
                </span>
                <span class="brand-logo fs-3">204Store</span>
            </a>

            <button class="navbar-toggler border-0 p-2 bg-light rounded-circle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Danh mục</a>

                        <ul class="dropdown-menu dropdown-menu-custom shadow-lg border-0 rounded-4 mt-2 p-0">
                            @await Component.InvokeAsync("CategoryMenu")
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Hỗ trợ</a>
                        <ul class="dropdown-menu dropdown-menu-custom">
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Guide"><i class="bi bi-book"></i>Hướng dẫn mua hàng</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Warranty"><i class="bi bi-shield-check"></i>Chính sách bảo hành</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="ReturnPolicy"><i class="bi bi-arrow-repeat"></i>Chính sách đổi trả</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="ServiceCenter"><i class="bi bi-tools"></i>Trung tâm bảo hành</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Contact"><i class="bi bi-envelope"></i>Góp ý & Khiếu nại</a></li>
                        </ul>
                    </li>

                    <li class="nav-item d-lg-none">
                        <a class="nav-link" asp-controller="Home" asp-action="About">Giới thiệu</a>
                    </li>
                </ul>

                <form class="search-group mx-lg-3 my-3 my-lg-0" asp-controller="Home" asp-action="Search" method="get">
                    <i class="bi bi-search search-icon"></i>
                    <input class="form-control rounded-pill search-input" name="query" type="search" placeholder="Bạn tìm gì hôm nay?..." aria-label="Search">
                </form>

                <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-danger btn-admin-custom">
                            <i class="bi bi-shield-lock me-2"></i>Quản trị
                        </a>
                    }

                    <partial name="_LoginPartial" />

                    <a class="icon-btn position-relative" asp-area="" asp-controller="Cart" asp-action="Index" title="Giỏ hàng">
                        <i class="bi bi-bag-dash fs-5"></i>
                        <span id="cart-badge" class="cart-badge-new @(cartCount > 0 ? "" : "d-none")">
                            @cartCount
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main role="main" class="flex-grow-1 py-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer>
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4 col-md-6">
                    <div class="mb-4">
                        <span class="brand-logo fs-3">204Store</span>
                    </div>
                    <p class="mb-4" style="line-height: 1.8;">
                        Hệ thống bán lẻ các sản phẩm công nghệ chính hãng hàng đầu Việt Nam.
                        Chúng tôi cam kết mang đến những sản phẩm chất lượng nhất với mức giá tốt nhất.
                    </p>
                    <div>
                        <a href="#" class="footer-social-btn"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="footer-social-btn"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="footer-social-btn"><i class="bi bi-tiktok"></i></a>
                        <a href="#" class="footer-social-btn"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading">Hỗ trợ</h5>
                    <ul class="list-unstyled">
                        <li><a asp-area="" asp-controller="Home" asp-action="Tracking" class="footer-link">Tra cứu đơn hàng</a></li>
                        <li><a asp-controller="Home" asp-action="Guide" class="footer-link">Hướng dẫn mua hàng</a></li>
                        <li><a asp-controller="Home" asp-action="Warranty" class="footer-link">Chính sách bảo hành</a></li>
                        <li><a asp-controller="Home" asp-action="ReturnPolicy" class="footer-link">Chính sách đổi trả</a></li>
                        <li><a asp-controller="Home" asp-action="ServiceCenter" class="footer-link">Trung tâm bảo hành</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading">Về 204Store</h5>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Home" asp-action="About" class="footer-link">Giới thiệu công ty</a></li>
                        <li><a asp-controller="Home" asp-action="Careers" class="footer-link">Tuyển dụng</a></li>
                        <li><a asp-controller="Home" asp-action="Contact" class="footer-link">Gửi góp ý, khiếu nại</a></li>
                        <li><a asp-controller="Home" asp-action="StoreLocator" class="footer-link">Tìm siêu thị (20 shop)</a></li>
                        <li><a asp-controller="Home" asp-action="Partnership" class="footer-link">Liên hệ hợp tác</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h5 class="footer-heading">Tổng đài hỗ trợ</h5>
                    <div class="d-flex align-items-center mb-3">
                        <div class="me-3 text-white"><i class="bi bi-headset fs-2"></i></div>
                        <div>
                            <div class="fw-bold text-white fs-5">1800 2044</div>
                            <div class="small">Thứ 2 - CN: 8:00 - 21:30</div>
                        </div>
                    </div>

                    <h5 class="footer-heading mt-4 mb-3">Đăng ký nhận tin</h5>
                    <p class="small mb-3">Nhận thông tin khuyến mãi mới nhất từ chúng tôi.</p>
                    <form class="input-group">
                        <input type="email" class="form-control newsletter-input" placeholder="Email của bạn...">
                        <button class="btn btn-subscribe" type="button"><i class="bi bi-send-fill"></i></button>
                    </form>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                        &copy; 2026 <strong>204Store</strong>. All Rights Reserved.
                        <div class="mt-1 small">
                            <a <a asp-controller="Home" asp-action="Terms" class="text-white-50 text-decoration-none me-3">Điều khoản</a>
                            <a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none">Bảo mật</a>
                        </div>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <span class="text-white-50 me-2 small">Chấp nhận thanh toán:</span>
                        <i class="bi bi-credit-card-2-front fs-4 me-2 text-white-50" title="Visa/Master"></i>
                        <i class="bi bi-qr-code-scan fs-4 me-2 text-white-50" title="VNPay"></i>
                        <i class="bi bi-cash-coin fs-4 text-white-50" title="COD"></i>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>