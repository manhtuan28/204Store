<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 204Store</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_204Store.styles.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        .navbar.sticky-top {
            background-color: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(12px);
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
        }

        .brand-logo {
            color: #4f46e5 !important;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .nav-link {
            color: #475569 !important;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 0.5rem 1rem;
            transition: all 0.2s;
            border-radius: 0.5rem;
        }

            .nav-link:hover, .nav-link.active {
                color: #4f46e5 !important;
                background-color: rgba(79, 70, 229, 0.05);
            }

        .search-group .form-control {
            background-color: #f1f5f9;
            border: 1px solid transparent;
            padding-left: 2.5rem;
        }

            .search-group .form-control:focus {
                background-color: #fff;
                border-color: #4f46e5;
                box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
            }

        .search-icon-box {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            z-index: 5;
        }

        .cart-badge {
            background-color: #ef4444;
            border: 2px solid #fff;
            font-size: 0.7rem;
            padding: 0.25em 0.5em;
        }

        .footer-link {
            color: #64748b;
            transition: all 0.2s;
        }

            .footer-link:hover {
                color: #4f46e5;
                padding-left: 5px;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light py-3">
            <div class="container">
                <a class="navbar-brand fw-bolder fs-3 text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop-window me-2"></i>204Store
                </a>

                <div class="d-flex align-items-center gap-3 order-lg-3 ms-auto ms-lg-0">
                    <a class="nav-link position-relative py-1 px-2 border rounded-3 me-1 me-lg-3" href="#">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill cart-badge">
                            2
                        </span>
                    </a>

                    <button class="navbar-toggler border-0 p-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse order-lg-2" id="navbarContent">
                    <form class="d-flex my-3 my-lg-0 mx-lg-auto position-relative search-group w-100" style="max-width: 450px;">
                        <i class="bi bi-search search-icon-box"></i>
                        <input class="form-control rounded-pill py-2" type="search" placeholder="Tìm kiếm sản phẩm..." aria-label="Search">
                    </form>

                    <ul class="navbar-nav mb-2 mb-lg-0 align-items-lg-center gap-2 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Danh mục</a>
                            <ul class="dropdown-menu shadow-sm border-0 rounded-3 mt-2">
                                <li><a class="dropdown-item py-2" href="#"><i class="bi bi-phone me-2 text-muted"></i>Điện thoại</a></li>
                                <li><a class="dropdown-item py-2" href="#"><i class="bi bi-laptop me-2 text-muted"></i>Laptop</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 fw-bold text-primary" href="#">Tất cả sản phẩm</a></li>
                            </ul>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item d-lg-none d-xl-block">
                                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                                   class="btn btn-sm fw-bold text-danger bg-danger bg-opacity-10 rounded-pill px-3 d-flex align-items-center">
                                    <i class="bi bi-shield-lock me-2"></i>Admin
                                </a>
                            </li>
                        }

                        <li class="nav-item border-start ps-lg-3 ms-lg-2">
                            <partial name="_LoginPartial" />
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 py-4">
        @RenderBody()
    </main>

    <footer class="bg-white border-top pt-5">
        <div class="container">
            <div class="row g-4 justify-content-between">
                <div class="col-lg-4 mb-3">
                    <a href="#" class="text-decoration-none mb-3 d-block">
                        <span class="brand-logo fs-4"><i class="bi bi-bag-heart-fill me-2"></i>204Store</span>
                    </a>
                    <p class="text-muted small mb-4 pe-lg-5">
                        Trải nghiệm mua sắm công nghệ đỉnh cao. Cam kết sản phẩm chính hãng, giá tốt nhất và dịch vụ khách hàng tận tâm 24/7.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-light btn-sm rounded-circle border"><i class="bi bi-facebook text-primary"></i></a>
                        <a href="#" class="btn btn-light btn-sm rounded-circle border"><i class="bi bi-youtube text-danger"></i></a>
                        <a href="#" class="btn btn-light btn-sm rounded-circle border"><i class="bi bi-tiktok text-dark"></i></a>
                    </div>
                </div>

                <div class="col-6 col-lg-2 mb-3">
                    <h6 class="fw-bold mb-3 text-dark">Mua hàng</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="#" class="text-decoration-none footer-link small">Tất cả sản phẩm</a></li>
                        <li><a href="#" class="text-decoration-none footer-link small">Khuyến mãi hot</a></li>
                        <li><a href="#" class="text-decoration-none footer-link small">Chính sách giao hàng</a></li>
                        <li><a href="#" class="text-decoration-none footer-link small">Hướng dẫn mua trả góp</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2 mb-3">
                    <h6 class="fw-bold mb-3 text-dark">Hỗ trợ</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="#" class="text-decoration-none footer-link small">Tra cứu bảo hành</a></li>
                        <li><a href="#" class="text-decoration-none footer-link small">Trung tâm bảo hành</a></li>
                        <li><a href="#" class="text-decoration-none footer-link small">Chính sách đổi trả</a></li>
                        <li><a href="#" class="text-decoration-none footer-link small">Liên hệ góp ý</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 mb-3">
                    <h6 class="fw-bold mb-3 text-dark">Tổng đài miễn phí</h6>
                    <div class="bg-light p-3 rounded-3 border mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-muted"><i class="bi bi-telephone me-2"></i>Tư vấn:</span>
                            <strong class="text-primary">1800.2044</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small text-muted"><i class="bi bi-gear me-2"></i>Kỹ thuật:</span>
                            <strong>1800.2045</strong>
                        </div>
                    </div>
                    <h6 class="fw-bold mb-3 text-dark">Thanh toán an toàn</h6>
                    <div class="d-flex gap-3 opacity-50">
                        <i class="bi bi-credit-card fs-4"></i>
                        <i class="bi bi-paypal fs-4"></i>
                        <i class="bi bi-bank fs-4"></i>
                    </div>
                </div>
            </div>

            <div class="border-top py-4 mt-4 text-center small text-muted bg-light mx-n3 px-3">
                &copy; 2025 <strong>204Store</strong>. Designed with <i class="bi bi-heart-fill text-danger"></i> for technology lovers.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @{
        await RenderSectionAsync("Scripts", required: false);
    }
</body>
</html>