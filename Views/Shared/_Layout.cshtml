<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 204Store</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_204Store.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm fixed-top" style="height: 80px;">
            <div class="container">
                <a class="navbar-brand fw-bolder fs-3 text-primary" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop-window me-2"></i>204Store
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <form class="d-flex mx-auto my-2 my-lg-0 w-50 position-relative">
                        <input class="form-control rounded-pill ps-4 pe-5 bg-light border-0" type="search" placeholder="Bạn tìm gì hôm nay? (iPhone 15, Macbook...)" aria-label="Search">
                        <button class="btn position-absolute end-0 top-0 mt-1 me-2 rounded-circle btn-sm" type="submit">
                            <i class="bi bi-search text-muted"></i>
                        </button>
                    </form>

                    <ul class="navbar-nav ms-auto align-items-center gap-3">

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-outline-danger fw-bold rounded-pill px-3">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Quản trị
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>

                        <li class="nav-item position-relative">
                            <a class="nav-link fs-5 text-dark" href="#">
                                <i class="bi bi-cart3"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                                    2
                                </span>
                            </a>
                        </li>

                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container" style="margin-top: 100px;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-white mt-auto pt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold text-primary mb-3">204Store</h5>
                    <p class="text-muted small">
                        Hệ thống bán lẻ điện thoại, máy tính chính hãng uy tín hàng đầu. Cam kết chất lượng, bảo hành dài hạn.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-muted fs-5"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-muted fs-5"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-muted fs-5"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3">Về chúng tôi</h6>
                    <ul class="list-unstyled text-muted small">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Giới thiệu</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Tuyển dụng</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3">Hỗ trợ</h6>
                    <ul class="list-unstyled text-muted small">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Chính sách bảo hành</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Tra cứu đơn hàng</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Hướng dẫn mua hàng</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold mb-3">Tổng đài hỗ trợ</h6>
                    <p class="mb-1 text-muted small"><i class="bi bi-telephone-fill me-2"></i>Mua hàng: <strong class="text-dark">1800.1234</strong></p>
                    <p class="mb-1 text-muted small"><i class="bi bi-gear-fill me-2"></i>Bảo hành: <strong class="text-dark">1800.5678</strong></p>
                    <p class="mb-0 text-muted small"><i class="bi bi-envelope-fill me-2"></i>Email: cskh@204store.com</p>
                </div>
            </div>
            <div class="border-top py-3 mt-4 text-center text-muted small">
                &copy; 2025 - 204Store - All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>