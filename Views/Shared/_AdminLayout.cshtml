<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin 204Store</title>

    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background-color: #f3f4f6;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        #sidebar-wrapper {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            width: 260px;
            height: 100vh;
            z-index: 1000;
            background-color: #111827;
            transition: all 0.3s ease-in-out;
            margin-left: -260px;
            display: flex;
            flex-direction: column;
        }

        #page-content-wrapper {
            width: 100%;
            margin-left: 0;
            transition: all 0.3s ease-in-out;
            min-height: 100vh;
        }

        body.sb-sidenav-toggled #sidebar-wrapper {
            margin-left: 0;
        }

        #page-content-wrapper {
            margin-left: 260px;
        }

        body.sb-sidenav-toggled #sidebar-wrapper {
            margin-left: -260px;
        }

        body.sb-sidenav-toggled #page-content-wrapper {
            margin-left: 0;
        }

        }

        .sidebar-heading {
            padding: 1.5rem;
            font-size: 1.4rem;
            font-weight: 800;
            color: #ffffff;
            text-align: center;
            background: rgba(255,255,255,0.05);
        }

        .sidebar-label {
            color: #9ca3af;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            padding: 1.5rem 1.5rem 0.5rem;
        }

        .list-group-item {
            background: transparent !important;
            color: #d1d5db !important;
            border: none;
            padding: 12px 24px;
            font-weight: 600;
            display: flex;
            align-items: center;
        }

            .list-group-item i {
                margin-right: 12px;
                font-size: 1.1rem;
                color: #6b7280;
            }

            .list-group-item:hover {
                color: #ffffff !important;
                background-color: rgba(255,255,255,0.1) !important;
                padding-left: 28px;
                transition: all 0.2s;
            }

                .list-group-item:hover i {
                    color: #ffffff;
                }

            .list-group-item.active-menu {
                color: #ffffff !important;
                background: linear-gradient(90deg, rgba(79, 70, 229, 0.25) 0%, transparent 100%) !important;
                border-left: 4px solid #4f46e5;
            }

                .list-group-item.active-menu i {
                    color: #818cf8;
                }

        .bottom-link {
            margin: auto 15px 20px;
            padding: 10px;
            text-align: center;
            border: 1px solid #374151;
            border-radius: 8px;
            color: #9ca3af;
            text-decoration: none;
            transition: 0.3s;
        }

            .bottom-link:hover {
                background: #374151;
                color: #fff;
            }
    </style>
</head>
<body>

    <div id="wrapper">
        <div id="sidebar-wrapper">
            <div class="sidebar-heading">
                <i class="bi bi-shop-window text-primary"></i> 204 STORE
            </div>

            <div class="list-group list-group-flush mt-2">

                <div class="sidebar-label">Tổng quan</div>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active-menu" : "")">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <div class="sidebar-label">Quản lý kho</div>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active-menu" : "")">
                    <i class="bi bi-grid-fill"></i> Danh mục
                </a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active-menu" : "")">
                    <i class="bi bi-box-seam-fill"></i> Sản phẩm
                </a>

                <div class="sidebar-label">Hệ thống</div>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="bi bi-receipt"></i> Đơn hàng
                </a>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="bi bi-people-fill"></i> Khách hàng
                </a>

                <a href="/" class="bottom-link mt-auto">
                    <i class="bi bi-arrow-left me-2"></i>Về trang bán hàng
                </a>
            </div>
        </div>

        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light bg-white px-4 border-bottom sticky-top shadow-sm" style="height: 70px;">
                <button class="btn btn-light text-primary" id="sidebarToggle">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <div class="ms-auto d-flex align-items-center">
                    <div class="dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center text-dark text-decoration-none" href="#" role="button" data-bs-toggle="dropdown">
                            <span class="fw-bold me-2 d-none d-lg-block">Admin System</span>
                            <img src="https://ui-avatars.com/api/?name=Admin&background=4f46e5&color=fff" class="rounded-circle" width="38" height="38">
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li><a class="dropdown-item" href="#">Hồ sơ</a></li>
                            <li><a class="dropdown-item" href="#">Cài đặt</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
                                    <button type="submit" class="dropdown-item text-danger fw-bold">Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <div class="container-fluid px-4 py-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sidebarToggle = document.querySelector('#sidebarToggle');
            const body = document.body;

            if (localStorage.getItem('sb|sidebar-toggle') === 'true') {
                 body.classList.add('sb-sidenav-toggled');
            }

            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', event => {
                    event.preventDefault();
                    body.classList.toggle('sb-sidenav-toggled');
                    localStorage.setItem('sb|sidebar-toggle', body.classList.contains('sb-sidenav-toggled'));
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>