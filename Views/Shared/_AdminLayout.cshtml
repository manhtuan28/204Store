<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin 204Store</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --sidebar-bg: #0f172a;
            --sidebar-active: #6366f1;
            --body-bg: #f8fafc;
            --accent-color: #4f46e5;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--body-bg);
            color: #1e293b;
            overflow-x: hidden;
        }

        /* Sidebar Styling */
        #sidebar-wrapper {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            width: 280px;
            z-index: 1000;
            background-color: var(--sidebar-bg);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            box-shadow: 4px 0 10px rgba(0,0,0,0.05);
        }

        .sidebar-heading {
            padding: 2rem 1.5rem;
            font-size: 1.25rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: -0.5px;
        }

        .sidebar-label {
            color: #64748b;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            padding: 1.5rem 2rem 0.5rem;
            letter-spacing: 0.1em;
        }

        .menu-list {
            padding: 0 1rem;
        }

        .list-group-item {
            background: transparent !important;
            color: #94a3b8 !important;
            border: none;
            padding: 0.8rem 1rem;
            font-weight: 500;
            border-radius: 8px !important;
            margin-bottom: 4px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
        }

            .list-group-item i {
                font-size: 1.25rem;
                margin-right: 12px;
                transition: transform 0.2s;
            }

            .list-group-item:hover {
                color: #fff !important;
                background: rgba(255,255,255,0.08) !important;
            }

            .list-group-item.active-menu {
                color: #fff !important;
                background: var(--sidebar-active) !important;
                box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);
            }

        /* Content Wrapper */
        #page-content-wrapper {
            width: 100%;
            padding-left: 280px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Toggled State */
        body.sb-sidenav-toggled #sidebar-wrapper {
            margin-left: -280px;
        }

        body.sb-sidenav-toggled #page-content-wrapper {
            padding-left: 0;
        }

        .navbar {
            backdrop-filter: blur(10px);
            background: rgba(255, 255, 255, 0.8) !important;
        }

        .bottom-link {
            margin: auto 1.5rem 1.5rem;
            padding: 0.75rem;
            background: rgba(255,255,255,0.05);
            border-radius: 12px;
            color: #94a3b8;
            text-decoration: none;
            text-align: center;
            font-size: 0.9rem;
            border: 1px solid rgba(255,255,255,0.1);
        }
    </style>
</head>
<body>
    <div id="wrapper">
        <div id="sidebar-wrapper">
            <div class="sidebar-heading d-flex align-items-center">
                <div class="bg-primary rounded-3 p-2 me-3 shadow-sm">
                    <i class="bi bi-shop-window text-white"></i>
                </div>
                <span>204 STORE</span>
            </div>

            <div class="menu-list">
                <div class="sidebar-label">Tổng quan</div>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="list-group-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active-menu" : "")">
                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                </a>

                <div class="sidebar-label">Quản lý kho</div>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
                   class="list-group-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active-menu" : "")">
                    <i class="bi bi-tags-fill"></i> Danh mục
                </a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                   class="list-group-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active-menu" : "")">
                    <i class="bi bi-box-seam-fill"></i> Sản phẩm
                </a>

                <div class="sidebar-label">Hệ thống</div>
                <a href="#" class="list-group-item"><i class="bi bi-receipt-cutoff"></i> Đơn hàng</a>
                <a href="#" class="list-group-item"><i class="bi bi-people-fill"></i> Khách hàng</a>
            </div>

            <a href="/" class="bottom-link">
                <i class="bi bi-box-arrow-left me-2"></i>Thoát Admin
            </a>
        </div>

        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light sticky-top px-4 border-bottom" style="height: 70px;">
                <button class="btn btn-light border-0" id="sidebarToggle">
                    <i class="bi bi-text-indent-left fs-4"></i>
                </button>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <div class="position-relative me-3">
                        <i class="bi bi-bell fs-5 text-muted"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge border border-light rounded-circle bg-danger p-1">
                            <span class="visually-hidden">unread messages</span>
                        </span>
                    </div>
                    <div class="dropdown">
                        <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <div class="text-end me-3 d-none d-lg-block">
                                <p class="mb-0 fw-bold text-dark small">Admin System</p>
                                <p class="mb-0 text-muted extra-small" style="font-size: 11px;">Quản trị viên</p>
                            </div>
                            <img src="https://ui-avatars.com/api/?name=Admin&background=6366f1&color=fff" class="rounded-circle border" width="40" height="40">
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-3 p-2" style="min-width: 200px;">
                            <li><a class="dropdown-item rounded-2" href="#"><i class="bi bi-person me-2"></i>Hồ sơ</a></li>
                            <li><a class="dropdown-item rounded-2" href="#"><i class="bi bi-gear me-2"></i>Cài đặt</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><button class="dropdown-item rounded-2 text-danger fw-600"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <div class="container-fluid p-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('sidebarToggle').addEventListener('click', () => {
            document.body.classList.toggle('sb-sidenav-toggled');
        });
    </script>
</body>
</html>