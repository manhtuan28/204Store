@using System.Globalization
@model _204Store.Models.OrderHeader
@{
    ViewData["Title"] = "Thanh toán & Đặt hàng";
    var cartItems = ViewBag.CartItems as List<_204Store.Models.CartItem>;
    var culture = new CultureInfo("vi-VN");
}

<style>
    .form-check-input:checked + .payment-label {
        border-color: #4f46e5 !important;
        background-color: #eef2ff !important;
        box-shadow: 0 0 0 1px #4f46e5;
    }

    .payment-label {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

        .payment-label:hover {
            border-color: #a5b4fc !important;
        }

    .sticky-summary {
        position: -webkit-sticky;
        position: sticky;
        top: 20px;
    }
</style>

<div class="container py-5">
    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
        <div class="row g-4 g-lg-5">

            <div class="col-lg-7">

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-geo-alt-fill me-2 text-primary"></i>Thông tin giao hàng
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Họ và tên người nhận</label>
                                <input asp-for="Name" class="form-control" placeholder="Nhập họ tên" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Số điện thoại</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" required />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <input type="hidden" asp-for="City" id="FullAddressString" />

                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">Địa chỉ hành chính</label>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <select class="form-select" id="province" required>
                                            <option value="">-- Tỉnh / Thành --</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <select class="form-select" id="district" required disabled>
                                            <option value="">-- Quận / Huyện --</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <select class="form-select" id="ward" required disabled>
                                            <option value="">-- Phường / Xã --</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">Số nhà, Tên đường</label>
                                <input asp-for="StreetAddress" class="form-control" placeholder="Ví dụ: Số 20 ngõ 90 đường Láng" required />
                                <span asp-validation-for="StreetAddress" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">Ghi chú đơn hàng (Tùy chọn)</label>
                                <textarea name="OrderNotes" class="form-control" rows="2" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi giao..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-credit-card-2-front-fill me-2 text-primary"></i>Phương thức thanh toán
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex flex-column gap-3">

                            <div class="position-relative">
                                <input class="form-check-input position-absolute top-50 start-0 translate-middle-y ms-3" type="radio" name="paymentMethod" id="payCOD" value="COD" checked>
                                <label class="payment-label d-flex align-items-center p-3 border rounded-3 w-100 ps-5" for="payCOD">
                                    <div class="icon-box bg-success bg-opacity-10 text-success rounded-circle p-2 me-3">
                                        <i class="bi bi-cash-stack fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">Thanh toán khi nhận hàng (COD)</div>
                                        <div class="small text-muted">Bạn chỉ phải thanh toán khi đã nhận và kiểm tra hàng.</div>
                                    </div>
                                </label>
                            </div>

                            <div class="position-relative">
                                <input class="form-check-input position-absolute top-50 start-0 translate-middle-y ms-3" type="radio" name="paymentMethod" id="payVNPay" value="VNPAY">
                                <label class="payment-label d-flex align-items-center p-3 border rounded-3 w-100 ps-5" for="payVNPay">
                                    <div class="icon-box me-3">
                                        <img src="https://vnpay.vn/assets/images/logo-icon/logo-primary.svg" height="40" alt="VNPay Logo">
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">Thanh toán VNPAY</div>
                                        <div class="small text-muted">Quét mã QR, Thẻ ATM Nội địa, Thẻ Quốc tế.</div>
                                    </div>
                                </label>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 sticky-summary">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="mb-0 fw-bold text-dark">Đơn hàng của bạn (@cartItems.Count sản phẩm)</h5>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                            <table class="table mb-0 align-middle">
                                <tbody>
                                    @foreach (var item in cartItems)
                                    {
                                        <tr>
                                            <td class="ps-4 py-3" width="70">
                                                <div class="position-relative">
                                                    <img src="@item.ProductDetail.Product.ImageUrl" width="60" height="60" class="rounded border object-fit-cover" />
                                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-secondary small">
                                                        @item.Quantity
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                <div class="fw-bold text-dark text-truncate" style="max-width: 180px;">@item.ProductDetail.Product.Name</div>
                                                <div class="small text-muted">@item.ProductDetail.Color / @item.ProductDetail.Rom</div>
                                            </td>
                                            <td class="text-end pe-4 py-3 fw-bold text-dark">
                                                @((item.ProductDetail.Price * item.Quantity).ToString("#,##0", culture))₫
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer bg-light p-4">

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted"><i class="bi bi-ticket-perforated-fill me-1"></i>Mã ưu đãi</label>
                            <div class="input-group">
                                <input type="text" id="couponInput" class="form-control" placeholder="Nhập mã giảm giá" value="@ViewBag.CouponCode">
                                <button class="btn btn-dark fw-bold px-3" type="button" id="btnApplyCoupon">Áp dụng</button>
                            </div>
                            <div id="couponMessage" class="small mt-2"></div>
                        </div>

                        <hr class="border-secondary opacity-25" />

                        <div class="d-flex justify-content-between mb-2 text-secondary">
                            <span>Tạm tính:</span>
                            <span class="fw-bold text-dark">@ViewBag.OriginalTotal.ToString("#,##0", culture)₫</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2 text-success" id="discountRow" style="display: @(ViewBag.Discount > 0 ? "flex" : "none") !important;">
                            <span><i class="bi bi-check-circle-fill me-1"></i>Giảm giá (<span id="couponCodeDisplay">@ViewBag.CouponCode</span>):</span>
                            <span class="fw-bold">-<span id="discountAmountDisplay">@(((decimal)(ViewBag.Discount ?? 0)).ToString("#,##0", culture))</span>₫</span>
                        </div>

                        <div class="d-flex justify-content-between mb-4">
                            <span>Phí vận chuyển:</span>
                            <span class="fw-bold text-success">Miễn phí</span>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top border-secondary border-opacity-25 align-items-center">
                            <span class="fs-5 fw-bold text-dark">Tổng cộng:</span>
                            <span class="fs-3 fw-bold text-primary" id="finalTotalDisplay">@Model.OrderTotal.ToString("#,##0", culture)₫</span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-3 mt-4 rounded-3 fw-bold fs-5 shadow-sm hover-scale transition">
                            ĐẶT HÀNG NGAY
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function() {
            const apiProv = 'https://esgoo.net/api-tinhthanh/1/0.htm';

            $.getJSON(apiProv, function(data) {
                if (data.error == 0) {
                    $.each(data.data, function(key, val) {
                        $("#province").append('<option value="' + val.id + '" data-name="' + val.full_name + '">' + val.full_name + '</option>');
                    });
                }
            });

            $("#province").change(function() {
                var idProv = $(this).val();
                $("#district").html('<option value="">-- Quận / Huyện --</option>').prop("disabled", true);
                $("#ward").html('<option value="">-- Phường / Xã --</option>').prop("disabled", true);

                if (idProv != "") {
                    $.getJSON(`https://esgoo.net/api-tinhthanh/2/${idProv}.htm`, function(data) {
                        if (data.error == 0) {
                            $.each(data.data, function(key, val) {
                                $("#district").append('<option value="' + val.id + '" data-name="' + val.full_name + '">' + val.full_name + '</option>');
                            });
                            $("#district").prop("disabled", false);
                        }
                    });
                }
                updateFullAddress();
            });

            $("#district").change(function() {
                var idDist = $(this).val();
                $("#ward").html('<option value="">-- Phường / Xã --</option>').prop("disabled", true);

                if (idDist != "") {
                    $.getJSON(`https://esgoo.net/api-tinhthanh/3/${idDist}.htm`, function(data) {
                        if (data.error == 0) {
                            $.each(data.data, function(key, val) {
                                $("#ward").append('<option value="' + val.id + '" data-name="' + val.full_name + '">' + val.full_name + '</option>');
                            });
                            $("#ward").prop("disabled", false);
                        }
                    });
                }
                updateFullAddress();
            });

            $("#ward").change(function() { updateFullAddress(); });

            function updateFullAddress() {
                var p = $("#province option:selected").data("name") || "";
                var d = $("#district option:selected").data("name") || "";
                var w = $("#ward option:selected").data("name") || "";

                if(p && d && w) {
                    $("#FullAddressString").val(`${w}, ${d}, ${p}`);
                } else {
                    $("#FullAddressString").val("");
                }
            }

            $("#btnApplyCoupon").click(function() {
                var code = $("#couponInput").val().trim();
                var $btn = $(this);
                var $msg = $("#couponMessage");

                if (!code) {
                    $msg.html('<span class="text-danger small">Vui lòng nhập mã!</span>');
                    return;
                }

                $btn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>').prop("disabled", true);

                $.ajax({
                    url: '/Checkout/ApplyCouponAjax',
                    type: 'POST',
                    data: { couponCode: code },
                    success: function(res) {
                        if (res.success) {
                            $msg.html('<span class="text-success small"><i class="bi bi-check-circle-fill me-1"></i>' + res.message + '</span>');

                            $("#discountRow").css("display", "flex");
                            $("#couponCodeDisplay").text(code);

                            $("#discountAmountDisplay").text(res.discount.toLocaleString('vi-VN'));
                            $("#finalTotalDisplay").text(res.finalTotal.toLocaleString('vi-VN') + "₫");
                        } else {
                            $msg.html('<span class="text-danger small"><i class="bi bi-exclamation-circle-fill me-1"></i>' + res.message + '</span>');
                        }
                    },
                    error: function() {
                        $msg.html('<span class="text-danger small">Lỗi kết nối, vui lòng thử lại.</span>');
                    },
                    complete: function() {
                        $btn.text("Áp dụng").prop("disabled", false);
                    }
                });
            });

            $("#checkoutForm").submit(function(e){
                if($("#FullAddressString").val() === "") {
                    e.preventDefault();
                    alert("Vui lòng chọn đầy đủ Tỉnh/Thành, Quận/Huyện, Phường/Xã!");
                    $("#province").focus();
                }
            });
        });
    </script>
}