@model IEnumerable<_204Store.Models.Product>

@{
    ViewData["Title"] = $"Tìm kiếm: {ViewBag.Keyword}";
    var count = Model?.Count() ?? 0;
}

<style>
    .product-card {
        transition: all 0.3s ease;
        border: 1px solid #f0f0f0;
        background: #fff;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            border-color: #0d6efd; /* Màu viền khi hover xanh cho nổi */
        }

    /* Hiệu ứng badge giảm giá */
    .badge-discount {
        background: linear-gradient(45deg, #ff357a, #fff172);
        color: white;
        font-weight: bold;
        border-radius: 4px;
        padding: 5px 8px;
    }
</style>

<div class="bg-light py-3 border-bottom mb-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tìm kiếm</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container pb-5">
    <div class="row">
        <div class="col-12">

            <div class="mb-4 border-bottom pb-2">
                <h4 class="fw-bold text-dark">
                    Kết quả cho: <span class="text-primary">"@ViewBag.Keyword"</span>
                </h4>
                <p class="text-muted small">Tìm thấy <span class="fw-bold">@count</span> sản phẩm phù hợp.</p>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3">
                    @foreach (var item in Model)
                    {
                        var minPrice = item.ProductDetails != null && item.ProductDetails.Any() ? item.ProductDetails.Min(d => d.Price) : 0;

                        <div class="col">
                            <div class="card h-100 product-card shadow-sm rounded-3 overflow-hidden">
                                <div class="position-relative">
                                    <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id">
                                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name"
                                             style="height: 200px; object-fit: contain; padding: 15px;">
                                    </a>
                                    @if (item.DiscountRate > 0)
                                    {
                                        <span class="badge bg-danger position-absolute top-0 start-0 m-2 shadow-sm">-@item.DiscountRate%</span>
                                    }
                                </div>

                                <div class="card-body p-3 d-flex flex-column">
                                    <div class="small text-muted mb-1 text-uppercase" style="font-size: 11px;">
                                        @item.Category?.Name
                                    </div>
                                    <h6 class="card-title text-truncate mb-2">
                                        <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id" class="text-dark text-decoration-none fw-bold" title="@item.Name">
                                            @item.Name
                                        </a>
                                    </h6>

                                    <div class="mb-2 text-warning small">
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-half"></i>
                                        <span class="text-muted ms-1" style="font-size: 11px;">(12)</span>
                                    </div>

                                    <div class="mt-auto">
                                        <div class="fw-bold text-danger fs-5 mb-2">
                                            @if (minPrice > 0)
                                            {
                                                @minPrice.ToString("#,##0")
                                                <u class="ms-1 align-top" style="font-size: 12px; text-decoration: none;">đ</u>
                                            }
                                            else
                                            {
                                                <span>Liên hệ</span>
                                            }
                                        </div>

                                        <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id" class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold">
                                            Xem chi tiết
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center bg-white p-5 rounded-3 shadow-sm border">
                    <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" alt="Empty" style="width: 120px; opacity: 0.7;" class="mb-3">
                    <h5 class="fw-bold text-muted">Không tìm thấy sản phẩm nào!</h5>
                    <p class="text-muted small">Rất tiếc chúng tôi không tìm thấy sản phẩm phù hợp với từ khóa của bạn.</p>
                    <a href="/" class="btn btn-primary px-4 rounded-pill mt-3">
                        <i class="bi bi-arrow-left me-2"></i>Về trang chủ
                    </a>
                </div>
            }
        </div>
    </div>
</div>