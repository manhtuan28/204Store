@model IEnumerable<StoreLocation>
@{
    ViewData["Title"] = "Hệ thống 20 siêu thị";
}

<style>
    .locator-container {
        display: flex;
        height: calc(100vh - 150px);
        min-height: 600px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        background: white;
    }

    .store-list-panel {
        width: 400px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        border-right: 1px solid #e2e8f0;
    }

    .store-list-content {
        flex-grow: 1;
        overflow-y: auto;
        padding: 20px;
        background: #f8fafc;
    }

        .store-list-content::-webkit-scrollbar {
            width: 6px;
        }

        .store-list-content::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .store-list-content::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

            .store-list-content::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

    .store-item {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 15px;
        transition: 0.2s;
        cursor: pointer;
        position: relative;
    }

        .store-item:hover {
            border-color: #3b82f6;
            box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.1);
            transform: translateY(-2px);
        }

        .store-item.active {
            border-color: #3b82f6;
            background-color: #eff6ff;
        }

    .map-panel {
        flex-grow: 1;
        background: #e2e8f0;
        position: relative;
    }

    .map-iframe-placeholder {
        width: 100%;
        height: 100%;
        background-image: url('https://media.wired.com/photos/59269cd37034dc5f91becd50/191:100/w_1280,c_limit/GoogleMapTA.jpg');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .panel-header {
        padding: 20px;
        background: white;
        border-bottom: 1px solid #e2e8f0;
        z-index: 10;
    }
</style>

<div class="container py-4">
    <div class="mb-4 text-center">
        <h2 class="fw-bold"><i class="bi bi-shop me-2"></i>Tìm siêu thị 204Store</h2>
        <p class="text-muted">Hệ thống 20 cửa hàng chính hãng trên toàn quốc</p>
    </div>

    <div class="locator-container shadow">
        <div class="store-list-panel">
            <div class="panel-header">
                <form method="get" asp-action="StoreLocator">
                    <label class="form-label small fw-bold text-muted">Chọn khu vực của bạn</label>
                    <div class="input-group">
                        <select class="form-select fw-bold" name="city" onchange="this.form.submit()">
                            <!option value="All" @(ViewBag.CurrentCity == null ? "selected" : "")>Toàn quốc (@Model.Count())</!option>
                            <!option value="Hà Nội" @(ViewBag.CurrentCity == "Hà Nội" ? "selected" : "")>Hà Nội</!option>
                            <!option value="TP.HCM" @(ViewBag.CurrentCity == "TP.HCM" ? "selected" : "")>TP. Hồ Chí Minh</!option>
                            <!option value="Đà Nẵng" @(ViewBag.CurrentCity == "Đà Nẵng" ? "selected" : "")>Đà Nẵng</!option>
                            <!option value="Hải Phòng" @(ViewBag.CurrentCity == "Hải Phòng" ? "selected" : "")>Hải Phòng</!option>
                            <!option value="Cần Thơ" @(ViewBag.CurrentCity == "Cần Thơ" ? "selected" : "")>Cần Thơ</!option>
                        </select>
                        <button class="btn btn-primary"><i class="bi bi-search"></i></button>
                    </div>
                </form>
            </div>

            <div class="store-list-content">
                @if (Model.Any())
                {
                    foreach (var store in Model)
                    {
                        <div class="store-item" onclick="focusStore('@store.Name', '@store.Address')">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-bold text-primary mb-0">@store.Name</h6>
                                <span class="badge bg-light text-secondary border">@store.City</span>
                            </div>
                            <p class="small text-muted mb-2"><i class="bi bi-geo-alt-fill me-1"></i>@store.Address</p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <a href="tel:@store.Phone" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold">
                                    <i class="bi bi-telephone-fill me-1"></i>@store.Phone
                                </a>
                                <a href="https://www.google.com/maps/search/?api=1&query=@(store.Name + " " + store.City)" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3">
                                    <i class="bi bi-cursor-fill me-1"></i>Chỉ đường
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-geo-alt text-muted" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-3">Không tìm thấy cửa hàng nào ở khu vực này.</p>
                        <a asp-action="StoreLocator" class="btn btn-link">Xem tất cả cửa hàng</a>
                    </div>
                }
            </div>

            <div class="p-3 bg-white border-top text-center">
                <small class="text-muted">Tổng cộng: <strong>@Model.Count()</strong> cửa hàng</small>
            </div>
        </div>

        <div class="map-panel d-none d-md-block">
            <div class="map-iframe-placeholder position-relative">
                <div class="bg-white p-3 rounded-3 shadow text-center" style="max-width: 300px;">
                    <i class="bi bi-geo-alt-fill text-danger fs-1"></i>
                    <h5 class="fw-bold mt-2" id="mapStoreName">204Store Việt Nam</h5>
                    <p class="small text-muted" id="mapStoreAddr">Chọn một cửa hàng bên trái để xem vị trí.</p>
                    <a href="https://www.google.com/maps" target="_blank" class="btn btn-primary w-100 rounded-pill">Mở Google Maps</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function focusStore(name, address) {
        document.getElementById('mapStoreName').innerText = name;
        document.getElementById('mapStoreAddr').innerText = address;
    }
</script>