@using System.Globalization
@model _204Store.Models.Product
@{
    ViewData["Title"] = Model.Name;
    var culture = new CultureInfo("vi-VN");

    var variants = Model.ProductDetails.Select(v => new
    {
        id = v.Id,
        color = v.Color,
        rom = v.Rom,
        price = v.Price,
        stock = 10
    }).ToList();

    var defaultVariant = Model.ProductDetails.OrderBy(v => v.Price).FirstOrDefault();

    var uniqueRoms = Model.ProductDetails.Select(v => v.Rom).Distinct().OrderBy(r => r).ToList();
    var uniqueColors = Model.ProductDetails.Select(v => v.Color).Distinct().ToList();
}

<style>
    .product-gallery {
        background: white;
        border-radius: 20px;
        border: 1px solid #f1f5f9;
        padding: 30px;
        position: relative;
        overflow: hidden;
        text-align: center;
    }

    #main-product-img {
        max-width: 100%;
        height: auto;
        max-height: 450px;
        object-fit: contain;
        transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        cursor: zoom-in;
    }

        #main-product-img:hover {
            transform: scale(1.1);
        }

    .product-title {
        font-weight: 800;
        color: #1e293b;
        letter-spacing: -0.5px;
    }

    .price-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 15px 20px;
        display: flex;
        align-items: baseline;
        gap: 15px;
    }

    .current-price {
        font-size: 2rem;
        font-weight: 800;
        color: #ef4444;
        line-height: 1;
    }

    .old-price {
        font-size: 1.1rem;
        color: #94a3b8;
        text-decoration: line-through;
    }

    .discount-tag {
        background: #fee2e2;
        color: #ef4444;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 4px 8px;
        border-radius: 6px;
    }

    .option-label {
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 8px;
        display: block;
        color: #475569;
    }

    .btn-option {
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #334155;
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        position: relative;
        min-width: 80px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
    }

        .btn-option:hover {
            border-color: #4f46e5;
            color: #4f46e5;
            transform: translateY(-2px);
        }

        .btn-option.active {
            border-color: #4f46e5;
            background-color: #eef2ff;
            color: #4f46e5;
            font-weight: 700;
            box-shadow: 0 0 0 1px #4f46e5 inset;
        }

            .btn-option.active::after {
                content: '\F26A';
                font-family: 'bootstrap-icons';
                position: absolute;
                top: -8px;
                right: -8px;
                background: #4f46e5;
                color: white;
                width: 20px;
                height: 20px;
                font-size: 12px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px solid white;
            }

    .qty-control {
        display: flex;
        align-items: center;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
        width: fit-content;
    }

    .qty-btn {
        width: 40px;
        height: 40px;
        border: none;
        background: white;
        cursor: pointer;
        transition: 0.2s;
        font-size: 1.2rem;
    }

        .qty-btn:hover {
            background: #f1f5f9;
            color: #4f46e5;
        }

    .qty-input {
        width: 50px;
        text-align: center;
        border: none;
        font-weight: 700;
        font-size: 1.1rem;
        outline: none;
    }

    .promo-box {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }

    .promo-header {
        background: #f1f5f9;
        padding: 10px 15px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .promo-content {
        padding: 15px;
    }

    .promo-item {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
        font-size: 0.9rem;
        align-items: flex-start;
    }

    .promo-number {
        background: #4f46e5;
        color: white;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        font-size: 0.7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .flying-img {
        position: fixed;
        z-index: 9999;
        border-radius: 50%;
        border: 2px solid #4f46e5;
        opacity: 0.8;
        pointer-events: none;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .rating-box {
        text-align: center;
        border-right: 1px solid #e2e8f0;
    }

    .rating-score {
        font-size: 3rem;
        font-weight: 800;
        color: #f59e0b;
        line-height: 1;
    }

    .progress {
        height: 8px;
        border-radius: 4px;
        background-color: #f1f5f9;
    }

    .progress-bar {
        background-color: #f59e0b;
        border-radius: 4px;
    }

    .review-item {
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 20px;
        margin-bottom: 20px;
    }

        .review-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

    .avatar-circle {
        width: 45px;
        height: 45px;
        background: #e0e7ff;
        color: #4f46e5;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 1.1rem;
    }

    /* Related Products */
    .related-card {
        transition: all 0.3s;
        border: 1px solid #f1f5f9;
        border-radius: 12px;
        overflow: hidden;
        background: white;
    }

        .related-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            border-color: #e2e8f0;
        }

    .related-img {
        height: 180px;
        width: 100%;
        object-fit: contain;
        padding: 15px;
    }

    .news-item img {
        height: 160px;
        width: 100%;
        object-fit: cover;
        border-radius: 12px;
    }

    .news-title {
        font-weight: 700;
        font-size: 1rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted fw-bold small">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted fw-bold small">@Model.Category?.Name</a></li>
            <li class="breadcrumb-item active fw-bold text-dark small" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-5 mb-5">
        <div class="col-lg-5">
            <div class="sticky-top" style="top: 100px; z-index: 10;">
                <div class="product-gallery shadow-sm">
                    <img src="@Model.ImageUrl" alt="@Model.Name" id="main-product-img" onerror="this.src='https://placehold.co/600x600/f8fafc/cbd5e1?text=NO+IMAGE'" />
                    @if (Model.DiscountRate > 0)
                    {
                        <span class="position-absolute top-0 start-0 m-3 badge bg-danger rounded-3 px-3 py-2 fs-6 shadow-sm">
                            Giảm @Model.DiscountRate%
                        </span>
                    }
                </div>
                <div class="mt-4 row g-2 justify-content-center">
                    <div class="col-3"><div class="border rounded-3 p-1 cursor-pointer hover-shadow"><img src="@Model.ImageUrl" class="w-100 rounded-2" onerror="this.src='https://placehold.co/100x100'"></div></div>
                    <div class="col-3"><div class="border rounded-3 p-1 cursor-pointer hover-shadow opacity-50"><img src="@Model.ImageUrl" class="w-100 rounded-2" onerror="this.src='https://placehold.co/100x100'"></div></div>
                    <div class="col-3"><div class="border rounded-3 p-1 cursor-pointer hover-shadow opacity-50"><img src="@Model.ImageUrl" class="w-100 rounded-2" onerror="this.src='https://placehold.co/100x100'"></div></div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <h1 class="product-title mb-2">@Model.Name</h1>

            <div class="d-flex align-items-center gap-3 mb-4 text-warning small">
                <div class="d-flex">
                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                </div>
                <span class="text-muted border-start ps-3 ms-2">Đã bán: <b>@Model.Sold</b></span>
                <span class="text-muted border-start ps-3">Tình trạng: <span class="text-success fw-bold">Còn hàng</span></span>
            </div>

            <div class="price-box mb-4">
                <span id="displayPrice" class="current-price">
                    @(defaultVariant != null ? defaultVariant.Price.ToString("#,##0", culture) : "Liên hệ")₫
                </span>
                @if (Model.DiscountRate > 0 && defaultVariant != null)
                {
                    var oldPrice = defaultVariant.Price / (1 - (decimal)Model.DiscountRate / 100);
                    <span class="old-price">@oldPrice.ToString("#,##0", culture)₫</span>
                    <span class="discount-tag">-@Model.DiscountRate%</span>
                }
            </div>

            @if (variants.Any())
            {
                <div class="mb-4">
                    <label class="option-label">Dung lượng bộ nhớ</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var rom in uniqueRoms)
                        {
                            var isActive = defaultVariant != null && defaultVariant.Rom == rom ? "active" : "";
                            <button type="button" class="btn-option btn-rom @isActive" data-value="@rom" onclick="selectRom(this)">@rom</button>
                        }
                    </div>
                </div>

                <div class="mb-4">
                    <label class="option-label">Màu sắc</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var color in uniqueColors)
                        {
                            var isActive = defaultVariant != null && defaultVariant.Color == color ? "active" : "";
                            <button type="button" class="btn-option btn-color @isActive" data-value="@color" onclick="selectColor(this)">@color</button>
                        }
                    </div>
                </div>

                <div class="d-flex align-items-end gap-3 mb-4">
                    <div>
                        <label class="option-label">Số lượng</label>
                        <div class="qty-control">
                            <button class="qty-btn" onclick="updateQty(-1)">-</button>
                            <input type="text" id="input-quantity" value="1" class="qty-input" readonly>
                            <button class="qty-btn" onclick="updateQty(1)">+</button>
                        </div>
                    </div>
                    <input type="hidden" id="selectedProductDetailId" value="@(defaultVariant?.Id)" />
                    <button type="button" id="btnAddToCart" class="btn btn-primary btn-lg rounded-3 flex-grow-1 py-2 fw-bold shadow-sm" style="height: 50px;" onclick="addToCartFromDetails()">
                        <i class="bi bi-cart-plus me-2"></i> THÊM VÀO GIỎ NGAY
                    </button>
                </div>
            }
            else
            {
                <div class="alert alert-warning">Sản phẩm đang tạm hết hàng.</div>
            }

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="promo-box h-100">
                        <div class="promo-header text-danger bg-danger bg-opacity-10"><i class="bi bi-gift-fill"></i> Ưu đãi thêm</div>
                        <div class="promo-content">
                            <div class="promo-item"><span class="promo-number">1</span> <span>Giảm thêm 5% tối đa 300k khi thanh toán qua Kredivo.</span></div>
                            <div class="promo-item"><span class="promo-number">2</span> <span>Tặng gói iCloud 50GB miễn phí 3 tháng.</span></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="promo-box h-100">
                        <div class="promo-header text-primary bg-primary bg-opacity-10"><i class="bi bi-shield-check"></i> Yên tâm mua sắm</div>
                        <div class="promo-content">
                            <div class="promo-item"><i class="bi bi-check-circle-fill text-success mt-1"></i> <span>Bảo hành chính hãng 12 tháng.</span></div>
                            <div class="promo-item"><i class="bi bi-arrow-repeat text-primary mt-1"></i> <span>Lỗi là đổi mới trong 30 ngày.</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="bg-white p-4 rounded-4 shadow-sm border mb-4">
                <h4 class="fw-bold mb-4 pb-3 border-bottom text-uppercase fs-6 text-muted">Chi tiết sản phẩm</h4>
                <div class="text-muted" style="line-height: 1.8; font-size: 1rem;">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        @Html.Raw(Model.Description.Replace("\n", "<br>"))
                    }
                    else
                    {

                        <p>Đang cập nhật thông tin...</p>
                    }
                </div>
            </div>

            <div class="bg-white p-4 rounded-4 shadow-sm border mb-4">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h5 class="fw-bold m-0"><i class="bi bi-newspaper me-2 text-primary"></i>Tin tức về sản phẩm</h5>
                    <a href="#" class="text-decoration-none small fw-bold">Xem tất cả</a>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="news-item">
                            <img src="https://placehold.co/400x250/f1f5f9/94a3b8?text=Review" alt="News 1" class="mb-2">
                            <a href="#" class="news-title text-dark text-decoration-none hover-primary">Đánh giá chi tiết hiệu năng chơi game trên thiết bị này</a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="news-item">
                            <img src="https://placehold.co/400x250/f1f5f9/94a3b8?text=Tips" alt="News 2" class="mb-2">
                            <a href="#" class="news-title text-dark text-decoration-none hover-primary">5 mẹo hay giúp tối ưu thời lượng pin bạn nên biết</a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="news-item">
                            <img src="https://placehold.co/400x250/f1f5f9/94a3b8?text=Compare" alt="News 3" class="mb-2">
                            <a href="#" class="news-title text-dark text-decoration-none hover-primary">So sánh với phiên bản tiền nhiệm: Có đáng nâng cấp?</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="bg-white p-4 rounded-4 shadow-sm border mb-4">
                <h5 class="fw-bold mb-4">Đánh giá & Nhận xét</h5>
                <div class="d-flex align-items-center mb-4">
                    <div class="rating-box pe-3 me-3">
                        <div class="rating-score">4.8</div>
                        <div class="text-warning small"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></div>
                        <div class="text-muted small mt-1">125 đánh giá</div>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-1"><span class="small text-muted">5 <i class="bi bi-star-fill"></i></span> <div class="progress flex-grow-1"><div class="progress-bar" style="width: 80%"></div></div></div>
                        <div class="d-flex align-items-center gap-2 mb-1"><span class="small text-muted">4 <i class="bi bi-star-fill"></i></span> <div class="progress flex-grow-1"><div class="progress-bar" style="width: 15%"></div></div></div>
                        <div class="d-flex align-items-center gap-2"><span class="small text-muted">3 <i class="bi bi-star-fill"></i></span> <div class="progress flex-grow-1"><div class="progress-bar" style="width: 5%"></div></div></div>
                    </div>
                </div>

                <div class="review-list">
                    <div class="review-item">
                        <div class="d-flex gap-3 mb-2">
                            <div class="avatar-circle">H</div>
                            <div>
                                <div class="fw-bold small">Hoàng Minh</div>
                                <div class="text-warning x-small" style="font-size: 0.75rem;"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></div>
                            </div>
                            <small class="ms-auto text-muted" style="font-size: 0.75rem;">2 ngày trước</small>
                        </div>
                        <p class="small text-secondary mb-0 bg-light p-2 rounded">Sản phẩm rất đẹp, giao hàng nhanh, đóng gói cẩn thận. Rất hài lòng!</p>
                    </div>
                    <div class="review-item">
                        <div class="d-flex gap-3 mb-2">
                            <div class="avatar-circle bg-warning text-white">T</div>
                            <div>
                                <div class="fw-bold small">Trần Ngọc</div>
                                <div class="text-warning x-small" style="font-size: 0.75rem;"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i></div>
                            </div>
                            <small class="ms-auto text-muted" style="font-size: 0.75rem;">1 tuần trước</small>
                        </div>
                        <p class="small text-secondary mb-0 bg-light p-2 rounded">Máy dùng ổn, pin trâu nhưng camera chụp đêm chưa thực sự xuất sắc.</p>
                    </div>
                </div>
                <button class="btn btn-outline-primary w-100 rounded-pill btn-sm mt-2 fw-bold">Xem tất cả đánh giá</button>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold text-uppercase m-0 text-dark">Sản phẩm liên quan</h4>
            <a href="#" class="btn btn-outline-secondary rounded-pill btn-sm px-3">Xem thêm</a>
        </div>
        <div class="row row-cols-2 row-cols-md-4 g-3">
            @for (int i = 0; i < 4; i++)
            {
                <div class="col">
                    <div class="related-card h-100">
                        <img src="https://placehold.co/300x300/f8fafc/cbd5e1?text=Product+@(i + 1)" class="related-img" alt="Rel">
                        <div class="p-3">
                            <h6 class="fw-bold text-dark mb-1 text-truncate">Sản phẩm gợi ý @(i + 1)</h6>
                            <div class="text-danger fw-bold">15.990.000₫</div>
                            <div class="d-flex align-items-center gap-1 mt-2">
                                <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">Giảm 10%</span>
                                <small class="text-muted ms-auto" style="font-size: 0.7rem;">Đã bán 50</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var allVariants = @Html.Raw(Json.Serialize(variants));
        var currentRom = "@(defaultVariant?.Rom)";
        var currentColor = "@(defaultVariant?.Color)";

        function formatCurrency(amount) { return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount); }

        function selectRom(btn) {
            document.querySelectorAll('.btn-rom').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentRom = btn.getAttribute('data-value');
            updateProductInfo();
        }

        function selectColor(btn) {
            document.querySelectorAll('.btn-color').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentColor = btn.getAttribute('data-value');
            updateProductInfo();
        }

        function updateProductInfo() {
            var foundVariant = allVariants.find(v => v.rom === currentRom && v.color === currentColor);
            var btnAdd = document.getElementById('btnAddToCart');
            var priceDisplay = document.getElementById('displayPrice');
            var inputId = document.getElementById('selectedProductDetailId');

            if (foundVariant) {
                priceDisplay.innerText = formatCurrency(foundVariant.price);
                inputId.value = foundVariant.id;
                btnAdd.disabled = false;
                btnAdd.innerHTML = '<i class="bi bi-cart-plus me-2"></i> THÊM VÀO GIỎ NGAY';
                btnAdd.classList.replace('btn-secondary', 'btn-primary');
            } else {
                priceDisplay.innerText = "Liên hệ";
                inputId.value = "";
                btnAdd.disabled = true;
                btnAdd.innerText = "TẠM HẾT HÀNG";
                btnAdd.classList.replace('btn-primary', 'btn-secondary');
            }
        }

        function updateQty(change) {
            var input = document.getElementById('input-quantity');
            var currentVal = parseInt(input.value) || 1;
            var newVal = currentVal + change;
            if (newVal < 1) newVal = 1;
            if (newVal > 50) newVal = 50;
            input.value = newVal;
        }

        function addToCartFromDetails() {
            var detailId = $('#selectedProductDetailId').val();
            var qty = $('#input-quantity').val();
            if (!detailId) { alert("Vui lòng chọn phiên bản sản phẩm!"); return; }

            flyToCartAnimation();
            $.ajax({
                url: '/Cart/AddToCart',
                type: 'POST',
                data: { productDetailId: detailId, quantity: qty },
                success: function (res) {
                    if (res.success) {
                        var badge = $('#cart-badge');
                        badge.text(res.cartCount);
                        badge.removeClass('d-none');
                    }
                },
                error: function () { window.location.href = '/Identity/Account/Login'; }
            });
        }

        function flyToCartAnimation() {
            var cartIcon = $('.btn-cart');
            var productImg = $('#main-product-img');
            if (cartIcon.length && productImg.length) {
                var flyImg = productImg.clone()
                    .offset({ top: productImg.offset().top, left: productImg.offset().left })
                    .addClass('flying-img')
                    .css({ 'width': '200px', 'height': '200px', 'object-fit': 'cover' })
                    .appendTo($('body'));

                flyImg.animate({
                    'top': cartIcon.offset().top + 10,
                    'left': cartIcon.offset().left + 10,
                    'width': '20px', 'height': '20px', 'opacity': '0.5'
                }, 800, 'swing', function () {
                    $(this).remove();
                    cartIcon.addClass('shake-cart');
                    setTimeout(() => cartIcon.removeClass('shake-cart'), 500);
                });
            }
        }
    </script>
}