@using System.Globalization
@model _204Store.Models.ViewModels.HomeViewModel
@{
    bool isFiltering = (bool)(ViewData["IsFiltering"] ?? false);
    ViewData["Title"] = ViewData["PageTitle"];
    var culture = new CultureInfo("vi-VN");}

<style>
    :root {

        --bg-light: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #1e293b;
        --text-sub: #64748b;
        --accent: #4f46e5;
        --accent-hover: #4338ca;
    }

    .hover-float {
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

        .hover-float:hover {
            transform: translateY(-4px);
        }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 25px;
    }

    .section-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--text-main);
        letter-spacing: -0.5px;
    }

    .btn-view-all {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-sub);
        padding: 6px 12px;
        border-radius: 20px;
        background: #f1f5f9;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-view-all:hover {
            background: var(--accent);
            color: white;
        }

    .product-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s ease;
        height: 100%;
        border: 1px solid #f1f5f9;
        box-shadow: 0 1px 2px rgba(0,0,0,0.03);
        position: relative;
        display: flex;
        flex-direction: column;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08);
            border-color: #e2e8f0;
        }

    .card-img-wrap {
        position: relative;
        padding-top: 100%;
        background-color: #fff;
        overflow: hidden;
    }

        .card-img-wrap img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 25px;
            transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

    .product-card:hover .card-img-wrap img {
        transform: scale(1.05);
    }

    .badge-float {
        position: absolute;
        top: 10px;
        left: 10px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        z-index: 2;
        background: #ef4444;
        color: white;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .card-info {
        padding: 15px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .cat-tag {
        font-size: 0.75rem;
        color: #94a3b8;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .prod-name {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-main);
        line-height: 1.4;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 2.8em;
    }

    .price-box {
        display: flex;
        align-items: baseline;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: auto;
    }

    .price-current {
        font-size: 1.1rem;
        font-weight: 800;
        color: #ef4444;
    }

    .price-old {
        font-size: 0.85rem;
        color: #94a3b8;
        text-decoration: line-through;
    }

    .product-actions {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 15px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(4px);
        transform: translateY(100%);
        transition: transform 0.3s ease;
        display: flex;
        gap: 8px;
        border-top: 1px solid #f1f5f9;
    }

    .product-card:hover .product-actions {
        transform: translateY(0);
    }

    .btn-action-cart {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: var(--text-main);
        transition: 0.2s;
        cursor: pointer;
    }

        .btn-action-cart:hover {
            background: var(--accent);
            color: white;
            border-color: var(--accent);
        }

    .btn-action-buy {
        flex-grow: 1;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: var(--text-main);
        color: white;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-action-buy:hover {
            background: var(--accent);
            color: white;
        }

    .flying-img {
        position: fixed;
        z-index: 9999;
        border-radius: 50%;
        border: 2px solid var(--accent);
        opacity: 0.8;
        pointer-events: none;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    @@keyframes shake-cart {
        0%, 100% {
            transform: rotate(0deg);
        }

        25% {
            transform: rotate(-10deg);
        }

        75% {
            transform: rotate(10deg);
        }
    }

    .shake-cart {
        animation: shake-cart 0.4s ease-in-out;
        color: var(--accent) !important;
    }
</style>

@if (isFiltering)
{
    <div class="container mt-4 mb-5">
        <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small text-muted">
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Danh sách sản phẩm</li>
                    </ol>
                </nav>
                <h3 class="fw-bold text-main mb-0">@ViewData["PageTitle"]</h3>
                <p class="text-muted small mt-1 mb-0">Tìm thấy @Model.FeaturedProducts.Count() sản phẩm</p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="small fw-bold text-muted">Sắp xếp:</span>
                <select class="form-select form-select-sm border-0 bg-light fw-bold" style="width: 140px;">
                    <option>Mới nhất</option>
                    <option>Giá tăng dần</option>
                    <option>Giá giảm dần</option>
                </select>
            </div>
        </div>

        @if (Model.FeaturedProducts.Any())
        {
            <div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-3">
                @foreach (var item in Model.FeaturedProducts)
                {
                    await RenderProductCard(item);
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="120" class="opacity-50 mb-3" />
                <h5 class="fw-bold text-secondary">Không tìm thấy sản phẩm nào</h5>
                <p class="text-muted">Thử chọn danh mục khác hoặc tìm kiếm với từ khóa khác xem sao.</p>
                <a asp-action="Index" class="btn btn-primary rounded-pill px-4">Về trang chủ</a>
            </div>
        }
    </div>
}
else
{
    <section class="container mt-4 mb-5">
        <div class="row g-4">
            <div class="col-lg-8">
                <div id="heroCarousel" class="carousel slide hero-container rounded-4 overflow-hidden shadow-sm" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
                    </div>
                    <div class="carousel-inner">
                        <div class="carousel-item active" data-bs-interval="3500">
                            <img src="https://image.dienthoaivui.com.vn/x,webp,q90/https://dashboard.dienthoaivui.com.vn/uploads/dashboard/editor_upload/hinh-anh-iphone-17-pro-max-01.jpg" class="hero-img w-100 object-fit-cover" style="height: 400px;" alt="Banner 1">
                        </div>
                        <div class="carousel-item" data-bs-interval="3500">
                            <img src="https://clickbuy.com.vn/uploads/images/tin%20tuc/ip14/macbook-air-m4-series-co-gi-noi-bat.jpg" class="hero-img w-100 object-fit-cover" style="height: 400px;" alt="Banner 2">
                        </div>
                        <div class="carousel-item" data-bs-interval="3500">
                            <img src="https://png.pngtree.com/thumb_back/fw800/background/20220209/pngtree-flash-sale-30-percent-off-wide-banner-background-image_985893.jpg" class="hero-img w-100 object-fit-cover" style="height: 400px;" alt="Banner 3">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-flex flex-column gap-3">
                <a href="#" class="h-50 overflow-hidden rounded-4"><img src="https://cdn.tgdd.vn/Files/2017/07/20/1004912/banner_1200x628-800-resize.jpg" class="w-100 h-100 object-fit-cover hover-scale" alt="Sub 1"></a>
                <a href="#" class="h-50 overflow-hidden rounded-4"><img src="https://file.hstatic.net/1000329106/file/thu_doi_web_85f4d23b5df94f4fbe073cc02264b4dc_1024x1024.jpg" class="w-100 h-100 object-fit-cover hover-scale" alt="Sub 2"></a>
            </div>
        </div>
    </section>

    <section class="container mb-5">
        <div class="section-header">
            <h3 class="section-title">Danh mục nổi bật</h3>
        </div>
        <div class="row row-cols-3 row-cols-md-6 g-3">
            @foreach (var cat in Model.Categories.Where(c => c.ParentId == null).Take(6))
            {
                <div class="col">
                    <a asp-action="Index" asp-route-category="@cat.Id" class="d-flex flex-column align-items-center p-3 bg-white rounded-4 border text-decoration-none shadow-sm h-100 hover-float">
                        <span class="fs-1 text-primary mb-2">
                            @if (!string.IsNullOrEmpty(cat.ImageUrl))
                            {
                                <img src="@cat.ImageUrl" class="rounded-circle object-fit-cover" width="40" height="40" />
                            }
                            else if (!string.IsNullOrEmpty(cat.Icon))
                            {
                                <i class="@cat.Icon"></i>
                            }
                            else
                            {
                                <i class="bi bi-grid"></i>
                            }
                        </span>
                        <span class="fw-bold text-dark small text-center">@cat.Name</span>
                    </a>
                </div>
            }
        </div>
    </section>

    @if (Model.SaleProducts.Any())
    {
        <section class="container mb-5">
            <div class="p-4 rounded-4" style="background: linear-gradient(135deg, #fff1f2 0%, #fff 100%); border: 1px solid #ffe4e6;">
                <div class="section-header">
                    <div class="d-flex align-items-center gap-2">
                        <h3 class="section-title text-danger mb-0"><i class="bi bi-lightning-fill"></i> FLASH SALE</h3>
                        <span class="badge bg-danger">02:30:15</span>
                    </div>
                    <a href="#" class="btn-view-all">Xem tất cả</a>
                </div>
                <div class="row row-cols-2 row-cols-md-5 g-3">
                    @foreach (var item in Model.SaleProducts.Take(5))
                    {
                        await RenderProductCard(item);
                    }
                </div>
            </div>
        </section>
    }

    @if (Model.FeaturedProducts.Any())
    {
        <section class="container mb-5">
            <div class="section-header">
                <h3 class="section-title">Gợi ý cho bạn</h3>
                <a href="#" class="btn-view-all">Xem tất cả</a>
            </div>
            <div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-3">
                @foreach (var item in Model.FeaturedProducts.Take(10))
                {
                    await RenderProductCard(item);
                }
            </div>
        </section>
    }
}

@{
    async Task RenderProductCard(_204Store.Models.Product item)
    {
        var culture = new CultureInfo("vi-VN");
        decimal minPrice = 0;
        int defaultDetailId = 0;
        bool hasPrice = false;

        if (item.ProductDetails != null && item.ProductDetails.Any())
        {
            var defaultVariant = item.ProductDetails.OrderBy(x => x.Price).FirstOrDefault();
            if (defaultVariant != null)
            {
                minPrice = (decimal)defaultVariant.Price;
                defaultDetailId = defaultVariant.Id;
                hasPrice = true;
            }
        }
        decimal discountRate = (decimal)item.DiscountRate;
        decimal finalPrice = minPrice * (1 - discountRate / 100);

        <div class="col">
            <div class="product-card" id="card-@item.Id">
                <div class="card-img-wrap">
                    <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id">
                        <img src="@item.ImageUrl" id="img-@item.Id" alt="@item.Name" onerror="this.src='https://placehold.co/300x300/f1f5f9/cbd5e1?text=NO+IMAGE'" />
                    </a>
                    @if (discountRate > 0)
                    {
                        <span class="badge-float">-@Math.Round(discountRate, 0)%</span>
                    }
                </div>

                <div class="card-info">
                    <div class="cat-tag">@(item.Category?.Name ?? "Sản phẩm")</div>
                    <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id" class="text-decoration-none">
                        <h6 class="prod-name" title="@item.Name">@item.Name</h6>
                    </a>
                    <div class="price-box">
                        @if (hasPrice)
                        {
                            <span class="price-current">@finalPrice.ToString("#,##0", culture)₫</span>
                            @if (discountRate > 0)
                            {
                                <span class="price-old">@minPrice.ToString("#,##0", culture)₫</span>
                            }
                        }
                        else
                        {
                            <span class="text-primary fw-bold small">Liên hệ</span>
                        }
                    </div>
                </div>

                <div class="product-actions">
                    @if (hasPrice)
                    {
                        <button type="button" class="btn-action-cart" title="Thêm vào giỏ" onclick="addToCartAjax(@defaultDetailId, @item.Id)">
                            <i class="bi bi-bag-plus-fill fs-5"></i>
                        </button>
                        <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id" class="btn-action-buy">Mua ngay</a>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id" class="btn-action-buy w-100">Xem chi tiết</a>
                    }
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        function addToCartAjax(productDetailId, productId) {
            flyToCart(productId);
            $.ajax({
                url: '/Cart/AddToCart',
                type: 'POST',
                data: { productDetailId: productDetailId, quantity: 1 },
                success: function (response) {
                    if (response.success) {
                        var badge = $('#cart-badge');
                        if(badge.length) { badge.text(response.cartCount); badge.removeClass('d-none'); }
                    }
                },
                error: function () { window.location.href = '/Identity/Account/Login'; }
            });
        }

        function flyToCart(productId) {
            var cartIcon = $('.icon-btn[title="Giỏ hàng"]');
            if(cartIcon.length === 0) cartIcon = $('.btn-cart');
            if(cartIcon.length === 0) return;

            var productImg = $('#img-' + productId);
            if(productImg.length === 0) return;

            var flyImg = productImg.clone().addClass('flying-img')
                .offset({ top: productImg.offset().top, left: productImg.offset().left })
                .css({ 'opacity': '0.8', 'position': 'absolute', 'height': '150px', 'width': '150px', 'z-index': '9999', 'object-fit': 'cover' })
                .appendTo($('body'));

            flyImg.animate({
                'top': cartIcon.offset().top + 10,
                'left': cartIcon.offset().left + 10,
                'width': '20px', 'height': '20px', 'opacity': '0.5'
            }, 800, 'swing', function () {
                $(this).remove();
                cartIcon.addClass('shake-cart');
                setTimeout(function(){ cartIcon.removeClass('shake-cart'); }, 500);
            });
        }
    </script>
}