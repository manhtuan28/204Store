@using System.Globalization
@model IEnumerable<_204Store.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
    var culture = new CultureInfo("vi-VN");
}

<div id="mainCarousel" class="carousel slide shadow rounded-4 overflow-hidden mb-5" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active" data-bs-interval="3000">
            <img src="https://placehold.co/1200x400/4f46e5/white?text=iPhone+15+Pro+Max+-+Titan+Tu+Nhien" class="d-block w-100" alt="Banner 1">
        </div>
        <div class="carousel-item" data-bs-interval="3000">
            <img src="https://placehold.co/1200x400/10b981/white?text=Macbook+Air+M3+-+Sieu+Mong+Nhe" class="d-block w-100" alt="Banner 2">
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-end mb-4 px-2">
    <div>
        <h3 class="fw-bold text-dark m-0">Sản phẩm nổi bật</h3>
        <p class="text-muted small m-0">Săn sale giá sốc mỗi ngày</p>
    </div>
    <a href="#" class="text-decoration-none fw-bold small text-primary">
        Xem tất cả <i class="bi bi-arrow-right"></i>
    </a>
</div>

<div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3 mb-5">
    @foreach (var item in Model)
    {
        double minPrice = 0;
        double maxPrice = 0;
        bool hasPrice = false;

        if (item.ProductDetails != null && item.ProductDetails.Any())
        {
            minPrice = item.ProductDetails.Min(x => x.Price);
            maxPrice = item.ProductDetails.Max(x => x.Price);
            hasPrice = true;
        }

        <div class="col">
            <div class="card h-100 product-card rounded-3 border-0">
                <div class="product-image-container">
                    <span class="badge-sale">-15%</span>
                    <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id">
                        <img src="@item.ImageUrl" alt="@item.Name" onerror="this.src='https://placehold.co/200x200?text=No+Image'" />
                    </a>
                </div>

                <div class="card-body p-3 d-flex flex-column">
                    <div class="small text-muted mb-1" style="font-size: 0.75rem;">@item.Category?.Name</div>

                    <h6 class="product-title" title="@item.Name">
                        <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id" class="text-dark text-decoration-none">
                            @item.Name
                        </a>
                    </h6>

                    <div class="mt-auto">
                        @if (hasPrice)
                        {
                            <div class="product-price">
                                @minPrice.ToString("#,##0", culture)₫
                            </div>
                            @if (minPrice != maxPrice)
                            {
                                <div class="text-muted small" style="font-size: 0.8rem;">
                                    Đến: @maxPrice.ToString("#,##0", culture)₫
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted fst-italic small">Liên hệ</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
}