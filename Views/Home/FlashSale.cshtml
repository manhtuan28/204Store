@using System.Globalization
@model IEnumerable<_204Store.Models.Product>
@{
    ViewData["Title"] = ViewData["PageTitle"] ?? "Flash Sale";
}

<style>
    :root {
        --primary-color: #4f46e5;
        --danger-color: #ef4444;
        --card-bg: #ffffff;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow-hover: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        --radius-lg: 16px;
    }

    body {
        background-color: #f8fafc;
    }

    .product-card {
        background: var(--card-bg);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        border: 1px solid transparent;
        box-shadow: var(--shadow-sm);
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .product-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow-hover);
        border-color: rgba(79, 70, 229, 0.1);
    }

    .card-img-wrap {
        position: relative;
        padding-top: 100%;
        background-color: #fff;
        overflow: hidden;
    }

    .card-img-wrap img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 20px;
        transition: transform 0.5s;
    }

    .product-card:hover .card-img-wrap img {
        transform: scale(1.08);
    }

    .badge-float {
        position: absolute;
        top: 12px;
        left: 12px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        z-index: 2;
        background: var(--danger-color);
        color: white;
    }

    .card-info {
        padding: 16px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        border-top: 1px solid #f1f5f9;
    }

    .cat-tag {
        font-size: 0.7rem;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .prod-name {
        font-size: 1rem;
        font-weight: 600;
        color: #0f172a;
        line-height: 1.5;
        margin-bottom: 12px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 3em;
        transition: color 0.2s;
    }

    .product-card:hover .prod-name {
        color: var(--primary-color);
    }

    .price-box {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-top: auto;
    }

    .price-current {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--danger-color);
    }

    .price-old {
        font-size: 0.85rem;
        color: #94a3b8;
        text-decoration: line-through;
        font-weight: 500;
    }

    .product-actions {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(8px);
        transform: translateY(101%);
        transition: transform 0.3s;
        display: flex;
        gap: 10px;
    }

    .product-card:hover .product-actions {
        transform: translateY(0);
    }

    .btn-action-cart {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #0f172a;
        transition: all 0.2s;
        cursor: pointer;
    }

    .btn-action-cart:hover {
        background: var(--primary-color);
        color: white;
    }

    .btn-action-buy {
        flex-grow: 1;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #0f172a;
        color: white;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-action-buy:hover {
        background: var(--primary-color);
        color: white;
    }
    
    .flying-img {
        position: fixed;
        z-index: 9999;
        border-radius: 50%;
        border: 2px solid var(--primary-color);
        opacity: 0.8;
        pointer-events: none;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    @@keyframes shake-cart {
        0%, 100% { transform: rotate(0deg); }
        25% { transform: rotate(-10deg); }
        75% { transform: rotate(10deg); }
    }

    .shake-cart {
        animation: shake-cart 0.4s ease-in-out;
        color: var(--primary-color) !important;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="p-1 rounded-4 position-relative overflow-hidden mb-4" style="background: linear-gradient(45deg, #ff0055, #ffcc00, #4f46e5); box-shadow: 0 10px 25px -5px rgba(255, 0, 85, 0.3);">
        <div class="bg-white p-4 rounded-4 h-100 text-center py-5">
            <h2 class="section-title text-danger mb-4 fst-italic justify-content-center mx-auto d-inline-block fw-bold" style="text-shadow: 2px 2px 0px rgba(0,0,0,0.05); font-size: 2.2rem;">
                <i class="bi bi-lightning-charge-fill me-2"></i>FLASH SALE NGÀY HÔM NAY<i class="bi bi-lightning-charge-fill ms-2"></i>
            </h2>
            <div class="d-flex gap-2 align-items-center justify-content-center" id="flash-sale-timer">
                <span class="fs-6 fw-bold text-muted me-2 text-uppercase letter-spacing-1">Kết thúc trong:</span>
                <span id="fs-days" class="badge bg-danger text-white p-2 px-3 rounded-3 shadow-sm font-monospace fs-4">00</span>
                <span class="fs-4 fw-bold text-danger">:</span>
                <span id="fs-hours" class="badge bg-danger text-white p-2 px-3 rounded-3 shadow-sm font-monospace fs-4">00</span>
                <span class="fs-4 fw-bold text-danger">:</span>
                <span id="fs-minutes" class="badge bg-danger text-white p-2 px-3 rounded-3 shadow-sm font-monospace fs-4">00</span>
                <span class="fs-4 fw-bold text-danger">:</span>
                <span id="fs-seconds" class="badge bg-danger text-white p-2 px-3 rounded-3 shadow-sm font-monospace fs-4">00</span>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-4">
            @foreach (var item in Model)
            {
                await RenderProductCard(item);
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-4 border border-dashed shadow-sm mt-4">
            <i class="bi bi-cart-x fs-1 text-muted opacity-50 mb-3 d-block"></i>
            <h5 class="fw-bold text-secondary">Chưa có sản phẩm Flash Sale nào!</h5>
            <p class="text-muted small">Vui lòng quay lại sau.</p>
        </div>
    }
</div>

@{
    async Task RenderProductCard(_204Store.Models.Product item)
    {
        var culture = new CultureInfo("vi-VN");
        decimal minPrice = 0;
        int defaultDetailId = 0;
        bool hasPrice = false;
        if (item.ProductDetails != null && item.ProductDetails.Any())
        {
            var defaultVariant = item.ProductDetails.OrderBy(x => x.Price).FirstOrDefault();
            if (defaultVariant != null)
            {
                minPrice = (decimal)defaultVariant.Price;
                defaultDetailId = defaultVariant.Id;
                hasPrice = true;
            }
        }
        decimal discountRate = (decimal)item.DiscountRate;
        decimal finalPrice = minPrice * (1 - discountRate / 100);

        string categoryName = "Sản phẩm";
        if (item.ProductCategories != null && item.ProductCategories.Any())
        {
            categoryName = item.ProductCategories.FirstOrDefault()?.Category?.Name ?? "Sản phẩm";
        }
        else if (item.Category != null)
        {
            categoryName = item.Category.Name;
        }

        <div class="col">
            <div class="product-card" id="card-@item.Id">
                <div class="card-img-wrap">
                    <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id" class="d-block w-100 h-100">
                        <img src="@item.ImageUrl" id="img-@item.Id" alt="@item.Name" loading="lazy" onerror="this.src='https://placehold.co/300x300/f1f5f9/cbd5e1?text=NO+IMAGE'" />
                    </a>
                    @if (discountRate > 0)
                    {
                        <span class="badge-float">-@Math.Round(discountRate, 0)%</span>
                    }
                </div>

                <div class="card-info">
                    <div class="cat-tag">@categoryName</div>
                    <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id" class="text-decoration-none">
                        <h6 class="prod-name" title="@item.Name">@item.Name</h6>
                    </a>
                    <div class="price-box">
                        @if (hasPrice)
                        {
                            <span class="price-current">@finalPrice.ToString("#,##0", culture)₫</span>
                            @if (discountRate > 0)
                            {
                                <span class="price-old">@minPrice.ToString("#,##0", culture)₫</span>
                            }
                        }
                        else
                        {
                            <span class="text-primary fw-bold small">Liên hệ</span>
                        }
                    </div>
                </div>

                <div class="product-actions">
                    @if (hasPrice)
                    {
                        <button type="button" class="btn-action-cart shadow-sm" title="Thêm vào giỏ" onclick="addToCartAjax(@defaultDetailId, @item.Id)">
                            <i class="bi bi-bag-plus-fill fs-5"></i>
                        </button>
                        <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id" class="btn-action-buy shadow-sm">Mua ngay</a>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Details" asp-route-productId="@item.Id" class="btn-action-buy w-100 shadow-sm">Xem chi tiết</a>
                    }
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        function addToCartAjax(productDetailId, productId) {
            flyToCart(productId);
            $.ajax({
                url: '/Cart/AddToCart',
                type: 'POST',
                data: { productDetailId: productDetailId, quantity: 1 },
                success: function (response) {
                    if (response.success) {
                        var badge = $('#cart-badge');
                        if(badge.length) { badge.text(response.cartCount); badge.removeClass('d-none'); }
                    }
                },
                error: function () { window.location.href = '/Identity/Account/Login'; }
            });
        }

        function flyToCart(productId) {
            var cartIcon = $('.icon-btn[title="Giỏ hàng"]');
            if(cartIcon.length === 0) cartIcon = $('.btn-cart');
            if(cartIcon.length === 0) return;

            var productImg = $('#img-' + productId);
            if(productImg.length === 0) return;

            var flyImg = productImg.clone().addClass('flying-img')
                .offset({ top: productImg.offset().top, left: productImg.offset().left })
                .css({ 'opacity': '0.8', 'position': 'absolute', 'height': '150px', 'width': '150px', 'z-index': '9999', 'object-fit': 'cover' })
                .appendTo($('body'));

            flyImg.animate({
                'top': cartIcon.offset().top + 10,
                'left': cartIcon.offset().left + 10,
                'width': '20px', 'height': '20px', 'opacity': '0.5'
            }, 800, 'swing', function () {
                $(this).remove();
                cartIcon.addClass('shake-cart');
                setTimeout(function(){ cartIcon.removeClass('shake-cart'); }, 500);
            });
        }

        function startFlashSaleTimer() {
            var endTimeStr = '@Html.Raw(ViewBag.FlashSaleEndTime)';
            var endOfDay;
            
            if (endTimeStr) {
                endOfDay = new Date(endTimeStr);
            } else {
                endOfDay = new Date();
                endOfDay.setHours(23, 59, 59, 999);
            }
            
            setInterval(function() {
                var now = new Date();
                var diff = endOfDay - now;
                if (diff < 0) diff = 0;
                
                var d = Math.floor(diff / (1000 * 60 * 60 * 24));
                var h = Math.floor((diff / (1000 * 60 * 60)) % 24);
                var m = Math.floor((diff / 1000 / 60) % 60);
                var s = Math.floor((diff / 1000) % 60);

                var daysEl = document.getElementById('fs-days');
                if(daysEl) daysEl.innerText = d.toString().padStart(2, '0');

                var hoursEl = document.getElementById('fs-hours');
                if(hoursEl) {
                    hoursEl.innerText = h.toString().padStart(2, '0');
                    document.getElementById('fs-minutes').innerText = m.toString().padStart(2, '0');
                    document.getElementById('fs-seconds').innerText = s.toString().padStart(2, '0');
                }
            }, 1000);
        }
        
        $(document).ready(function() {
            startFlashSaleTimer();
        });
    </script>
}
