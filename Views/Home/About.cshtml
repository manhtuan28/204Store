@{
    ViewData["Title"] = "Về chúng tôi";
}

<style>
    .about-hero {
        background: url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-1.2.1&auto=format&fit=crop&w=1920&q=80') no-repeat center center;
        background-size: cover;
        height: 400px;
        position: relative;
        border-radius: 0 0 50px 50px;
        margin-bottom: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .about-hero::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            background: rgba(15, 23, 42, 0.8);
            border-radius: 0 0 50px 50px;
        }

    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        color: white;
        max-width: 800px;
        padding: 20px;
    }

    .value-card {
        text-align: center;
        padding: 40px 20px;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        transition: transform 0.3s;
        height: 100%;
    }

        .value-card:hover {
            transform: translateY(-10px);
        }

    .vc-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 25px;
        background: #eef2ff;
        color: #4f46e5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    .stats-section {
        background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
        color: white;
        padding: 60px 0;
        border-radius: 30px;
        margin: 60px 0;
    }

    .team-card img {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 50%;
        border: 5px solid #fff;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }
</style>

<div class="container-fluid px-0">
    <div class="about-hero">
        <div class="hero-content">
            <h1 class="fw-bold display-4 mb-3">Câu chuyện của 204Store</h1>
            <p class="fs-5 opacity-75">
                Từ một cửa hàng nhỏ năm 2024 đến hệ thống bán lẻ công nghệ hàng đầu.
                Chúng tôi không chỉ bán sản phẩm, chúng tôi mang đến giải pháp công nghệ.
            </p>
        </div>
    </div>
</div>

<div class="container">
    <div class="row align-items-center mb-5 pb-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?ixlib=rb-1.2.1&auto=format&fit=crop&w=1000&q=80"
                 class="img-fluid rounded-4 shadow-lg" alt="Office 204Store">
        </div>
        <div class="col-lg-6 ps-lg-5">
            <h6 class="text-primary fw-bold text-uppercase ls-1">Về chúng tôi</h6>
            <h2 class="fw-bold mb-4">Sứ mệnh nâng tầm trải nghiệm số</h2>
            <p class="text-muted lead">
                Được thành lập vào năm 2024 bởi những người trẻ đam mê công nghệ, 204Store ra đời với mục tiêu đơn giản: Mang những sản phẩm công nghệ chính hãng tốt nhất đến tay người dùng Việt với mức giá trung thực nhất.
            </p>
            <p class="text-muted">
                Trải qua 2 năm phát triển, chúng tôi hiểu rằng khách hàng không chỉ cần một chiếc điện thoại hay laptop, họ cần một người bạn đồng hành tin cậy trong kỷ nguyên số. Tại 204Store, mỗi sản phẩm bán ra là một lời cam kết về chất lượng.
            </p>
            <div class="mt-4">
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/f/fa/Apple_logo_black.svg/1667px-Apple_logo_black.svg.png" height="30" class="me-4 opacity-50" alt="Partner">
                <img src="https://upload.wikimedia.org/wikipedia/commons/2/24/Samsung_Logo.svg" height="30" class="me-4 opacity-50" alt="Partner">
                <img src="https://upload.wikimedia.org/wikipedia/commons/a/a6/Logo_NIKE.svg" height="30" class="opacity-50" alt="Partner">
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-12 text-center mb-4">
            <h3 class="fw-bold">Giá trị cốt lõi</h3>
            <p class="text-muted">Những nguyên tắc định hình nên văn hóa 204Store</p>
        </div>
        <div class="col-md-4">
            <div class="value-card">
                <div class="vc-icon"><i class="bi bi-gem"></i></div>
                <h5 class="fw-bold">Chất lượng là số 1</h5>
                <p class="text-muted mb-0">Cam kết 100% sản phẩm chính hãng, nói không với hàng dựng, hàng kém chất lượng.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="value-card">
                <div class="vc-icon"><i class="bi bi-heart-fill"></i></div>
                <h5 class="fw-bold">Tận tâm phục vụ</h5>
                <p class="text-muted mb-0">Khách hàng là trung tâm. Chúng tôi lắng nghe và giải quyết mọi vấn đề của bạn.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="value-card">
                <div class="vc-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                <h5 class="fw-bold">Tốc độ & Hiệu quả</h5>
                <p class="text-muted mb-0">Giao hàng nhanh chóng, bảo hành siêu tốc, quy trình mua sắm đơn giản hóa.</p>
            </div>
        </div>
    </div>

    <div class="stats-section shadow-lg">
        <div class="row text-center">
            <div class="col-md-3 mb-4 mb-md-0">
                <h2 class="display-4 fw-bold">2+</h2>
                <p class="mb-0 opacity-75 text-uppercase fw-bold ls-1">Năm hoạt động</p>
            </div>
            <div class="col-md-3 mb-4 mb-md-0">
                <h2 class="display-4 fw-bold">15K+</h2>
                <p class="mb-0 opacity-75 text-uppercase fw-bold ls-1">Khách hàng</p>
            </div>
            <div class="col-md-3 mb-4 mb-md-0">
                <h2 class="display-4 fw-bold">3</h2>
                <p class="mb-0 opacity-75 text-uppercase fw-bold ls-1">Chi nhánh</p>
            </div>
            <div class="col-md-3">
                <h2 class="display-4 fw-bold">99%</h2>
                <p class="mb-0 opacity-75 text-uppercase fw-bold ls-1">Hài lòng</p>
            </div>
        </div>
    </div>

    <div class="text-center mb-5 pb-4">
        <h3 class="fw-bold mb-5">Gặp gỡ đội ngũ sáng lập</h3>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4 col-lg-3">
                <div class="team-card">
                    <img src="https://i.pravatar.cc/300?img=11" alt="UX-UI">
                    <h5 class="fw-bold mb-1">Hoàng Văn An</h5>
                    <p class="text-primary small fw-bold mb-2">UX - UI</p>
                    <p class="text-muted small">"Công nghệ sinh ra để phục vụ cuộc sống con người tốt đẹp hơn."</p>
                </div>
            </div>
            @* <div class="col-md-4 col-lg-3">
                <div class="team-card">
                    <img src="https://i.pravatar.cc/300?img=5" alt="Backend">
                    <h5 class="fw-bold mb-1">Bùi Mạnh Tuấn</h5>
                    <p class="text-primary small fw-bold mb-2">Backend</p>
                    <p class="text-muted small">Chuyên gia với 10 năm kinh nghiệm trong lĩnh vực phần mềm.</p>
                </div>
            </div> *@
        </div>
    </div>

    <div class="bg-light rounded-4 p-5 text-center mb-5 border border-dashed">
        <h2 class="fw-bold mb-3">Bạn đã sẵn sàng trải nghiệm?</h2>
        <p class="text-muted mb-4">Ghé thăm cửa hàng trực tuyến của chúng tôi và săn ngay những deal hot nhất hôm nay.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
            Mua sắm ngay
        </a>
    </div>
</div>