@model _204Store.Models.OrderHeader
@{
    ViewData["Title"] = "Tra cứu đơn hàng";
}

<style>
    .track-line {
        height: 4px;
        background-color: #e9ecef;
        width: 100%;
        position: relative;
        margin-top: 20px;
        border-radius: 10px;
    }

        .track-line .step {
            position: absolute;
            width: 20px;
            height: 20px;
            background: #fff;
            border: 4px solid #e9ecef;
            border-radius: 50%;
            top: -8px;
            z-index: 2;
        }

            .track-line .step.active {
                border-color: #0d6efd;
                background: #0d6efd;
            }

        .track-line .progress-bar {
            height: 100%;
            background-color: #0d6efd;
            position: absolute;
            top: 0;
            left: 0;
            transition: width 0.5s;
            border-radius: 10px;
        }

    .status-text {
        margin-top: 30px;
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
    }

        .status-text span.active {
            color: #0d6efd;
            font-weight: 700;
        }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                <h2 class="fw-bold text-uppercase"><i class="bi bi-search me-2"></i>Tra cứu đơn hàng</h2>
                <p class="text-muted">Nhập mã đơn hàng và số điện thoại để kiểm tra tình trạng.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-light">
                <form asp-action="TrackingOrder" method="post" class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label fw-bold small text-muted">Mã đơn hàng</label>
                        <input type="number" name="orderId" class="form-control py-2" placeholder="Ví dụ: 15" required value="@(Model?.Id)" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-bold small text-muted">Số điện thoại đặt hàng</label>
                        <input type="text" name="phone" class="form-control py-2" placeholder="098..." required value="@(Model?.PhoneNumber)" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-3 mb-0 border-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
                    </div>
                }
            </div>

            @if (Model != null)
            {
                <div class="card border-0 shadow rounded-4 overflow-hidden">
                    <div class="card-header bg-primary text-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold">Đơn hàng #@Model.Id</h5>
                            <span class="badge bg-white text-primary">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-5 px-3">
                            @{
                                int progress = 0;
                                string s = Model.OrderStatus;
                                if (s == "Pending") progress = 10;
                                else if (s == "Processing") progress = 35;
                                else if (s == "Shipped") progress = 65;
                                else if (s == "Completed" || s == "ReturnRequested" || s == "Refunded") progress = 100;
                                else if (s == "Cancelled") progress = 0;
                            }

                            @if (s != "Cancelled")
                            {
                                <div class="track-line">
                                    <div class="progress-bar" style="width: @progress%;"></div>
                                    <div class="step active" style="left: 0%;"></div>
                                    <div class="step @(progress >= 35 ? "active" : "")" style="left: 33%;"></div>
                                    <div class="step @(progress >= 65 ? "active" : "")" style="left: 66%;"></div>
                                    <div class="step @(progress >= 100 ? "active" : "")" style="left: 100%;"></div>
                                </div>
                                <div class="status-text">
                                    <span class="active">Chờ xác nhận</span>
                                    <span class="@(progress >= 35 ? "active" : "")">Đang xử lý</span>
                                    <span class="@(progress >= 65 ? "active" : "")">Đang giao</span>
                                    <span class="@(progress >= 100 ? "active" : "")">Hoàn thành</span>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-danger text-center fw-bold border-0">
                                    <i class="bi bi-x-circle-fill me-2"></i>ĐƠN HÀNG ĐÃ BỊ HỦY
                                </div>
                            }

                            @if (s == "ReturnRequested")
                            {
                                <div class="alert alert-warning mt-3 mb-0 text-center fw-bold"><i class="bi bi-arrow-counterclockwise me-2"></i>Đang yêu cầu trả hàng</div>
                            }
                            @if (s == "Refunded")
                            {
                                <div class="alert alert-secondary mt-3 mb-0 text-center fw-bold"><i class="bi bi-check-circle-fill me-2"></i>Đã hoàn tiền / Trả hàng</div>
                            }
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h6 class="fw-bold text-uppercase text-muted small">Người nhận</h6>
                                <div class="fw-bold">@Model.Name</div>
                                <div>@Model.PhoneNumber</div>
                                <div>@Model.StreetAddress, @Model.City</div>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <h6 class="fw-bold text-uppercase text-muted small">Thanh toán</h6>
                                <div>
                                    @if (Model.PaymentStatus == "Approved")
                                    {
                                        <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán</span>
                                    }
                                    else
                                    {

                                        <span class="text-warning fw-bold"><i class="bi bi-hourglass-split me-1"></i>Thanh toán khi nhận hàng (COD)</span>
                                    }
                                </div>
                                <div class="fs-4 fw-bold text-danger mt-2">@Model.OrderTotal.ToString("#,##0")đ</div>
                            </div>
                        </div>

                        <div class="table-responsive border rounded-3">
                            <table class="table mb-0 align-middle">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-3">Sản phẩm</th>
                                        <th class="text-center">SL</th>
                                        <th class="text-end pe-3">Giá</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OrderDetails)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <div class="d-flex align-items-center">
                                                    <img src="@item.ProductDetail.Product.ImageUrl" width="40" class="rounded border me-2" />
                                                    <div>
                                                        <div class="fw-bold small">@item.ProductDetail.Product.Name</div>
                                                        <div class="text-muted" style="font-size: 0.75rem">@item.ProductDetail.Color - @item.ProductDetail.Rom</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center fw-bold">x @item.Count</td>
                                            <td class="text-end pe-3">@item.Price.ToString("#,##0")đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>